{"id": "1806911", "name": "שימושי האינטגרל – שטח בין שתי פרבולות", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "base", "params": ["x"], "body": "(x-h)*(x-h-k)"}, {"name": "ff", "params": ["x"], "body": "expand(c+a*base(x))"}, {"name": "gg", "params": ["x"], "body": "expand(c-b*base(x))"}, {"name": "diffg", "params": ["x"], "body": "expand(gg(x)-ff(x))"}, {"name": "Farea", "params": ["x"], "body": "(a+b)*(k*(x-h)^2/2-(x-h)^3/3)"}], "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">חשבו את השטח הכלוא בין שני הגרפים</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 1.9;\">\\(\\displaystyle f(x)={{CT:0}}\\)<br>\\(\\displaystyle g(x)={{CT:1}}\\)</div>\n<div dir=\"ltr\" style=\"text-align: center; margin-top: 12px;\">{{CT:2}}</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-bottom: 8px;\">כתבו תשובה מדויקת, ללא קירוב עשרוני.</div>\n<div dir=\"ltr\" style=\"text-align: center;\">[[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>נמצא תחילה את נקודות החיתוך. מן השוויון <span dir=\"ltr\">\\(\\displaystyle f(x)=g(x)\\)</span> מתקבל</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle ({{CT:3}}+{{CT:4}})(x-({{CT:5}}))(x-({{CT:6}}))=0\\)</div>\n<p>ולכן גבולות התחום הם</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle x={{CT:5}}\\quad\\text{ו}\\quad x={{CT:6}}\\)</div>\n<p>בין שתי נקודות החיתוך מתקיים <span dir=\"ltr\">\\(\\displaystyle (x-({{CT:5}}))(x-({{CT:6}}))\\le0\\)</span>, ולכן <span dir=\"ltr\">\\(\\displaystyle g(x)\\ge f(x)\\)</span>. מכאן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle S=\\int_{{{CT:5}}}^{{{CT:6}}}\\left(g(x)-f(x)\\right)\\,dx\\)</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle =\\int_{{{CT:5}}}^{{{CT:6}}} {{CT:7}}\\,dx={{CT:8}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "תשובה מדויקת", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "area", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["a", "area", "b", "c", "gapY", "h", "k", "leftI", "mid", "rightI", "xDomain", "yDomain"], "nvariants": 50}