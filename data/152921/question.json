{"id": "152921", "name": "סכום רימן כאינטגרל ואז סכומי דרבו L(f,P) ו-U(f,P)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f", "params": ["x"], "body": "1/(a+b*x^2)"}], "questiontext": "<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\">נתון הגבול הבא:</p>\n<p style=\"direction: ltr; text-align: center;\" dir=\"rtl\">\\[ \\displaystyle{\\lim_{n\\to\\infty} \\sum_{k=1}^n \\frac{n}{{CT:0}}}\\]</p>\n<p style=\"direction: rtl; text-align: right;\">הציגו אותו בצורה של&nbsp;\\[\\int_a^b f\\] ולאחר מכן מצאו מצאו את \\[L(f,P)\\] ואת \\[U(f,P)\\] כאשר&nbsp;</p>\n<p style=\"direction: ltr; text-align: center;\">\\[P=\\{a,\\frac{a+b}{2},b\\}\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[L(f,P)\\]=[[input:ans1]] [[validation:ans1]]&nbsp;</p><p style=\"text-align: center;\" dir=\"ltr\">\\[U(f,P)\\]=[[input:ans2]] [[validation:ans2]]</p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 10, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 10, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "ta:defint(f,x,xa,xb);\nst:defint(ans3,x,ans1,ans2);\nsw:is(ans1=U) and is(ans2=L);", "firstnode":