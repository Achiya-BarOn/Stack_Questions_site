{"id": "209599", "name": "ellipsoid", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "h", "params": ["t"], "body": "t^2+m"}, {"name": "fx", "params": ["r", "p", "t"], "body": "a*r*sin(p)*cos(t)"}, {"name": "fy", "params": ["r", "p", "t"], "body": "b*r*sin(p)*sin(t)"}, {"name": "fz", "params": ["r", "p", "t"], "body": "c*r*cos(p)"}, {"name": "rsq", "params": ["x", "y", "z"], "body": "(x/a)^2+(y/b)^2+(z/c)^2"}, {"name": "rcsq", "params": ["x", "y", "z"], "body": "(z/c)^2"}, {"name": "rssq", "params": ["x", "y", "z"], "body": "(x/a)^2+(y/b)^2"}, {"name": "f", "params": ["x", "y", "z"], "body": "h(rsq(x,y,z)^((2*n+1)/2))*rcsq(x,y,z)^(n-1)"}, {"name": "g", "params": ["r", "p", "t"], "body": "h(r^(2*n+1))*r^(2*n)*(cos(p))^(2*(n-1))*sin(p)"}], "questiontext": "<p><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"> </span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">יהא \\(P\\) התחום במרחב שנמצא מעל למישור ה-xy, וגם תחום בתוך האליפסואיד:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\left\\{(x,y,z) \\ | \\ \\left(\\frac{x}{{{CT:0}}}\\right)^2 + \\left(\\frac{y}{{{CT:1}}}\\right)^2 +\\left(\\frac{z}{{{CT:2}}}\\right)^2  \\le 1 \\right\\} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את האינטגרל המשולש</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\iiint_{P} {{CT:3}} dV \\] =</span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\"> [[input:ans1]] [[validation:ans1]] </span></p>\n<p><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>רמז: </strong>בצעו קודם כל שינו משתנה בכדי להביא את חצי האליפסואיד לצורת חצי כדור. אחר כך עברו למערכת קוארדינטות כדורית. ניתן גם לבצע את שני השנינויים בבת אחת. <br /></span></p>", "generalfeedback": "<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נסמן את מערכת הקוארדינטות הכדורית באותיות \\(r,p,t\\) ולא כמקובל באותיות \\(\\rho,\\phi,\\theta\\). ניתן לעשות בבת אחת את המרת המשתנים כך</span></p>\n<p dir=\"rtl\"> </p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">\\[x={{CT:4}}, y={{CT:5}}, z={{CT:6}}\\]</span></p>\n<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">והיעקוביאן </span> </p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">\\[J={{CT:7}} r^2 \\sin(p) \\]</span></p>\n<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">משפט שינוי משתנה נותן</span></p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\iiint_P f(x,y,z) dV= \\int_{0}^{1} \\int_{0}^{\\frac{\\pi}{2}} \\int_{0}^{2 \\pi} {{CT:8}} dt  dp dr \\] </span></p>\n<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">ניתן לקבל ביטוי זה על ידי הצבת הביטויים למעלה ל-\\(x,y,z\\). אבל אולי פשוט יותר לזהות בתוך האינטגרנד המקורי ביטויים מורכבים יותר שיש להם משמעות פשוטה במערכת הקוארינטות החדשה כגון:</span></p>\n<p dir=\"rtl\"> </p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[r^2 = {{CT:9}}, \\quad (r \\sin^2(p))^2 = {{CT:10}} \\]</span></p>\n<p dir=\"rtl\"> </p>", "specificfeedback": "<p>[[feedback:prt1]]</p>\n<p> </p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 2, "nodes": [{"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-3-T", "feedback": "<p style=\"text-align: right;\">יופי חישבתם נכון את האינטגרל</p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">החישוב שלכם לא נכון. </p>"}}]}], "qvnames": ["a", "b", "c", "m", "n", "tans1"], "nvariants": 50}