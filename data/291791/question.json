{"id": "291791", "name": "stokes on a trimmed cylinder", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "grad", "params": ["qq"], "body": "matrix([diff(qq,x),diff(qq,y),diff(qq,z)])"}, {"name": "div", "params": ["UU"], "body": "diff(UU[1],x)+diff(UU[2],y) + diff(UU[3],z)"}, {"name": "curl", "params": ["UU"], "body": "matrix([diff(UU[3],y) - diff(UU[2],z), diff(UU[1],z) - diff(UU[3],x), diff(UU[2],x) - diff(UU[1],y)])"}, {"name": "U", "params": ["x", "y", "z"], "body": "[c1*z,c2*x,c3*y]"}, {"name": "h", "params": ["x"], "body": "expand(c1+c2*(x+RR))"}, {"name": "N", "params": ["t", "z"], "body": "[cos(t),sin(t),0]"}, {"name": "integ", "params": ["t", "z"], "body": "RR*N(t,z).W"}, {"name": "z1", "params": ["t"], "body": "h(RR*cos(t))"}, {"name": "al", "params": ["t"], "body": "[RR*cos(t),RR*sin(t),0]"}, {"name": "v1", "params": ["t"], "body": "diff(al(t),t)"}, {"name": "bta", "params": ["t"], "body": "[RR*cos(t),RR*sin(t),h(RR*cos(t))]"}, {"name": "v2", "params": ["t"], "body": "diff(bta(t),t)"}, {"name": "integ1", "params": ["t"], "body": "v1(t).U(al(t)[1],al(t)[2],al(t)[3])"}, {"name": "integ2", "params": ["t"], "body": "v2(t).U(bta(t)[1],bta(t)[2],bta(t)[3])"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתון שדה וקטורי במרחב&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>ונסמן ב-\\(S\\) את המשטח הנתון על ידי הנוסחאות:</span></span>&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[S= \\left\\{{{CT:1}} \\in \\mathbb{R}^3 \\, \\biggr\\rvert \\, x^2+y^2={{CT:2}}, \\;\\;&nbsp; 0 \\le z \\le {{CT:3}} \\right\\} \\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium; text-align: center;\">נסמן ב \\(N\\) וקטור יחידה נורמלי הפונה החוצה מן הגליל הקטום הזה. חשבו את שני האגפים של משפט סטוקס:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium; text-align: center;\">\\[\\iint_{S} curl(U) \\cdot N d \\sigma = \\int_{\\partial S} U \\cdot T d\\ell \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium; text-align: center;\"><span>כאשר \\(d \\sigma \\) אלמנט השטח על המשטח ו \\(d \\ell \\) אלמנט האורך על השפה.&nbsp;</span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium; text-align: center;\">שימו לב שבמקרה זה \\(\\partial S\\) מורכב משתי מסילות שונות. אחת מעגל המתקבל מחיתוך הגליל עם מישור ה-\\(xy\\) והשניה אליפסה המתקבלת מחיתוך הגליל עם המישור:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium; text-align: center;\"> \\(z(x,y)= {{CT:3}}\\)</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">לכן האינטגרל באגף ימין הוא בעצם סכום של שני אינטגרלים. וודאו שאתם מבינים באיזה כיוון יש לעבור על שתי המסילות האילו! כעת חשבו את שני האגפים של משפט סטוקס. וודאו שאתם מקבלים את אותה התשובה בשני האגפים והזינו את תשובתכם:</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"><span>\\(\\iint_{S} curl(U) \\cdot N d \\sigma = \\int_{\\partial S} U \\cdot T d\\ell = \\)&nbsp;<span>&nbsp;[[input:ans1]] [[validation:ans1]]</span></span></span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">&nbsp;</span></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">הנה תיאור סכמטי של הגליל והחיתוכים שלו עם המישורים:</span></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\"><img src=\"data/291791/files/1.png\" alt=\"\" width=\"590\" height=\"400\" role=\"presentation\" class=\"img-fluid atto_image_button_text-bottom\"><br></span></p>", "generalfeedback": "<p dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">כדאי כאן לעבוד במערכת קוארדינות גלילית מכיוון שבברור זו הסימטריה של המערכת. נזכיר שזו מערכת שנראית כך&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[x=r \\cos(t), y=r \\sin(t), z=z \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בכדי לחשב את אגף שמאל של משפט סטוקס נחשב את כל המרכיבים:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[curl(U) = {{CT:4}}, \\quad N={{CT:5}}\\]</span><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;&nbsp;</p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\">\\[\\iint_{S} curl(U) \\cdot N d \\sigma = \\int_0^{2\\pi} \\int_{0}^{{{CT:6}}} {{CT:7}}\\ dz \\ dt = {{CT:8}}\\]</span></p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>באופן דומה בכדי לחשב את אגף ימין נמצא פרמטריזציות לשתי המסילות שמרכיבות השפה של המשטח שלנו</span></span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\alpha(t)={{CT:9}}, \\quad \\beta(t)={{CT:10}}\\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\alpha'(t)={{CT:11}}, \\quad \\beta'(t)={{CT:12}}\\]&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בדיקה של כיווני האינטגרציה במשפט סטוקס מראים שמקבלים מאגף ימין את הסכום הבא:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">&nbsp;</span><span style=\"font-size: medium;\">&nbsp;\\[\\int_{\\partial S} U \\cdot T d \\ell = \\int_{0}^{2 \\pi} \\alpha'(t) \\cdot U(\\alpha(t)) dt - \\int_{0}^{2 \\pi} \\beta'(t) U(\\beta(t)) dt = {{CT:8}}\\]&nbsp;</span><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>כלומר שתי התוצאות מתאימות כפי שמנבא משפט סטוקס.&nbsp;</span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\">תשובה נכונה, יפה מאוד.</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\">תשובה נכונה חלקית.</p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\">תשובה שגויה.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 25, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">יופי חישבתם את האינטגל נכון.</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">האינטגרל שלכם שגוי.&nbsp;</span></p>"}}]}], "qvnames": ["RR", "W", "c1", "c2", "c3", "t0", "t1", "tans1", "tans2", "tans3", "vec", "z0"], "nvariants": 50}