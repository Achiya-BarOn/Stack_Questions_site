{"id": "3327959", "name": "הפרדת משתנים – y′ = a·x·sin(bx)·y², אינטגרציה בחלקים", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q8_NEW6_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">הפרדת משתנים ואינטגרציה בחלקים</div>\n<div style=\"margin-bottom: 10px;\">בנוסף למשפחה המבוקשת קיים הפתרון הקבוע <span dir=\"ltr\">\\(y=0\\)</span>. מצאו את משפחת הפתרונות שאינם זהותית אפס.</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 19px; line-height: 1.9;\">\\(\\displaystyle {{CT:0}}\\)</div>\n<div style=\"margin-top: 8px; color: #665f6b; font-size: 14px;\">השתמשו באות <span dir=\"ltr\"><strong>c</strong></span> לציון הקבוע.</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle y(x)=\\) [[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q8_NEW6_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>לפתרון שאינו אפס מפרידים משתנים</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle \\frac{dy}{y^2}={{CT:1}}x\\sin({{CT:2}}x)\\,dx\\)</div>\n<p>באגף ימין משתמשים באינטגרציה בחלקים</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle \\int x\\sin({{CT:2}}x)\\,dx=-\\frac{x\\cos({{CT:2}}x)}{{{CT:2}}}+\\frac{\\sin({{CT:2}}x)}{{{CT:2}}^2}\\)</div>\n<p>ולכן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle \\frac1y=\\frac{{{CT:1}}}{{{CT:2}}}x\\cos({{CT:2}}x)-\\frac{{{CT:1}}}{{{CT:2}}^2}\\sin({{CT:2}}x)+c\\)</div>\n<p>מכאן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px; font-weight: bold;\">\\(\\displaystyle y(x)={{CT:3}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 40, "insertstars": 5, "forbidfloat": true, "forbidwords": "diff", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "ביטוי ב-x הכולל c", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "res:radcan(diff(ans1,x)-aa*x*sin(bb*x)*ans1^2);\ncnst:ev(diff(ans1,c)^2+diff(ans1,C)^2,simp);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "res", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0.8, "nextnode": 1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "cnst", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-1-T ", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0.2, "nextnode": -1, "answernote": "Result-1-F ", "feedback": ""}}]}], "qvnames": ["aa", "bb", "correctanswer", "ode"], "nvariants": 24}