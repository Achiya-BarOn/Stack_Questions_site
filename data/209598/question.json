{"id": "209598", "name": "paralelopiped", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ss", "params": ["x", "y", "z"], "body": "Inv[1][1]*x+Inv[1][2]*y+Inv[1][3]*z"}, {"name": "tt", "params": ["x", "y", "z"], "body": "Inv[2][1]*x+Inv[2][2]*y+Inv[2][3]*z"}, {"name": "uu", "params": ["x", "y", "z"], "body": "Inv[3][1]*x+Inv[3][2]*y+Inv[3][3]*z"}, {"name": "fx", "params": ["s"], "body": "b*sin(s*%pi*a)"}, {"name": "fy", "params": ["t"], "body": "b*ln(t+a)"}, {"name": "fz", "params": ["u"], "body": "exp(a*u)"}, {"name": "f", "params": ["x", "y", "z"], "body": "(fx(ss(x,y,z))*fy(tt(x,y,z))*fz(uu(x,y,z)))"}, {"name": "g", "params": ["s", "t", "u"], "body": "fx(s)*fy(t)*fz(u)"}], "questiontext": "<p><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\">&nbsp;</span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">יהא \\(P\\) מקבילון בעל קדקד בראשית הנפרש על ידי שלושת הווקטורים</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[v_1={{CT:0}}, v_2={{CT:1}}, v_3={{CT:2}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את האינטגרל המשולש</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\iiint_{P} {{CT:3}} dV \\]</span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\">&nbsp;[[input:ans1]] [[validation:ans1]]&nbsp;</span></p>\n<p><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>רמז:&nbsp;</strong>מומלץ לבצע קודם שינוי משתנה בכדי להביא את תחום האינטגרציה לצורת קוביה.&nbsp;<br></span></p>", "generalfeedback": "<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">מכיוון שמדובר במקבילון, ניתן למצוא העתקה ליניארית שלוקחת את קובית היחידה למקבילון. נבחר העתקה זו לביצוע שינוי הקוארדינטות שלנו</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[{{CT:4}} = {{CT:5}} \\cdot {{CT:6}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">והיעקוביאן (בערך מוחלט!)&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[J=\\text{abs} \\left(\\det {{CT:5}}\\right)={{CT:7}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בדרך כלל אנחנו רגילים לכך שהיעקוביאן הוא פונקציה. כאן,&nbsp;<span>מכיוון ששינוי המשתנה הוא על ידי העתקה ליניארית, היעקוביאן הוא מספר קבוע.</span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">במערכת הקוארדינטות החדשה מקבלים את האינטגרל הבא</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\iiint_P f(x,y,z) dV= \\iiint_{[0,1]^3} {{CT:8}} ds dt du \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">זהו כבר אינטגרל קל. וודאו שאתם מבינים בדיוק איך הוא מתפרק למכפלה של שלושה אינטגרלים, שכל אחד מהם מערב משתנה אחד בלבד. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"rtl\">&nbsp;</p>", "specificfeedback": "<p>[[feedback:prt1]]</p>\n<p>&nbsp;</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 25, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 2, "nodes": [{"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-3-T", "feedback": "<p style=\"text-align: right;\">יופי חישבתם נכון את האינטגרל.&nbsp;</p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">החישוב שלכם לא נכון.&nbsp;</p>"}}]}], "qvnames": ["Inv", "J", "Mat", "a", "b", "tans1", "v1", "v2", "v3", "vect1", "vect2"], "nvariants": 50}