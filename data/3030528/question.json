{"id": "3030528", "name": "מד\"ר בסל לא הומוגנית – פתרון כללי משני פתרונות נתונים", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"direction: rtl; text-align: right;\"><span style=\"font-size: 0.9375rem;\">ידוע שהפונקציות</span></p><p style=\"direction: ltr; text-align: center;\"><span style=\"font-size: 0.9375rem;\">\\(y_1(x)=\\frac{\\sqrt{\\pi}+3\\cos(x)}{\\sqrt{x}},\\quad y_2(x)=\\frac{\\sqrt{\\pi}}{\\sqrt{x}}\\)</span></p><p style=\"direction: rtl; text-align: right;\"><span style=\"font-size: 0.9375rem;\">הן שתי פתרונות של המשוואה</span></p>\n<p style=\"text-align: right;\"></p>\n<p style=\"direction: ltr; text-align: center;\">\\[ x^2y''+xy'+(x^2-\\frac{1}{4})y=q(x)\\]</p>\n<p style=\"text-align: right;\"></p>\n<p dir=\"rtl\" style=\"direction: rtl;\">כאשר \\[ q(x)\\] רציפה בקרן \\({{CT:0}}\\).<span style=\"font-size: 0.9375rem;\">&nbsp; מצאו פתרון למד\"ר \\(\\hat{y}(x)\\) המקיים:</span></p><p dir=\"rtl\" style=\"direction: rtl;\"></p>\n<p dir=\"rtl\" style=\"direction: ltr; text-align: center;\">\\(\\hat{y}({{CT:1}})={{CT:2}},\\quad \\hat{y}'({{CT:1}})={{CT:3}}\\)</p>\n<p dir=\"rtl\" style=\"direction: rtl;\"></p>\n<p dir=\"rtl\" style=\"direction: ltr; text-align: center;\">\\(\\hat{y}(x)=\\)[[input:ans1]] [[validation:ans1]]</p>\n<p style=\"direction: ltr; text-align: center;\"><span style=\"font-size: 0.9375rem;\"></span></p>\n<p style=\"text-align: right;\"></p>\n<p style=\"text-align: left;\"></p>", "generalfeedback": "<p>&nbsp;</p>\n<p>&nbsp;</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 35, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correctF:trigsimp(trigexpand(fullratsimp(radcan(ans1-ych))));\n\ncorrect:is(correctF=0);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "פתרון נכון<p dir=\"rtl\" style=\"text-align: right;\"></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">פתרון שגוי<br></p>"}}]}], "qvnames": ["c1val", "c2val", "x0", "y0", "y1", "ych", "yg", "yh", "yp"], "nvariants": 50}