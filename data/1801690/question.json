estoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.125, "nextnode": -1, "answernote": "Result-8-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-8-F", "feedback": ""}}]}], "qvnames": ["aa", "bb", "cc", "classOptions", "classifyCriticalPoint", "criticalPoint", "ffNotDefined", "funcs", "graphOptions", "limAtNegInf", "limAtPlusInf", "limAtx1minus", "limAtx1plus", "localMax", "localMin", "slLm", "slLp", "slS", "slT", "whereIsf", "xDomain", "xm", "yDomain"], "nvariants": 50}