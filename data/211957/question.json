{"id": "211957", "name": "type_two_1", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "proj", "params": ["x", "y"], "body": "((x.y)/(y.y))*y"}, {"name": "x", "params": ["u", "v"], "body": "u"}, {"name": "y", "params": ["u", "v"], "body": "v"}, {"name": "z", "params": ["u", "v"], "body": "(R-a*u-b*v)/c"}, {"name": "X", "params": ["u", "v"], "body": "transpose([x(u,v),y(u,v),z(u,v)])"}, {"name": "v1", "params": ["u"], "body": "(R-a*u)/b"}, {"name": "U1", "params": ["x", "y", "z"], "body": "b*x*z*e^y"}, {"name": "U2", "params": ["x", "y", "z"], "body": "-a*x*z*e^y"}, {"name": "U3", "params": ["x", "y", "z"], "body": "d*z"}, {"name": "U", "params": ["x", "y", "z"], "body": "[U1(x,y,z),U2(x,y,z),U3(x,y,z)]"}, {"name": "Xu", "params": ["u", "v"], "body": "[diff(x(u,v),u), diff(y(u,v),u),diff(z(u,v),u)]"}, {"name": "Xv", "params": ["u", "v"], "body": "[diff(x(u,v),v), diff(y(u,v),v),diff(z(u,v),v)]"}, {"name": "W", "params": ["u", "v"], "body": "factor(-crossprod(Xu(u,v),Xv(u,v)))"}, {"name": "integ", "params": ["u", "v"], "body": "factor(U(x(u,v),y(u,v),z(u,v)).W(u,v))"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את השטף של השדה הווקטורי&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">דרך המשטח \\(S\\) המוגדר להיות החיתוך של המישור&nbsp;&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[S= \\left\\{{{CT:1}}\\in \\mathbb{R}^3 \\ | \\ {{CT:2}}\\right\\}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">עם האוקטאנט החיובי \\(x\\ge 0, y \\ge 0, z\\ge0\\). כאשר \\(N\\) הנורמל למישור המצביע פנימה לתוך הפירמידה המשולשת שהמישור הזה חוסם באוקטאנט החיובי.</span></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">הנה איור להמחשה (החץ השחור הוא הנורמל בנקודה על המשטח שמראה את כיוון הנורמל):<img src=\"data/211957/files/1.png\" alt=\"\" width=\"893\" height=\"500\" role=\"presentation\" class=\"img-fluid atto_image_button_middle\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p dir=\"ltr\" style=\"text-align: center;\">\\(\\iint\\limits_{S} U \\cdot N d\\sigma = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כאשר \\(\\sigma \\) אלמנט השטח לאורך המשטח.</p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good: is(ans1=tans1);\nalmost: is(ans1=-tans1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "good", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">יופי חישבתם את האינטגל נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\"></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "almost", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">זה החישוב שמתאים לנורמל בכיוון ההפוך</p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">האינטגרל שלכם שגוי.&nbsp;<br></p>"}}]}], "qvnames": ["R", "a", "b", "c", "d", "tans1", "u0", "u1", "v0"], "nvariants": 50}