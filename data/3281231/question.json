{"id": "3281231", "name": "פולינום טיילור לפונקציה בשלושה משתנים - גרסה מעוצבת", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 2, "questiontext": "<div dir=\"rtl\" style=\"max-width: 980px; margin: 0 auto; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 18px;\">\n<div style=\"font-size: 19px; font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">פולינום טיילור בשלושה משתנים</div>\n<p style=\"margin: 5px 0 10px 0;\">נתונה הפונקציה <span dir=\"ltr\">\\(f:\\mathbb{R}^3\\to\\mathbb{R}\\)</span></p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; background: #FFFFFF; border-radius: 9px; padding: 10px 12px;\">\\(\\displaystyle f(x,y,z)={{CT:0}}\\)</div>\n<p style=\"margin: 10px 0 0 0;\">בכל הסעיפים יש לפתח סביב הראשית <span dir=\"ltr\">\\((0,0,0)\\)</span>.</p>\n</div>\n<div style=\"border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 16px; background: #FFFFFF;\">\n<div style=\"display: flex; align-items: center; gap: 9px; margin-bottom: 10px;\"><span style=\"display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: #EEECEF; color: #4b1f6f; font-weight: bold;\">א</span> <span style=\"font-size: 18px; font-weight: bold; color: #4b1f6f;\">פולינום טיילור מסדר ראשון</span></div>\n<p style=\"margin: 5px 0 12px 0;\">מצאו את פולינום טיילור מסדר ראשון של <span dir=\"ltr\">\\(f\\)</span> סביב הראשית.</p>\n<div style=\"background: #FAF9FB; border: 1px solid #EEECEF; border-radius: 10px; padding: 14px;\">\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 18px;\">\\(\\displaystyle P_1(x,y,z)=\\) [[input:ans1]]</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; margin-top: 5px;\">[[validation:ans1]]</div>\n</div>\n</div>\n<div style=\"border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 16px; background: #FFFFFF;\">\n<div style=\"display: flex; align-items: center; gap: 9px; margin-bottom: 10px;\"><span style=\"display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: #EEECEF; color: #4b1f6f; font-weight: bold;\">ב</span> <span style=\"font-size: 18px; font-weight: bold; color: #4b1f6f;\">הנגזרות מסדר שני</span></div>\n<p style=\"margin: 5px 0 12px 0;\">חשבו את מטריצת הנגזרות החלקיות מסדר שני של <span dir=\"ltr\">\\(f\\)</span> בראשית.</p>\n<div style=\"background: #FAF9FB; border: 1px solid #EEECEF; border-radius: 10px; padding: 14px;\">\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 18px;\">\\(\\displaystyle H_f(0,0,0)=\\) [[input:ans3]]</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; margin-top: 5px;\">[[validation:ans3]]</div>\n</div>\n</div>\n<div style=\"border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; background: #FFFFFF;\">\n<div style=\"display: flex; align-items: center; gap: 9px; margin-bottom: 10px;\"><span style=\"display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: #EEECEF; color: #4b1f6f; font-weight: bold;\">ג</span> <span style=\"font-size: 18px; font-weight: bold; color: #4b1f6f;\">פולינום טיילור מסדר שני</span></div>\n<p style=\"margin: 5px 0 12px 0;\">מצאו את פולינום טיילור מסדר שני של <span dir=\"ltr\">\\(f\\)</span> סביב הראשית.</p>\n<div style=\"background: #FAF9FB; border: 1px solid #EEECEF; border-radius: 10px; padding: 14px;\">\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; display: flex; justify-content: center; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 18px;\">\\(\\displaystyle P_2(x,y,z)=\\) [[input:ans2]]</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; margin-top: 5px;\">[[validation:ans2]]</div>\n</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"text-align: right; line-height: 1.75; max-width: 900px; margin: 0 auto; color: #1f2937;\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">פתרון מלא</div>\n<p style=\"margin: 6px 0;\">תחילה מחשבים את ערך הפונקציה ואת הנגזרות החלקיות מסדר ראשון בראשית:</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; background: #FFFFFF; border-radius: 9px; padding: 10px; margin: 8px 0 14px 0; line-height: 1.9;\">\n<div>\\(\\displaystyle f(0,0,0)={{CT:1}}\\)</div>\n<div>\\(\\displaystyle f'_x(0,0,0)={{CT:2}}\\)</div>\n<div>\\(\\displaystyle f'_y(0,0,0)={{CT:3}}\\)</div>\n<div>\\(\\displaystyle f'_z(0,0,0)={{CT:4}}\\)</div>\n</div>\n<p style=\"margin: 6px 0;\">לכן</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; background: #FFFFFF; border-radius: 9px; padding: 10px; margin: 8px 0 14px 0;\">\\(\\displaystyle P_1(x,y,z)= f(0,0,0)+f'_x(0,0,0)x+f'_y(0,0,0)y+f'_z(0,0,0)z ={{CT:5}} \\)</div>\n<p style=\"margin: 6px 0;\">מטריצת הנגזרות מסדר שני בראשית היא</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; background: #FFFFFF; border-radius: 9px; padding: 10px; margin: 8px 0 14px 0;\">\\(\\displaystyle H_f(0,0,0)={{CT:6}}\\)</div>\n<p style=\"margin: 6px 0;\">החלק הריבועי של פולינום טיילור הוא</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; background: #FFFFFF; border-radius: 9px; padding: 10px; margin: 8px 0 14px 0;\">\\(\\displaystyle \\frac12\\left( {{CT:7}}x^2+ 2({{CT:8}})xy+ 2({{CT:9}})xz+ {{CT:10}}y^2+ 2({{CT:11}})yz+ {{CT:12}}z^2 \\right) ={{CT:13}} \\)</div>\n<p style=\"margin: 6px 0;\">ולכן</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; background: #FFFFFF; border-radius: 9px; padding: 10px; margin: 8px 0 0 0;\">\\(\\displaystyle P_2(x,y,z)=P_1(x,y,z)+{{CT:13}}={{CT:14}} \\)</div>\n</div>\n</div>", "specificfeedback": "<p>[[feedback:prt1]] [[feedback:prt2]] [[feedback:Result]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 12, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "matrix", "boxsize": 10, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 0.3, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt1-T", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">נכון. פולינום טיילור מסדר ראשון חושב כראוי.</div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt1-F", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">פולי