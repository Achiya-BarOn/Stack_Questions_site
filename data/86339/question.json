{"id": "86339", "name": "הצבה – ln(a/x)/x (באנגלית)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"ltr\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><p>Evaluate the following integral, using a substitution if necessary:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\int \\frac{1}{{CT:0}}\\ln\\left(\\frac{{CT:1}}{{CT:0}}\\right)d{{CT:0}} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"ltr\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">The substitution</b><br><p>Let</p><p dir=\"ltr\" style=\"text-align:center\">\\[ u = \\ln\\left(\\frac{{CT:1}}{{CT:0}}\\right) \\]</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\frac{du}{d{{CT:0}}}=-\\frac{{CT:1}}{{CT:2}}\\frac{{CT:0}}{{CT:1}}=-\\frac{1}{{CT:0}} \\]</p><p>Therefore</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\int\\frac{1}{{CT:0}}\\ln\\left(\\frac{{CT:1}}{{CT:0}}\\right)d{{CT:0}} = -\\int udu = -\\frac{u^2}{2} +c = -\\frac{1}{2}\\ln^2\\left(\\frac{{CT:1}}{{CT:0}}\\right) +c \\]</p></div></div>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Int", "sans": "ans1", "tans": "correctanswer", "testoptions": " v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "diff(f,v)", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-F", "feedback": ""}}]}], "qvnames": ["alternativef", "correctanswer", "correctanswer2", "f", "n1", "v"], "nvariants": 9}