{"id": "1792317", "name": "נגזרת – (c·xᵐ·ln x)ⁿ", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "pz", "params": ["x"], "body": "if numberp(x) then (if x<0 then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)) elseif atom(x) then tex1(x) elseif member(op(x),[\"+\",\"-\"]) or (op(x)=\"*\" and numberp(first(x)) and first(x)<0) then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "pz1", "params": ["x"], "body": "if not atom(x) and op(x)=\"+\" then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(append([pz1(first(args(e)))], map(pz, rest(args(e)))), \" \\\\cdot \")"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">נגזרת – חזקה של מכפלה עם לוגריתם</div><p>מצאו את הנגזרת של הפונקציה</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\displaystyle f\\left(x\\right)={{CT:0}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle f'\\left(x\\right)= \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> הפונקציה היא חזקה של מכפלה. גוזרים את המכפלה לפי כלל המכפלה, ואת החזקה לפי כלל השרשרת.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הבסיס (כלל המכפלה)</b><br>נסמן<p dir=\"ltr\" style=\"text-align:center\">\\[ u\\left(x\\right)={{CT:1}} \\]</p>לגזירת <span dir=\"ltr\">\\(u\\)</span> משתמשים בכלל המכפלה<div style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;margin:12px 0\">כלל המכפלה: <span dir=\"ltr\">\\( \\frac{d}{dx}(uv)=u'v+uv' \\)</span></div><p dir=\"ltr\" style=\"text-align:center\">\\[ u'\\left(x\\right)={{CT:2}}+{{CT:3}}={{CT:4}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — כלל השרשרת</b><br>כעת מפעילים את כלל השרשרת על <span dir=\"ltr\">\\(f\\left(x\\right)=u\\left(x\\right)^{{{CT:5}}}\\)</span><div style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;margin:12px 0\">כלל השרשרת: <span dir=\"ltr\">\\( \\frac{d}{dx}f(g(x))=f'(g(x))\\,g'(x) \\)</span></div>הנגזרת של <span dir=\"ltr\">\\(u^{{{CT:5}}}\\)</span> לפי <span dir=\"ltr\">\\(u\\)</span> היא <span dir=\"ltr\">\\({{CT:6}}\\)</span>, ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ f'\\left(x\\right)={{CT:7}} \\]</p>ולאחר פישוט:<p dir=\"ltr\" style=\"text-align:center\">\\[ f'\\left(x\\right)={{CT:8}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 42, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 2, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "q:p2/p1;\nvarss:listofvars(ans1);\nan1:ans1;\nfor i:1 while i<=length(varss) do an1:ev(an1,varss[i]=v);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Diff", "sans": "an1", "tans": "factor(diff(p,v))", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "an1", "tans": "-factor(diff(p,v))", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0.4, "nextnode": -1, "answernote": "Result-1-T ", "feedback": "<div dir=\"rtl\"><p>התשובה היא מינוס הנגזרת הנכונה. בדקו את הסימנים.</p></div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-F ", "feedback": ""}}]}], "qvnames": ["X", "c", "m", "p", "p1", "p2", "rdm1", "v"], "nvariants": 48}