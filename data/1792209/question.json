{"id": "1792209", "name": "נגזרת כגבול פונקציית שיפוע המיתר", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "(-1)^kk * (x-alpha) * (x - beta)"}, {"name": "ff_exp", "params": ["x"], "body": "expand(ff(x))"}, {"name": "FF", "params": ["t"], "body": "ev((ff(x0 + t) - ff(x0)) / t, ratsimp)"}, {"name": "SECANT", "params": ["x", "a", "b"], "body": "((ff(b)-ff(a))/(b-a))*(x-a)+ff(a)"}, {"name": "hh", "params": ["x"], "body": "SECANT(x ,x0, x0+1.5)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">נתון (בכחול) הגרף של פונקציה&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(f(x) = {{CT:0}}.\\)</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">{{CT:1}}</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">בנוסף, מופיע (באדום) גרף הישר, העובר דרך הנקודה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ ({{CT:2}},f({{CT:2}})),\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ונקודה סמוכה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[({{CT:2}} + t,f({{CT:2}} + t)).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">א. כתבו ביטוי המתאר את שיפוע הישר הנזכר:&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\( F(t) = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ב. כאשר</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ t \\to 0 \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הנקודה הסמוכה מתקרבת יותר ויותר אל הנקודה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ ({{CT:2}},f({{CT:2}})),\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">והישר \"מתקרב\" יותר ויותר לישר המשיק בנקודה זו.</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את גבול השיפוע:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\displaystyle {\\lim_{t \\to 0} F(t) =} \\) [[input:ans2]] [[validation:ans2]]</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">בהנתן שתי נקודות במישור,</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[(x_1,y_1), \\hspace{0.7cm} (x_2,y_2)\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">שיפוע ישר בין שתי הנקודות הוא</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{y_2 - y_1}{x_2 - x_1}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אצלנו, השיפוע הוא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{f({{CT:2}}+t) - f({{CT:2}})}{({{CT:2}}+t) - ({{CT:2}})} = \\frac{{CT:3}}{t} = {{CT:4}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הגבול המבוקש הוא</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\lim_{t \\to 0} {{CT:4}} = {{CT:5}}. \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נשים לב, שזוהי בדיוק הנגזרת של הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ f(x) \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">מחושבת בנקודה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[x = {{CT:2}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">זהו גם שיפוע הישר המשיק לגרף הפונקציה בנקודה זו.</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "FF(t)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "penalty": 0, "nextnode": 1, "answernote": "Result-0-T ", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הביטוי עבור שיפוע הישר הוא נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"><span>הביטוי עבור שיפוע הישר אינו נכון.</span></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans2", "tans": "theLimit", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הגבול שמצאת נכון.</p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-2-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הגבול שמצאת אינו נכון.</p>"}}]}], "qvnames": ["alpha", "beta", "kk", "theLimit", "x0"], "nvariants": 50}