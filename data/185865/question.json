tverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "ans_app1: if (length(ans1) < 3) then [1,1,1] else copy(ans1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "rank_rnd ", "tans": "3", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": 1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 2, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "length(ans1)", "tans": "3", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": 3, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<div dir=\"rtl\"><p>תשובתך אינה נכונה.</p>אמנם הוקטורים פורשים את המרחב, אך תת-הקבוצה שנתת אינה פורשת...</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "[]", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-3-T", "feedback": "<div dir=\"rtl\">יפה מאוד!</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<div dir=\"rtl\">תשובתך אינה נכונה. כל הוקטורים שהיו נתונים, כלל אינם פורשים את <span dir=\"ltr\">\\(\\mathbb{R}^3\\)</span>.</div>"}}, {"name": 3, "answertest": "AlgEquiv", "sans": "determinant(addcol(vecs[vecs_ind[ans_app1[1]]],addcol(vecs[vecs_ind[ans_app1[2]]],vecs[vecs_ind[ans_app1[3]]])))", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt1-4-T", "feedback": "<div dir=\"rtl\">אמנם הוקטורים פורשים את המרחב, אך תת-הקבוצה שנתת אינה פורשת.</div>"}, "on_false": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-4-F", "feedback": "<div dir=\"r