umberp(mratio) then is(mratio>10) else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "mhuge", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt6-T", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">החסם שלכם תקין מתמטית, אבל <span dir=\"ltr\">\\(M\\)</span> שבחרתם גדול מאוד ביחס למקדם הטבעי <span dir=\"ltr\">\\({{CT:6}}\\)</span>. כדאי לבחור חסם הדוק וסביר יותר ולא לנפח את הקבוע ללא צורך. בגלל הגסות של החסם הופחת חלק קטן מן הניקוד.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt6-F", "feedback": ""}}]}], "qvnames": ["A", "H", "Mmin", "alpha", "au", "av", "beta", "bu", "bv", "cu", "cv", "d0", "den", "f", "gmin", "h", "kexp", "kind", "mpow", "num", "opts1", "rexp", "u", "v"], "nvariants": 50}