{"id": "2938758", "name": "הורדת סדר – פתרון פולינומי ממעלה 1 ופתרון נוסף, בסיס פתרונות", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"direction: rtl; text-align: right;\"><span style=\"font-size: 0.9375rem;\">נתונה המשוואה הדיפרנציאלית הבאה</span></p><p style=\"text-align: right;\"></p>\n<p style=\"direction: ltr; text-align: center;\">\\[ {{CT:0}}\\]</p>\n<p style=\"text-align: right;\"></p><p dir=\"rtl\" style=\"direction: rtl;\">ונתון כי למשוואה יש פתרון פרטי בצורת פולינום ממשי ממעלה 1.</p><p dir=\"rtl\" style=\"direction: rtl;\"><span style=\"font-size: 0.9375rem;\">&nbsp;מצאו פתרונות למשוואה \\(y_1,y_2\\) כך שהפתרון הכללי למשוואה הוא:</span></p><p dir=\"rtl\" style=\"direction: rtl;\"></p><p dir=\"rtl\" style=\"direction: ltr; text-align: center;\">\\(c_1\\cdot y_1+c_2\\cdot y_2\\)</p><p dir=\"rtl\" style=\"direction: rtl;\"></p><p dir=\"rtl\" style=\"direction: ltr; text-align: center;\">\\(y_1=\\)[[input:ans1]] [[validation:ans1]]</p><p dir=\"rtl\" style=\"direction: ltr; text-align: center;\">\\(y_2=\\)[[input:ans2]] [[validation:ans2]]<br></p><p style=\"direction: ltr; text-align: center;\"><span style=\"font-size: 0.9375rem;\"></span></p><p style=\"text-align: right;\"></p>\n<p style=\"text-align: left;\"></p>", "generalfeedback": "<p>&nbsp;</p>\n<p>&nbsp;</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 35, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 35, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "isSol(yp):= block(sa1:subst(y=yp,ode),sa2:ev(sa1,nouns),sa3:trigsimp(fullratsimp(expand(radcan(sa2)))), is(sa3) );\nsatisfiedODE: isSol(ans1) and isSol(ans2);\nlinInd: not is(simplify(ans1*diff(ans2,x)-ans2*diff(ans1,x))=0);\ncorrect:satisfiedODE and linInd;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "פתרון נכון<p dir=\"rtl\" style=\"text-align: right;\"></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">פתרון שגוי<br></p>"}}]}], "qvnames": ["a", "m", "n", "ode", "yp1", "yp2"], "nvariants": 50}