{"id": "86373", "name": "Vector_Dot_Product", "defaultgrade": 1, "penalty": 0.5, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "texp", "params": ["x"], "body": "if numberp(x) and x<0 then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(map(texp, args(e)), \" \\\\cdot \")"}, {"name": "texsumf", "params": ["e"], "body": "block([L:first(args(e))], concat(tex1(first(L)), apply(sconcat, map(lambda([t], concat(\"+\",texp(t))), rest(L)))))"}, {"name": "texnsum", "params": ["e"], "body": "block([L:first(args(e))], concat(tex1(first(L)), apply(sconcat, map(lambda([t], if numberp(t) and t<0 then concat(\"-\",tex1(-t)) else concat(\"+\",tex1(t))), rest(L)))))"}, {"name": "texsq", "params": ["e"], "body": "concat(texp(first(args(e))), \"^2\")"}, {"name": "texpar", "params": ["e"], "body": "texp(first(args(e)))"}], "questiontext": "<div dir=\"ltr\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><p>Calculate the dot product \\(\\underline{u}\\cdot \\underline{v}\\) where \\(\\underline{u}\\) has components {{CT:0}} and \\(\\underline{v}\\) has components {{CT:1}}.</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\underline{u}\\cdot\\underline{v} =\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"ltr\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">The dot product</b><br>The dot product is the sum of the products of corresponding components: \\(\\underline{u}\\cdot\\underline{v}=u_1v_1+u_2v_2+u_3v_3\\). Here<p dir=\"ltr\" style=\"text-align:center\">\\[ \\underline{u}\\cdot\\underline{v}={{CT:2}}={{CT:3}}={{CT:4}} \\]</p></div></div>", "specificfeedback": "[[feedback:Result]]", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "determinant, invert", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctanswer", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["avar", "bvar", "correctanswer", "cvar", "vector1", "vector2", "wronganswer1"], "nvariants": 50}