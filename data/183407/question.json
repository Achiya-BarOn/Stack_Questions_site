{"id": "183407", "name": "קומוטטיביות של מטריצות אלמנטריות", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randToHead", "params": ["list"], "body": "block([x],x: rand(list),list: delete(x,list),cons(x,list))"}, {"name": "permuteList", "params": ["list"], "body": "block([newlist],newlist: [],for i:1 unless (list = []) do(list: randToHead(list),push(pop(list),newlist)),newlist)"}, {"name": "nChooseK", "params": ["dm", "rank"], "body": "block([cols],cols: makelist(i,i,dm),rest(permuteList(cols),-(dm-rank)))"}, {"name": "switchRowsMatrix", "params": ["height", "r1", "r2"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1]: ident(height)[r2],tempMat[r2]: ident(height)[r1],tempMat)"}, {"name": "rowMultMatrix", "params": ["height", "r", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r]: alpha*tempMat[r],tempMat)"}, {"name": "rowAddMatrix", "params": ["height", "r1", "r2", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1][r2]: alpha,tempMat)"}, {"name": "scrambleMatrix", "params": ["height", "numOfActions", "rowMultScalars", "rowAddScalars"], "body": "block([mat, actions],mat:ident(height),actions:[switchRowsMatrix, rowMultMatrix, rowAddMatrix],for i:1 thru numOfActions do(mat:mat.block([choice, rows], choice: rand([1,2,3]),rows: nChooseK(height, 2),if (choice = 1) then switchRowsMatrix(height,rows[1],rows[2]) elseif (choice = 2) then rowMultMatrix(height,rows[1],rand(rowMultScalars)) else rowAddMatrix(height,rows[1],rows[2],rand(rowAddScalars)))),mat)"}, {"name": "isElementary", "params": ["M"], "body": "block([nzOffDg,ans],nzOffDg: findNonzeroOffDiag(M),option: length(nzOffDg),if (option = 0) then isScalarMult(M) elseif (option = 1) then is(M = setelmx(M[nzOffDg[1][1],nzOffDg[1][2]],nzOffDg[1][1],nzOffDg[1][2],ident(length(M)))) elseif (option = 2) then is(M=switchRowsMatrix(length(M),nzOffDg[1][1],nzOffDg[1][2])) else false)"}, {"name": "findNonzeroOffDiag", "params": ["M"], "body": "block([coordlist],coordlist:[],for i:1 thru length(M) do(for j:1 thru length(M) do(coordlist: if (i=j or M[i][j]=0) then coordlist else cons([i,j],coordlist))),coordlist)"}, {"name": "isScalarMult", "params": ["M"], "body": "block([ans,foundScalar],ans: true,foundScalar: false,for i:1 thru length(M) do(if ((not M[i][i] = 1) and (not foundScalar)) then foundScalar: true elseif ((not M[i][i] = 1) and foundScalar) then ans: false),ans)"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונות המטריצות האלמנטריות</p><p dir=\"ltr\" style=\"text-align:center\">\\[E_1 = {{CT:0}}, E_2 = {{CT:1}}\\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">א׳</span></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(E_2 E_1= \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ב׳</span></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(E_1 E_2= \\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans2]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ג׳</span></div><p>האם <span dir=\"ltr\">\\(E_1 E_2 =E_2 E_1\\)</span>?</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans3]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans3]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> מחשבים את שתי המכפלות ומשווים ביניהן.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — המכפלה E₂E₁ (סעיף א׳)</b><br>כפל משמאל ב-<span dir=\"ltr\">\\(E_2\\)</span> מבצע על <span dir=\"ltr\">\\(E_1\\)</span> את פעולת השורה של <span dir=\"ltr\">\\(E_2\\)</span>. אפשר גם לחשב ישירות, שורה כפול עמודה:<p dir=\"ltr\" style=\"text-align:center\">\\[ E_2E_1={{CT:1}}{{CT:0}}={{CT:2}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — המכפלה E₁E₂ (סעיף ב׳)</b><br>באותו אופן, כאן <span dir=\"ltr\">\\(E_1\\)</span> מבצעת את הפעולה שלה על <span dir=\"ltr\">\\(E_2\\)</span>:<p dir=\"ltr\" style=\"text-align:center\">\\[ E_1E_2={{CT:0}}{{CT:1}}={{CT:3}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 3 — השוואה (סעיף ג׳)</b><br>[[if test=\"{{CT:4}}\"]]שתי המכפלות שוות, ולכן התשובה היא <b>true</b> (כן). זה לא נכון לכל זוג מטריצות אלמנטריות: כאן שתי הפעולות לא מפריעות זו לזו.[[else]]המכפלות שונות (משווים איבר-איבר את סעיפים א׳ ו-ב׳), ולכן התשובה היא <b>false</b> (לא). כפל מטריצות אינו חילופי, גם כשמדובר במטריצות אלמנטריות: סדר הביצוע של פעולות השורה משנה את התוצאה.[[/if]]</div></div>", "specificfeedback": "[[feedback:prt2]]<br>[[feedback:prt3]]<br>[[feedback:prt4]]<br>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 1, "insertstars": 0, "forbidfloat": true, "forbidwords": "[[,]],*", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "matrix", "boxsize": 1, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt2", "value": 0.4, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "elm2.elm1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — נכון.</b> תשובתך הראשונה נכונה.</div>"}, "on_false": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — שגוי.</b> תשובתך הראשונה לא נכונה.</div>"}}]}, {"name": "prt3", "value": 0.4, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "elm1.elm2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt3-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳ — נכון.</b> תשובתך השניה נכונה.</div>"}, "on_false": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt3-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳ — שגוי.</b> תשובתך השניה לא נכונה.</div>"}}]}, {"name": "prt4", "value": 0.2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "[ans3]", "tans": "mcq_correct([[true,is(elm1.elm2=elm2.elm1)],[false,not(elm1.elm2=elm2.elm1)]])", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt4-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳ — נכון.</b> תשובתך השלישית נכונה.</div>"}, "on_false": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt4-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳ — שגוי.</b> תשובתך השלישית לא נכונה.</div>"}}]}], "qvnames": ["addScal", "dm", "elm1", "elm2", "multScal", "numOfActions", "solEq"], "nvariants": 50}