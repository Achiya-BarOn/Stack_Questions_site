{"id": "2273953", "name": "גבול פונקציה לפי רציפות  ln העתק לצורך ניסוח שונה", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "num_factored", "params": ["x"], "body": "makepositive*(x-aa)*(x-bb)"}, {"name": "numa", "params": ["x"], "body": "ev(num_factored(x),expand)"}, {"name": "denom_factored", "params": ["x"], "body": "(x-bb)*(x-cc)"}, {"name": "denoma", "params": ["x"], "body": "ev(denom_factored(x),expand)"}, {"name": "ff", "params": ["x"], "body": "(numa(x))/(denoma(x))"}, {"name": "gg", "params": ["x"], "body": "log((num(x))/(denom(x)))"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נתונה הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ g(x) = \\ln\\left(\\frac{{CT:0}}{{CT:1}}\\right).\\]</p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\">הפונקציה \\(g(x)\\) רציפה בנקודה \\({{CT:2}}\\) אם ורק אם נגדיר את \\(g({{CT:2}})\\) להיות שווה ל</p><p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\( \\displaystyle{\\lim_{x \\to {{CT:2}}} g(x) = }\\) [[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">כדי לחשב את הגבול, נמצא תחילה את הגבול של הביטוי שבתוך הלוגריתם. נפרק את הפולינומים במונה ובמכנה, ונקבל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;\\[\\frac{{CT:3}}{{CT:4}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כעת נצמצם את הגורם</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:5}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ונקבל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{{CT:6}}{{CT:7}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הגבול המבוקש מתקבל כעת בקלות בעזרת אריתמטיקה של גבולות:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:8}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כעת, הואיל והפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ ln(x) \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">היא אלמנטרית, ולכן רציפה בכל תחום הגדרתה, ובפרט היא רציפה בנקודה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:8}},\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נקבל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\lim_{x\\to{{CT:2}}} {{CT:9}} = \\ln\\left(\\lim_{x\\to{{CT:2}}} {{CT:10}}\\right) = \\ln({{CT:8}}).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">את הרעיון שהוזכר כאן, אומרים בקיצור: \"פונקציה רציפה מתחלפת עם גבול\".</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctLimit", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["aa", "bb", "cc", "correctLimit", "extraCheck", "ffatb", "makepositive"], "nvariants": 50}