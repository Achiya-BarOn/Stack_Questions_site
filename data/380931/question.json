{"id": "380931", "name": "lim_at_0", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f", "params": ["x"], "body": "[exp(c*abs(x)),-ln(abs(x)^c),-(ln(abs(x)))^(2*b+1),(abs(x))^(-b),exp(1/abs(x)^a),exp(1/abs(x)^c)]"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">לצורך התרגיל הזה נאמר שהפונקציה g ממש גדולה מן הפונקציה f בסביבת אפס, ונסמן כך </span><span style=\"font-size: medium;\">\\(f \\ll g\\) </span><span style=\"font-size: medium;\">אם </span><span style=\"font-size: medium;\">\\(\\lim_{x \\rightarrow 0} \\frac{f(x)}{g(x)} = 0\\). </span><span style=\"font-size: medium;\">המטרה שלכם היא לסדר את שלושת הפונקציות המופיעות למטה. למשל אם אתם חושבים ש-</span><span style=\"font-size: medium;\">\\(f_2 \\ll f_1 \\ll f_3\\) </span><span style=\"font-size: medium;\">כלומר ש</span> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(\\lim_{x \\rightarrow 0} \\frac{f_2}{f_1}=\\lim_{x \\rightarrow 0} \\frac{f_1}{f_3} = 0 \\)</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בחרו את האופציה </span><span style=\"font-size: medium;\">\\([2,1,3]\\).</span></p>\n<p dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>בנושא הניקוד:</strong> האופציה הנכונה תקנה את מלא הנקודות. בחירת הסדר ההפוך לגמרי לא תקנה אף נקודה. כל בחירה אחרת, כלומר כל מצב שבו לפחות שתיים מן הפונקציות מסודרות בסדר הנכון, תקנה 20% מן הנקודות עבור השאלה.</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><strong><span style=\"font-size: medium;\">אם אתם לא יודעים את התשובה לא לנחש! </span></strong><span style=\"font-size: medium;\">סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד. <strong><br /></strong></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. <br /></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[f_1(x)={{CT:0}}, \\ f_2(x)={{CT:1}}, \\ f_3(x)={{CT:2}}\\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "6", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0, "nextnode": 2, "answernote": "prt1-2-F", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "7", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.15, "nextnode": -1, "answernote": "prt1-3-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0.2, "nextnode": -1, "answernote": "prt1-3-F", "feedback": ""}}]}], "qvnames": ["I", "N", "P", "Per", "a", "b", "c", "l", "n1", "n2", "n3", "ta_multiple", "ta_multiple_correct"], "nvariants": 50}