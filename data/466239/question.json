{"id": "466239", "name": "sequence2", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f", "params": ["n"], "body": "sqrt(a*n^2+b*n)-sqrt(a*n^2-b*n)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"text-align: left;\"><span style=\"font-size: medium;\">חשבו את הגבול של הסדרה: </span> </span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[L = \\lim_{n \\rightarrow \\infty} \\left({{CT:0}} \\right) \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> <span style=\"font-size: medium;\"><span style=\"text-align: left; font-size: 10px;\">  </span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>שימו לב: </strong>אם אתם חושבים שהגבול לא קיים (אפילו לא במובן הרחב) סמנו \"Does not exist\".</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד.  </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. </span></p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\"> \\(L\\)  =</span></p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>\n<p><span> </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "10", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.15, "nextnode": -1, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": ""}}]}], "qvnames": ["a", "b", "max", "min", "ta_multiple", "ta_multiple_correct", "tans1", "w10", "w2", "w3", "w4", "w5", "w6", "w7", "w8", "w9"], "nvariants": 50}