{"id": "211877", "name": "אינטגרל משטחי מסוג ראשון על חצי ספירה", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "proj", "params": ["x", "y"], "body": "((x.y)/(y.y))*y"}, {"name": "x", "params": ["u", "v"], "body": "R*sin(v)*cos(u)"}, {"name": "y", "params": ["u", "v"], "body": "R*sin(v)*sin(u)"}, {"name": "z", "params": ["u", "v"], "body": "R*cos(v)"}, {"name": "f", "params": ["x", "y", "z"], "body": "aa*x^2+aa*y^2+bb*z^2"}, {"name": "Xu", "params": ["u", "v"], "body": "[diff(x(u,v),u), diff(y(u,v),u),diff(z(u,v),u)]"}, {"name": "Xv", "params": ["u", "v"], "body": "[diff(x(u,v),v), diff(y(u,v),v),diff(z(u,v),v)]"}, {"name": "W", "params": ["u", "v"], "body": "factor(trigsimp((crossprod(Xu(u,v),Xv(u,v)))))"}, {"name": "J", "params": ["u", "v"], "body": "factor(trigsimp(norm(W(u,v))))"}, {"name": "integ", "params": ["u", "v"], "body": "factor(trigsimp(f(x(u,v),y(u,v),z(u,v))*J(u,v)))"}], "questiontext": "<p dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את האינטגרל המשטחי (מן הסוג הראשון) של הפונקציה&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[f(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">על חצי הספירה:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[S= \\left\\{{{CT:1}}\\in \\mathbb{R}^3 \\ | \\ x^2+y^2+z^2 = {{CT:2}};\\; z \\ge 0 \\right\\}\\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p dir=\"ltr\" style=\"text-align: center;\">\\(\\iint\\limits_{S} f(x,y,z) d\\sigma = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p dir=\"ltr\">&nbsp;</p>\n<p dir=\"rtl\">כאשר \\(\\sigma\\) אלמנט השטח לאורך המשטח.</p>", "generalfeedback": "<p dir=\"rtl\"><span style=\"font-size: medium;\">בכדי לחשב את האיטגרל הזה יש למצוא פרמטריזציה למשטח. במקרה זה ניתן למשל לעבוד במערכת קוארדינטות כדורית:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[X(u,v)={{CT:3}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">מיד נמצא גם את הווקטורים המשיקים למשטח.</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[X_u = {{CT:4}}, X_v={{CT:5}} \\]</span></p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">נורמל למשטח מתקבל כמכפלה וקטורית של שני אילו</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[X_u \\times X_v = {{CT:6}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">ואלמנט השטח נתון על ידי:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[d\\sigma = ||X_u \\times X_v||du dv = {{CT:7}}du dv\\]<br></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">וכעת האינטגרל המבוקש נתון על ידי:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\int_{S} f(x,y,z) d \\sigma =&nbsp;\\int_{{{CT:8}}}^{{{CT:9}}}&nbsp;\\int_{{{CT:10}}}^{{{CT:11}}} {{CT:12}} \\ du&nbsp; \\ dv = {{CT:13}}\\]</span></p>", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">יופי חישבתם את האינטגל נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\">האינטגרל שלכם שגוי.&nbsp;</p>"}}]}], "qvnames": ["R", "Rsq", "aa", "bb", "bestlength", "tans1", "trylength", "u0", "u1", "v0", "v1"], "nvariants": 50}