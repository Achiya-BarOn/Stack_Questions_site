{"id": "126590", "name": "vectors - 4", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"text-align: right;\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">נתונים שני וקטורים</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[ U = {{CT:0}}, N = {{CT:1}} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">משוואת המישור העובר דרך </span><span style=\"font-size: medium;\">\\(U\\) </span><span style=\"font-size: medium;\">כך שהוקטור </span><span style=\"font-size: medium;\">\\(N\\) </span><span style=\"font-size: medium;\">הוא נורמלי (=מאונך) למישור הינה</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\"> \\[ ax + by + cz = d\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium; text-align: center;\">מצאו את מקדמי המשוואה הזו באופן מפורש:</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium; text-align: center;\">\\({{CT:2}}  \\) = </span><span style=\"font-size: medium; text-align: center;\">[[input:v]] </span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium; text-align: center;\"><span>[[validation:v]] </span></span></p><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">d= </span><span style=\"font-size: medium; text-align: center;\">[[input:ans4]] </span><span style=\"font-size: medium;\">[[validation:ans4]]</span></p>", "generalfeedback": "<p><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">בכדי שווקטור </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[V={{CT:3}}\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">ימצא על המישור צריך להתקיים התנאי</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[N \\cdot (V-U)=0\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">כלומר שהישר המחבר בין </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[V\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">לבין</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">מאונך לווקטור</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[N\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">פתיחה של משוואה זו במקרה שלנו נותנת</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[(N,V)={{CT:4}}x+{{CT:5}}y+{{CT:6}}z = {{CT:7}}\\cdot{{CT:0}}={{CT:8}}\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">וזו המשוואה שאכן מתארת את המישור הנדרש. שימו לב שישנן כמה תשובות נכונות, כי גם כל כפולה של משוואה זו מתארת את אותו המישור בדיוק.</span></p>", "specificfeedback": "<p dir=\"ltr\"><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"> </span></span></p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">[[feedback:prt4]]</span></p>\n<p><span> </span></p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans4", "type": "algebraic", "boxsize": 5, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "v", "type": "matrix", "boxsize": 4, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt4", "value": 0.25, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "rk:rank(addcol(v,n));\np:u.v;\nrk2:rank(v);\n", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "rk", "tans": "1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt4-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt4-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "rk2", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt4-2-T", "feedback": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">זו שגיאה, בחרתם את כל מקדמי המשוואה להיות אפסים, מה רציתם לבדוק ע״י זה?</span></p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 2, "answernote": "prt4-2-F", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans4", "tans": "p", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt4-3-T", "feedback": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">תשובה נכונה יפה מאוד</span></p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt4-3-F", "feedback": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">תשובה שגויה</span></p>\n<p style=\"text-align: left;\"> </p