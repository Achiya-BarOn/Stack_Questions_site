{"id": "269469", "name": "מציאת בסיס פולינומים לפי מטריצה מייצגת", "defaultgrade": 3, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randmat3", "params": ["k"], "body": "matrix([1,rand_with_prohib(-k,k,[]),rand_with_prohib(-k,k,[])],[0,1,rand_with_prohib(-k,k,[])],[0,0,1]) . transpose(matrix([1,rand_with_prohib(-k,k,[]),rand_with_prohib(-k,k,[])],[0,1,rand_with_prohib(-k,k,[])],[0,0,1]) )"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>יהי <span dir=\"ltr\">\\(V = \\mathbb{R}_{\\leq 2} [x]\\)</span> ונסמן <span dir=\"ltr\">\\(E=(1,x,x^2) \\)</span>. יהי <span dir=\"ltr\">\\(B = (b_1(x),b_2(x),b_3(x)) \\)</span> בסיס נוסף, ונניח כי</p><p dir=\"ltr\" style=\"text-align:center\">\\[ [I]_B^E = {{CT:0}}.\\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>מצאו את <span dir=\"ltr\">\\(B\\)</span>.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(b_1(x) = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(b_2(x) = \\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans2]]</div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(b_3(x) = \\) [[input:ans3]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans3]]</div><p style=\"font-size:0.92em;margin:8px 0 0\"><b>דוגמה להזנת קלט:</b> כדי להזין את הפולינום <span dir=\"ltr\">\\(x^2+2x-1\\)</span> הזינו <code dir=\"ltr\">x^2 + 2*x - 1</code></p></div></div>", "generalfeedback": "", "specificfeedback": "[[feedback:prt1]]", "prtcorrect": "Correct answer, well done.", "prtpartiallycorrect": "Your answer is partially correct.", "prtincorrect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 3, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "an1(x):=ev(ans1,X=x);\nan2(x):=ev(ans2,X=x);\nan3(x):=ev(ans3,X=x);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "an1(x)", "tans": "CSymbolMat[1,1]", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.3333333, "nextnode": 1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\">הפולינום הראשון נכון.</div>"}, "on_false": {"scoremode": "+", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">הפולינום הראשון איננו נכון.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "an2(x)", "tans": "CSymbolMat[1,2]", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.3333333, "nextnode": 2, "answernote": "prt1-2-T", "feedback": "<div dir=\"rtl\">הפולינום השני נכון.</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 2, "answernote": "prt1-2-F", "feedback": "<div dir=\"rtl\">הפולינום השני איננו נכון.</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "an3(x)", "tans": "CSymbolMat[1,3]", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.3333333, "nextnode": -1, "answernote": "prt1-3-T", "feedback": "<div dir=\"rtl\">הפולינום השלישי נכון.</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<div dir=\"rtl\">הפולינום השלישי איננו נכון.</div>"}}]}], "qvnames": ["BSymbolMat", "CSymbolMat", "baseCols"], "nvariants": 50}