ect.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Diff", "sans": "ans1", "tans": "diff(p,v)", "testoptions": "v ", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "diff(pp1,v)*diff(pp2,v)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-T ", "feedback": "<div dir=\"ltr\">To differentiate a product use the rule \\[\\frac{d}{dx}[fg] = \\frac{df}{dx}g+f\\frac{dg}{dx}.\\] You cannot get the derivative of a product by multiplying the derivatives.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "Result-1-F ", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "diff(pp1,v)*pp1+pp2*diff(pp2,v)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-2-T ", "feedback": "<div dir=\"ltr\">You appear to have applied the product rule incorrectly. It is \\[\\frac{df}{dx}g+f\\frac{dg}{dx},\\] not \\[f\\frac{df}{dx}+g\\frac{dg}{dx}.\\]</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 3, "answernote": "Result-2-F ", "feedback": ""}}, {"name": 3, "answertest": "AlgEquiv", "sans": "ans1", "tans": "diff(pp1,v)*pp2-pp1*diff(pp2,v)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, 