{"id": "1832280", "name": "כלל לופיטל – (2/π·arctan(ax))^(bx) באינסוף", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>חשבו את הגבול:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\lim_{x\\to\\infty}{{CT:0}}= = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> לוקחים לוגריתם, מחשבים את גבול הלוגריתם בכלל לופיטל, וחוזרים לגבול המקורי בעזרת <span dir=\"ltr\">\\(e^{x}\\)</span>.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — לוגריתם</b><br><p>נסמן <span dir=\"ltr\">\\(a={{CT:1}}\\)</span> ו־<span dir=\"ltr\">\\(b={{CT:2}}\\)</span></p><p>נסמן גם</p><p dir=\"ltr\" style=\"text-align:center\">\\[ y={{CT:0}} \\]</p><p>ניקח לוגריתם</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\ln\\left(y\\right)=b x\\ln\\left(\\frac{2}{\\pi}\\arctan\\left(a x\\right)\\right)=b\\frac{\\ln\\left(\\frac{2}{\\pi}\\arctan\\left(a x\\right)\\right)}{1/x} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — כלל לופיטל ומעבר לגבול</b><br><p>זהו גבול מהצורה אפס חלקי אפס. לפי כלל לופיטל</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to\\infty}\\frac{\\ln\\left(\\frac{2}{\\pi}\\arctan\\left(a x\\right)\\right)}{1/x}=-\\frac{2}{a\\pi} \\]</p><p>לכן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to\\infty}\\ln\\left(y\\right)=-\\frac{2b}{a\\pi} \\]</p><p>ומכאן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to\\infty}{{CT:0}}={{CT:3}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:prt1]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 22, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 2, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: if is(equal(radcan(ans1),radcan(limit))) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}], "qvnames": ["a", "b", "ff", "limit"], "nvariants": 50}