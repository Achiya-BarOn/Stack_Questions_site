{"id": "3326603", "name": "אינטגרל משולש בסדר dz dy dx – גבולות תלויים, חישוב מדורג", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 2, "functions": [{"name": "easytype", "params": ["v0"], "body": "if integerp(v0) then is(abs(v0)<10000) else is(abs(num(v0))<1000 and denom(v0)<1000)"}, {"name": "valof", "params": ["A0", "p0", "q0", "F0"], "body": "integrate(integrate(integrate(F0,z,0,y/q0),y,0,x/p0),x,0,A0)"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>יהי</p><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle E= \\left\\{ (x,y,z): 0\\le x\\le{{CT:0}},\\ 0\\le y\\le{{CT:1}},\\ 0\\le z\\le{{CT:2}} \\right\\} \\)</p><p>חשבו את האינטגרל המשולש</p><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle I=\\iiint_E {{CT:3}}\\,dV \\)</p><p>נחשב בסדר <span dir=\"ltr\">\\(\\displaystyle dz\\,dy\\,dx\\)</span>. כתבו תחילה</p><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle I= \\int_0^{{{CT:0}}} \\int_0^{c(x)} \\int_0^{d(y)} {{CT:3}}\\,dz\\,dy\\,dx \\)</p></div><div style=\"text-align:center;margin:10px 0\"><div dir=\"ltr\" style=\"display:inline-block\">[[jsxgraph width='420px' height='380px']]\nvar A = {{CT:4}}, p = {{CT:5}}, q = {{CT:6}}, Y = A / p, Z = Y / q;\nvar P = '#4b1f6f', B = '#0f6cbf';\nvar board = JXG.JSXGraph.initBoard(divid, {boundingbox: [-8, 8, 8, -8], axis: false, showNavigation: false, showCopyright: false});\nvar rg = [[-0.35 * A, 1.25 * A], [-0.35 * Y, 1.25 * Y], [-0.2 * Z, 1.4 * Z]];\nvar view = board.create('view3d', [[-6, -5], [12, 12], [[-1, 1], [-1, 1], [0, 2]]],\n  {projection: 'parallel', axesPosition: 'none', az: {slider: {visible: false}}, el: {slider: {visible: false, start: 0.5}},\n   xPlaneRear: {visible: false}, yPlaneRear: {visible: false}, zPlaneRear: {visible: false, fillOpacity: 0.15}});\nfunction M(p) { return [2 * (p[0] - rg[0][0]) / (rg[0][1] - rg[0][0]) - 1, 2 * (p[1] - rg[1][0]) / (rg[1][1] - rg[1][0]) - 1, 2 * (p[2] - rg[2][0]) / (rg[2][1] - rg[2][0])]; }\nfunction W(i, fx, fy, fz) { return function (s, t) { return M([fx(s, t), fy(s, t), fz(s, t)])[i]; }; }\nfunction crv(fx, fy, fz, r, col, dsh, w) { return view.create('curve3d', [W(0, fx, fy, fz), W(1, fx, fy, fz), W(2, fx, fy, fz), r], {strokeColor: col || B, strokeWidth: w || 2, dash: dsh || 0}); }\nfunction seg(A, C, col, dsh, w) { return crv(function (t) { return A[0] + t * (C[0] - A[0]); }, function (t) { return A[1] + t * (C[1] - A[1]); }, function (t) { return A[2] + t * (C[2] - A[2]); }, [0, 1], col || P, dsh, w); }\nfunction txt(p, s, col) { var m = M(p); return view.create('text3d', [m[0], m[1], m[2], s], {fontSize: 14, strokeColor: col || '#555'}); }\nfunction surf(fx, fy, fz, ru, rv, su, sv) { return view.create('parametricsurface3d', [W(0, fx, fy, fz), W(1, fx, fy, fz), W(2, fx, fy, fz), ru, rv], {strokeColor: P, strokeWidth: 0.6, stepsU: su, stepsV: sv}); }\nvar lo = [-0.08 * rg[0][1], -0.08 * rg[1][1], -0.08 * rg[2][1]], zt = 0.8 * rg[2][1];\nseg([lo[0], 0, 0], [rg[0][1], 0, 0], '#888', 0, 1); seg([0, lo[1], 0], [0, rg[1][1], 0], '#888', 0, 1); seg([0, 0, lo[2]], [0, 0, zt], '#888', 0, 1);\ntxt([rg[0][1], 0, 0], 'x'); txt([0, rg[1][1], 0], 'y'); txt([0, 0, zt], 'z');\nvar V = [[0, 0, 0], [A, 0, 0], [A, Y, 0], [A, Y, Z]];\nseg(V[0], V[1], B); seg(V[1], V[2], B); seg(V[2], V[0], B); seg(V[0], V[3]); seg(V[1], V[3]); seg(V[2], V[3]);\n[[/jsxgraph]]<div dir=\"rtl\" style=\"font-size:0.85em;color:#555\">הגוף <span dir=\"ltr\">\\(E\\)</span> (בכחול: הבסיס שלו במישור <span dir=\"ltr\">\\(xy\\)</span>). קנה המידה בצירים אינו אחיד. אפשר לסובב את הציור בגרירה.</div></div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">א׳</span>הגבולות התלויים</div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\displaystyle c(x)=\\) [[input:ans1]] &nbsp;&nbsp;&nbsp;&nbsp; \\(\\displaystyle d(y)=\\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]] [[validation:ans2]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ב׳</span>לאחר האינטגרציה לפי <span dir=\"ltr\">\\(z\\)</span></div><p>נסמן את תוצאת האינטגרציה הפנימית ב־<span dir=\"ltr\">\\(\\displaystyle J_1(x,y)\\)</span>:</p><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle J_1(x,y) = \\int_0^{d(y)} {{CT:3}}\\,dz \\)</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\displaystyle J_1(x,y)=\\) [[input:ans3]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans3]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ג׳</span>לאחר האינטגרציה לפי <span dir=\"ltr\">\\(y\\)</span></div><p>כעת נסמן את תוצאת האינטגרציה השנייה ב־<span dir=\"ltr\">\\(\\displaystyle J_2(x)\\)</span>:</p><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle J_2(x) = \\int_0^{c(x)} J_1(x,y)\\,dy \\)</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\displaystyle J_2(x)=\\) [[input:ans4]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans4]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ד׳</span>האינטגרציה האחרונה</div><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle I= \\int_0^{{{CT:0}}} J_2(x)\\,dx \\)</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\displaystyle I=\\) [[input:ans5]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans5]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> קוראים את הגבולות מהגדרת התחום, ומחשבים מבפנים החוצה: כל אינטגרציה היא של פולינום.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הגבולות (סעיף א׳)</b><br><p>מהגדרת <span dir=\"ltr\">\\(E\\)</span>: הגבול העליון של <span dir=\"ltr\">\\(y\\)</span> תלוי ב-<span dir=\"ltr\">\\(x\\)</span>, והגבול העליון של <span dir=\"ltr\">\\(z\\)</span> תלוי ב-<span dir=\"ltr\">\\(y\\)</span>:</p><p dir=\"ltr\" style=\"text-align:center\">\\[ c(x)={{CT:1}},\\qquad d(y)={{CT:2}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — האינטגרל לפי z (סעיף ב׳)</b><br><p>נחשב בסדר <span dir=\"ltr\">\\(\\displaystyle dz\\,dy\\,dx\\)</span>; <span dir=\"ltr\">\\(x\\)</span> ו-<span dir=\"ltr\">\\(y\\)</span> קבועים בשלב זה:</p><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle J_1(x,y)=\\int_0^{y/{{CT:7}}}{{CT:3}}\\,dz={{CT:8}}\\)</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 3 — האינטגרל לפי y (סעיף ג׳)</b><br><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle J_2(x)=\\int_0^{x/{{CT:9}}}J_1(x,y)\\,dy={{CT:10}}\\)</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 4 — האינטגרל לפי x (סעיף ד׳)</b><br><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle I=\\int_0^{{{CT:0}}}J_2(x)\\,dx={{CT:11}}\\)</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:prt1]] [[feedback:prt2]] [[feedback:prt3]] [[feedback:prt4]] [[feedback:prt5]]<span style=\"position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; white-space: nowrap;\" aria-hidden=\"true\"> [[feedback:prt6]] [[feedback:prt7]] [[feedback:prt8]]</span></div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">חלק מן התשובה נכון. בדקו את שאר הרכיבים.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה עדיין אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 10, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 10, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 14, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 14, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans5", "type": "algebraic", "boxsize": 16, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "ytopp", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳, <span dir=\"ltr\">\\(c(x)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳, <span dir=\"ltr\">\\(c(x)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "ztop", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳, <span dir=\"ltr\">\\(d(y)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳, <span dir=\"ltr\">\\(d(y)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt3", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans3", "tans": "J1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt3-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(J_1(x,y)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt3-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(J_1(x,y)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt4", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans4", "tans": "J2", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt4-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(J_2(x)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt4-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(J_2(x)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt5", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans5", "tans": "val", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt5-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ד׳, <span dir=\"ltr\">\\(I\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt5-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ד׳, <span dir=\"ltr\">\\(I\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt6", "value": 0, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "0", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-F", "feedback": ""}}]}, {"name": "prt7", "value": 0, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "0", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-F", "feedback": ""}}]}, {"name": "prt8", "value": 0, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "0", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-F", "feedback": ""}}]}], "qvnames": ["A", "F", "J1", "J2", "c", "fam", "nicedraw", "p", "q", "val", "ytopp", "ztop"], "nvariants": 50}