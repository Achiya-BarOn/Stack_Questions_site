{"id": "1890961", "name": "אינטגרל מוכלל מסוג שני – סינוס וחזקה", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q10_IMPROPER_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">קבעו האם האינטגרל מתכנס</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 19px; line-height: 1.9;\">\\(\\displaystyle \\int_{0}^{1} {{CT:0}}\\,dx\\)</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div>האם האינטגרל מתכנס? <span dir=\"ltr\">[[input:ans1]]</span> <span style=\"color: #665f6b; font-size: 13px;\">[[validation:ans1]]</span></div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q10_IMPROPER_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>ליד <span dir=\"ltr\">\\(\\displaystyle 0\\)</span> מתקיים <span dir=\"ltr\">\\(\\displaystyle \\sin\\left({{CT:1}}x\\right)\\sim {{CT:1}}x\\)</span>. לכן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle {{CT:0}}\\sim {{CT:1}}^{{CT:2}}x^{{{CT:2}}-{{CT:3}}}\\)</div>\n<p>האינטגרל <span dir=\"ltr\">\\(\\displaystyle \\int_0^1x^\\gamma\\,dx\\)</span> מתכנס אם ורק אם <span dir=\"ltr\">\\(\\displaystyle \\gamma&gt;-1\\)</span>. לכן כאן התנאי הוא <span dir=\"ltr\">\\(\\displaystyle {{CT:3}}&lt;{{CT:2}}+1\\)</span>.</p>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:prt1]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "boolean", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "feedbackstyle": 1, "feedbackvariables": "correct: if (converge = ans1) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "correct", "tans": "true", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}], "qvnames": ["asym", "b", "converge", "den", "f", "freq", "m", "shift"], "nvariants": 50}