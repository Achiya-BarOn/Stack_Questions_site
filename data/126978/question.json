{"id": "126978", "name": "פירוק פולינומים ממעלה 2 לגורמים", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randcomplex", "params": ["n"], "body": "block([re,im],re: rand_with_prohib(-n,n,[]),im: rand_with_prohib(-n,n,[]),re + im*%i)"}, {"name": "randcomplexnonzero", "params": ["n"], "body": "block([re,im],re: rand_with_prohib(-n,n,[]),im: rand_with_prohib(-n,n,[0]),re + im*%i)"}, {"name": "pp", "params": ["z"], "body": "ratsimp(z^2 -(z1+z2)*z+z1*z2)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">נתון הפולינום המרוכב</p>\n<p style=\"text-align: center;\" dir=\"rtl\">\\(p(z)={{CT:0}}\\)</p><p style=\"direction: rtl; text-align: right;\" dir=\"rtl\">מצאו \\(z_1,z_2\\) מרוכבים כך ש \\(p(z)=(z-z_1)\\cdot (z-z_2)\\) [כלומר,&nbsp;\\(z_1,z_2\\) מקיימים כי \\(p(z_1)=p(z_2)=0\\). היעזרו בנוסחת השורשים לפולינום ריבועי].</p>\n<p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(z_1\\)=[[input:ans1]] [[validation:ans1]]</p><p class=\"input-hint input-hint-complex\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: את היחידה המדומה \\(i\\) מזינים באות <code dir=\"ltr\">i</code> (אפשר גם <code dir=\"ltr\">%i</code>), וכפל מסמנים בכוכבית. למשל <code dir=\"ltr\">3-2*i</code>.</p><p style=\"text-align: center;\" dir=\"ltr\">\\(z_2\\)=[[input:ans2]] [[validation:ans2]]<br></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "^", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "is({z1,z2}={ans1,ans2})", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">התשובה נכונה</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">התשובה אינה נכונה</p>"}}]}], "qvnames": ["z1", "z2"], "nvariants": 50}