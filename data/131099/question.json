ic", "boxsize": 3, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 3, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 3, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 3, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "stdplane: ans1*x+ans2*y+ans3*z+ans4=0;\nisplane: not is(ans1=0 and ans2=0 and ans3=0);\nfirst: check_point(stdplane, p1);\nsecond: check_point(stdplane, p2);\nthird: check_point(stdplane, p3);\nchecksout: is(first and second and third);\ncnor:is(myuvect(nn)=myuvect([ans1,ans2,ans3])) or is(myuvect(nn)=-myuvect([ans1,ans2,ans3]));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "isplane", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">במשוואת מישור לפחות אחד מהמקדמים \\(a,b,c\\) שונה מאפס.</p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "checksout", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"