{"id": "1656270", "name": "מציאת שורשים מרוכבים של פולינום מדרגה 3 בהניתן שורש אחד וחילוק פולינומים", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randcomplexnonzero", "params": ["n"], "body": "block([re,im],re: rand_with_prohib(-n,n,[]),im: rand_with_prohib(-n,n,[0]),re + im*%i)"}, {"name": "pp", "params": ["z"], "body": "ratsimp((z-z1)*(z-z2)*(z-rr))"}], "questiontext": "<p></p><p style=\"direction: rtl; text-align: right;\">נתון הפולינום&nbsp;</p><p style=\"text-align: center; direction: ltr;\">\\[p(z)={{CT:0}}\\]</p><p style=\"direction: rtl; text-align: right;\">בקבוצת הפולינומים המרוכבים. נתון כי&nbsp;<span style=\"font-size: 0.9375rem;\">{{CT:1}}</span><span style=\"font-size: 0.9375rem;\">&nbsp;הינו שורש של הפולינום הנ\"ל (כלומר \\(p({{CT:2}})=0\\).</span></p><p style=\"direction: rtl; text-align: right;\"></p><p style=\"direction: rtl; text-align: right;\">כיוון שכך, ניתן לכתוב&nbsp;</p><p style=\"direction: ltr; text-align: center;\">\\(p(z)=(z-({{CT:2}}))\\cdot q(z)\\)</p><p style=\"direction: rtl; text-align: right;\">עבור איזה שהוא פולינום מרוכב \\(q(z)\\). מצאו את \\(q(z)\\).&nbsp;</p><p style=\"direction: ltr; text-align: center;\">\\(q(z)=\\)&nbsp;[[input:ans1]] [[validation:ans1]]</p><p style=\"direction: rtl; text-align: right;\"></p><p style=\"direction: rtl; text-align: right;\"></p><p style=\"direction: rtl; text-align: right;\">הערה: הדרך להזנת הפולינום \\({{CT:3}}\\) היא&nbsp;w0+w1*z+z^2.</p><p style=\"direction: rtl; text-align: right;\">כעת, מצאו את כל השורשים של \\(p(z)\\) (כלומר את כל המספרים המרוכבים \\(w\\) כך ש \\(p(w)=0\\)). נסמן את קבוצת השורשים ב (S\\). מצאו אותה (הערה: קבוצה מסומנת בעזרת סוגרים מסולסלות {}).</p><p style=\"direction: ltr; text-align: center;\">\\(S=\\)&nbsp;[[input:ans2]] [[validation:ans2]]</p><p style=\"direction: rtl; text-align: right;\">הערה: הדרך להזנת מספר מרוכב \\(a+b\\cdot i\\) היא a+b*i (גם מקדמי הפולינום וגם השורשים שבשאלה).</p><p style=\"direction: rtl; text-align: right;\"></p>", "generalfeedback": "", "specificfeedback": "[[feedback:prt1]]<br>[[feedback:prt2]]<br>", "prtcorrect": "Correct answer, well done.", "prtpartiallycorrect": "Your answer is partially correct.", "prtincorrect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "w0+w1*z+z^2", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "{z1, z2, z3}", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "ta1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right; direction: rtl;\"></p>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "ta2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": ""}}]}], "qvnames": ["rr", "ta1", "ta2", "z1", "z2"], "nvariants": 50}