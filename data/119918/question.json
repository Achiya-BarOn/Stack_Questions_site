{"id": "119918", "name": "אינטגרל2", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p>&nbsp;</p>\n<p style=\"text-align: right;\">חשבו ואל תשכחו את הקבוע</p>\n<p style=\"text-align: center;\">&nbsp;\\[ \\int {{CT:0}} d{{CT:1}}. \\]&nbsp;</p>\n<p style=\"text-align: right;\">רמז, הציבו</p>\n<p style=\"text-align: right;\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(u = {{CT:2}}\\)&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span>[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "<p>&nbsp;</p>\n<p style=\"text-align: right;\">בכדי לחשב את האינטגרל</p>\n<p style=\"text-align: center;\">\\[\\int {{CT:0}} d{{CT:1}}\\]&nbsp;</p>\n<p style=\"text-align: center;\">נשתמש בהצבה</p>\n<p style=\"text-align: center;\">\\(u={{CT:2}}\\).&nbsp;</p>\n<p style=\"text-align: right;\">אז אם</p>\n<p style=\"text-align: center;\">\\(u = {{CT:2}}\\)&nbsp;</p>\n<p style=\"text-align: center;\">ו</p>\n<p style=\"text-align: center;\">\\({{CT:3}} = {{CT:4}}\\)</p>\n<p style=\"text-align: right;\">ו</p>\n<p style=\"text-align: center;\">\\(d{{CT:5}} = {{CT:6}} d{{CT:1}}\\),</p>\n<p style=\"text-align: right;\">אז</p>\n<p style=\"text-align: center;\">\\(d{{CT:1}} = d{{CT:5}}/{{CT:6}} = d{{CT:5}}2({{CT:4}})\\).</p>\n<p style=\"text-align: right;\">ולכו</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;\\[\\begin{array}{rcl}\\displaystyle \\int {{CT:0}} d{{CT:1}} &amp;\\displaystyle =&amp;\\displaystyle \\int \\frac{1}{u} d{{CT:5}}2({{CT:4}}) \\\\ &amp;\\displaystyle =&amp;\\displaystyle \\int {{CT:7}}d{{CT:5}} \\\\ &amp;\\displaystyle =&amp;\\displaystyle \\int {{CT:8}}d{{CT:5}} \\\\ &amp;\\displaystyle =&amp;\\displaystyle {{CT:9}} \\\\ &amp;\\displaystyle =&amp;\\displaystyle {{CT:10}} \\end{array}\\]</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\">&nbsp;</p>\n<p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p>&nbsp;</p>\n<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p>&nbsp;</p>\n<p style=\"text-align: right;\">תשובה חלקית</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "varss:listofvars(ans1);\nvarss:delete(C,delete(c,varss));\nan1:ans1;\nfor i:1 while i<=length(varss) do an1:ev(an1,varss[i]=v);\n\nta2:2*(sqrt(v)+rdm1)-2*rdm1*ln(abs(sqrt(v)+rdm1))+c;\ndta2:ev(diff(ta2,v));\n\nstu:ev(diff(an1,v));\nc1:ev(diff(an1,c));\nc2:ev(diff(an1,C));\nd:c1^2+c2^2;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "stu", "tans": "p", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "nextnode": 1, "answernote": "Result-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "Result-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "d", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}, "on_false": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "Result-2-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "stu", "tans": "dta2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": 1, "answernote": "Result-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-3-F", "feedback": ""}}]}], "qvnames": ["dumvar4", "p", "pp", "q", "rdm1", "v"], "nvariants": 5}