{"id": "119939", "name": "נגזרת של e^(x·cos x)", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "pz", "params": ["x"], "body": "if numberp(x) then (if x<0 then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)) elseif atom(x) then tex1(x) elseif member(op(x),[\"+\",\"-\"]) or (op(x)=\"*\" and numberp(first(x)) and first(x)<0) then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "pz1", "params": ["x"], "body": "if not atom(x) and op(x)=\"+\" then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(append([pz1(first(args(e)))], map(pz, rest(args(e)))), \" \\\\cdot \")"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>מצאו את הנגזרת של הפונקציה</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\displaystyle{f({{CT:0}})=\\Large{{{CT:1}}}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle{f'({{CT:0}})} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> הפונקציה היא <span dir=\"ltr\">\\(e\\)</span> בחזקת מכפלה. גוזרים את המעריך לפי כלל המכפלה, ואת הפונקציה כולה לפי כלל השרשרת.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — נגזרת המעריך (כלל המכפלה)</b><br>נסמן את המעריך ב-<span dir=\"ltr\">\\(g({{CT:0}})={{CT:2}}\\)</span>. זו מכפלה של <span dir=\"ltr\">\\({{CT:0}}\\)</span> ושל <span dir=\"ltr\">\\({{CT:3}}\\)</span>, ולפי כלל המכפלה:<div style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;margin:12px 0\">כלל המכפלה: <span dir=\"ltr\">\\( \\frac{d}{dx}(uv)=u'v+uv' \\)</span></div><p dir=\"ltr\" style=\"text-align:center\">\\[ g'({{CT:0}})=1\\cdot {{CT:3}}+{{CT:4}}={{CT:5}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — כלל השרשרת</b><br><div style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;margin:12px 0\">כלל השרשרת: <span dir=\"ltr\">\\( \\frac{d}{dx}f(g(x))=f'(g(x))\\,g'(x) \\)</span></div>הנגזרת של <span dir=\"ltr\">\\(e^{g}\\)</span> לפי <span dir=\"ltr\">\\(g\\)</span> היא <span dir=\"ltr\">\\(e^{g}\\)</span>, ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ f'({{CT:0}})=e^{g({{CT:0}})}\\cdot g'({{CT:0}})={{CT:6}} \\]</p>ולאחר פישוט:<p dir=\"ltr\" style=\"text-align:center\">\\[ f'({{CT:0}})={{CT:7}} \\]</p></div></div>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "q:pp2/pp1;\nvarss:listofvars(ans1);\nan1:ans1;\nfor i:1 while i<=length(varss) do an1:ev(an1,varss[i]=v);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Diff", "sans": "an1", "tans": "factor(diff(p,v))", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "an1", "tans": "-factor(diff(p,v))", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-T ", "feedback": "<div dir=\"rtl\"><p dir=\"ltr\" style=\"text-align:center\">You appear to have lost the minus sign as your answer is the negative of what was expected.</p></div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-F ", "feedback": ""}}]}], "qvnames": ["p", "p1", "p2", "v"], "nvariants": 2}