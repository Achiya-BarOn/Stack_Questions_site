{"id": "135377", "name": "הצבת מטריצה בפולינום", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "poly", "params": ["a"], "body": "sum(polycof[i+1]*a^^i,i,0,deg)"}, {"name": "texp", "params": ["x"], "body": "if numberp(x) and x<0 then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(map(texp, args(e)), \" \\\\cdot \")"}, {"name": "texsumf", "params": ["e"], "body": "block([L:first(args(e))], concat(tex1(first(L)), apply(sconcat, map(lambda([t], concat(\"+\",texp(t))), rest(L)))))"}, {"name": "texsubf", "params": ["e"], "body": "concat(tex1(first(args(e))), \"-\", texp(second(args(e))))"}, {"name": "texsq", "params": ["e"], "body": "concat(texp(first(args(e))), \"^2\")"}, {"name": "prodshow", "params": ["P", "Q"], "body": "genmatrix(lambda([i,j], sumf(makelist(mul(P[i,l],Q[l,j]),l,1,length(Q)))), length(P), length(first(Q)))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונה המטריצה</p><p dir=\"ltr\" style=\"text-align:center\">\\[A={{CT:0}}\\]</p><p>והפולינום</p><p dir=\"ltr\" style=\"text-align:center\">\\[P(x)={{CT:1}}\\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>חשבו:</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(P(A)=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> מציבים את <span dir=\"ltr\">\\(A\\)</span> במקום <span dir=\"ltr\">\\(x\\)</span> (המחובר הקבוע מוכפל ב-<span dir=\"ltr\">\\(I\\)</span>), מחשבים את החזקות של <span dir=\"ltr\">\\(A\\)</span> ומחברים.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הצבת המטריצה בפולינום</b><br>מציבים <span dir=\"ltr\">\\(x=A\\)</span> בפולינום. המחובר הקבוע הופך לכפולה של מטריצת היחידה <span dir=\"ltr\">\\(I\\)</span>:<p dir=\"ltr\" style=\"text-align:center\">\\[ P(A)={{CT:2}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — החזקות של <span dir=\"ltr\">\\(A\\)</span></b><br>[[if test=\"{{CT:9}}\"]]כופלים שורה בעמודה:<p dir=\"ltr\" style=\"text-align:center\">\\[ A^2={{CT:0}}{{CT:0}}={{CT:3}}={{CT:4}} \\]</p>[[else]]בפולינום אין מחובר עם <span dir=\"ltr\">\\(x^2\\)</span>, ולכן אין צורך לחשב את <span dir=\"ltr\">\\(A^2\\)</span>.[[/if]]</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 3 — סכום המחוברים</b><br>מכפילים כל מטריצה במקדם שלה ומחברים איבר-איבר:<p dir=\"ltr\" style=\"text-align:center\">\\[ P(A)={{CT:5}}[[if test=\"{{CT:10}}\"]]+{{CT:6}}[[/if]][[if test=\"{{CT:9}}\"]]+{{CT:7}}[[/if]]={{CT:8}} \\]</p></div></div>", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": ".,^^", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "matrix([a,b],[c,d])", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "poly(mat)", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\">תשובתך נכונה.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">תשובתך אינה נכונה.</div>"}}]}], "qvnames": ["deg", "dispPA", "disppoly", "mat", "matSq", "polycof"], "nvariants": 50}