{"id": "141852", "name": "חישוב וקטור מהטלות", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randvervect", "params": ["n", "k"], "body": "transpose(makelist(rand_with_step(-k,k,1),n))"}, {"name": "randvervectnonzero", "params": ["n", "k"], "body": "transpose(makelist(rand_with_prohib(-k,k,[0]),n))"}, {"name": "matrify", "params": ["veclst"], "body": "block([mat:matrix([])], for i:1 thru length(veclst) do(mat:addcol(mat,veclst[i])),mat)"}, {"name": "dependentvects", "params": ["veclst"], "body": "is(rank(matrify(veclst))<length(veclst))"}, {"name": "inSpan", "params": ["veclst1", "veclst2"], "body": "is(rank(matrify(veclst1)) = rank(matrify(append(veclst1,veclst2))))"}, {"name": "dezero", "params": ["vec", "n", "k"], "body": "if (zeromatrixp(vec)) then randvervectnonzero(n,k) else vec"}, {"name": "prod", "params": ["u", "v"], "body": "simplify(expand(transpose(u).conjugate(v)))"}, {"name": "perpp", "params": ["u", "v"], "body": "is(prod(u,v)=0)"}, {"name": "unitvectp", "params": ["u"], "body": "is(prod(u,u)=1)"}, {"name": "unitvectify", "params": ["u"], "body": "block([norm: sqrt(prod(u,u))], if (norm=0) then u else (u/norm))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונים שני וקטורים ב-<span dir=\"ltr\">\\(\\mathbb{R}^3\\)</span></p><p dir=\"ltr\" style=\"text-align:center\">\\(v= {{CT:0}}\\),&nbsp;&nbsp;&nbsp;&nbsp;\\(u={{CT:1}}\\)</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>מצאו וקטור <span dir=\"ltr\">\\(w\\)</span> כך שההטלה שלו על <span dir=\"ltr\">\\(span\\{v\\}\\)</span> היא <span dir=\"ltr\">\\({{CT:2}}\\cdot v\\)</span> וההטלה שלו על <span dir=\"ltr\">\\(span\\{u\\}\\)</span> היא <span dir=\"ltr\">\\({{CT:3}}\\cdot u\\)</span>.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(w=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p></div></div>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "validInput: (length(ans1)=n and length(transpose(ans1))=1);\nans: if validInput then simplify(rootscontract(ans1)) else zeromatrix(n,1);\n\nvprojcoef: simplify(rootscontract(prod(ans,v)/prod(v,v)));\nuprojcoef: simplify(rootscontract(prod(ans,u)/prod(u,u)));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "validInput", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">הקלט שהזנת אינו וקטור עמודה בגודל המתאים.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "vprojcoef", "tans": "scalars[1]", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 2, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<div dir=\"rtl\">תשובתך אינה נכונה. ההטלה של הוקטור <span dir=\"ltr\">\\(w\\)</span> שהזנת על המרחב <span dir=\"ltr\">\\(span\\{v\\}\\)</span> היא <span dir=\"ltr\">\\({@vprojcoef@}\\cdot v\\)</span>.</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "uprojcoef", "tans": "scalars[2]", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-3-T", "feedback": "<div dir=\"rtl\">תשובתך נכונה.</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<div dir=\"rtl\">תשובתך אינה נכונה. ההטלה של הוקטור <span dir=\"ltr\">\\(w\\)</span> שהזנת על המרחב <span dir=\"ltr\">\\(span\\{u\\}\\)</span> היא <span dir=\"ltr\">\\({@uprojcoef@}\\cdot u\\)</span>.</div>"}}]}], "qvnames": ["A", "B", "b", "k", "n", "scalars", "sol", "u", "v"], "nvariants": 50}