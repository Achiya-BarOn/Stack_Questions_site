{"id": "140365", "name": "הצגת וקטור כסכום - 02 - פולינום", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randvervect", "params": ["n", "k"], "body": "transpose(makelist(rand_with_step(-k,k,1),n))"}, {"name": "vectToPoly", "params": ["vect"], "body": "block([poly:0], for i:0 thru (length(vect)-1) do(poly: poly + x^i*vect[i+1,1]),poly)"}, {"name": "alltrue", "params": ["pred", "lst"], "body": "emptyp(delete(true,map(pred, lst)))"}, {"name": "goodpol", "params": ["p"], "body": "is(listofvars(p) = [x] or listofvars(p)=[]) and is(hipow(p,x)<n)"}, {"name": "inspaceU", "params": ["p"], "body": "is(subst(1,x,p) = 0)"}, {"name": "inspaceW", "params": ["p"], "body": "is(subst(-1,x,p) = 0)"}, {"name": "solmaker", "params": ["r"], "body": "[((vec[3,1]-vec[2,1]-vec[1,1]+2*r)/2)*x^2 -((vec[3,1]-vec[2,1]+vec[1,1])/2)*x + vec[1,1]-r, ((vec[3,1]+vec[2,1]+vec[1,1]-2*r)/2)*x^2 + ((vec[3,1]+vec[2,1]+vec[1,1])/2)*x + r]"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונים המרחבים <span dir=\"ltr\">\\(U,W\\subseteq\\mathbb{R}_{\\leq 2}[x]\\)</span> המוגדרים</p><p dir=\"ltr\" style=\"text-align:center\">\\[U = \\{q(x)\\ |\\ q(1)=0\\}\\]</p><p dir=\"ltr\" style=\"text-align:center\">\\[W = \\{q(x)\\ |\\ q(-1)=0\\}\\]</p><p>ונתון הפולינום</p><p dir=\"ltr\" style=\"text-align:center\">\\[p(x)={{CT:0}}\\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>מצאו פולינומים <span dir=\"ltr\">\\(r_1(x),r_2(x)\\in U\\)</span> שונים ופולינומים <span dir=\"ltr\">\\(s_1(x),s_2(x)\\in W\\)</span> שונים כך ש-<span dir=\"ltr\">\\(r_1(x)+s_1(x)=p(x)=r_2(x)+s_2(x)\\)</span></p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(r_1(x)=\\) [[input:ans1]] &nbsp;&nbsp;&nbsp;&nbsp; \\(s_1(x)=\\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]] [[validation:ans2]]</div><div style=\"margin-top:10px\"></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(r_2(x)=\\) [[input:ans3]] &nbsp;&nbsp;&nbsp;&nbsp; \\(s_2(x)=\\) [[input:ans4]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans3]] [[validation:ans4]]</div><p style=\"font-size:0.92em;margin:8px 0 0\">הערה: הדרך להזנת הפולינום <span dir=\"ltr\">\\(ax^2+bx+c\\)</span> היא <code dir=\"ltr\">a*x^2+b*x+c</code>. שימו לב לכתוב את הפולינומים במשתנה <code dir=\"ltr\">x</code> (קטן) בלבד.</p><p style=\"font-size:0.92em;margin:8px 0 0\">הערה: הדרך להזנת השבר <span dir=\"ltr\">\\({{CT:1}}\\)</span> היא <code dir=\"ltr\">a/b</code></p></div></div>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "X", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "a*x^2+b*x+c", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "X", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "a*x^2+b*x+c", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "X", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "a*x^2+b*x+c", "syntaxattribute": 0, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "X", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "a*x^2+b*x+c", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "validInput: alltrue(goodpol,[ans1,ans2,ans3,ans4]);\nnotequal: not is(ans1 = ans3 or ans2 = ans4)\nokayU: alltrue(inspaceU,[ans1,ans3]);\nokayW: alltrue(inspaceW,[ans2,ans4]);\ngoodpairs: is(pol = ans1+ans2 and pol = ans3+ans4);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "validInput", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">לפחות אחד מהפולינומים שהזנת אינו שייך ל-<span dir=\"ltr\">\\(\\mathbb{R}_{\\leq 2}[x]\\)</span>. יש לוודא את מעלת הפולינומים וכן שהמשתנה בכל אחד מהם הוא <span dir=\"ltr\">\\(x\\)</span>.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "notequal", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 2, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<div dir=\"rtl\">לא מולאה הדרישה ש-<span dir=\"ltr\">\\(r_1(x)\\neq r_2(x)\\)</span> וגם <span dir=\"ltr\">\\(s_1(x)\\neq s_2(x)\\)</span>.</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "okayU", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 3, "answernote": "prt1-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<div dir=\"rtl\">לפחות אחד מן הפולינומים <span dir=\"ltr\">\\(r_1(x),r_2(x)\\)</span> שהזנת אינו שייך ל-<span dir=\"ltr\">\\(U\\)</span>.</div>"}}, {"name": 3, "answertest": "AlgEquiv", "sans": "okayW", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 4, "answernote": "prt1-4-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-4-F", "feedback": "<div dir=\"rtl\">לפחות אחד מן הפולינומים <span dir=\"ltr\">\\(s_1(x),s_2(x)\\)</span> שהזנת אינו שייך ל-<span dir=\"ltr\">\\(W\\)</span>.</div>"}}, {"name": 4, "answertest": "AlgEquiv", "sans": "goodpairs", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-5-T", "feedback": "<div dir=\"rtl\">תשובתך נכונה.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-5-F", "feedback": "<div dir=\"rtl\">לפחות אחד מהשוויונות <span dir=\"ltr\">\\(p(x)=r_2(x)+s_2(x)\\)</span>, <span dir=\"ltr\">\\(p(x)=r_1(x)+s_1(x)\\)</span> אינו נכון.</div>"}}]}], "qvnames": ["k", "n", "pol", "sol0", "sol1", "vec"], "nvariants": 50}