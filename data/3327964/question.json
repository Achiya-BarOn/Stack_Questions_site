{"id": "3327964", "name": "מד״ר פרידה – yy' עם חזקה ותנאי התחלה", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q8_NEW6_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">בעיית התחלה עם מכפלה yy'</div>\n<div style=\"margin-bottom: 10px;\">מצאו את הפתרון המקיים <span dir=\"ltr\">\\(\\displaystyle y(0)={{CT:0}}\\)</span>.</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 19px; line-height: 1.9;\">\\(\\displaystyle {{CT:1}}\\)</div>\n<div style=\"margin-top: 8px; color: #665f6b; font-size: 14px;\">תנאי ההתחלה קובע את הענף החיובי.</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle y(x)=\\) [[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q8_NEW6_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>מפרידים משתנים</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle y\\,dy=\\frac{{{CT:2}}x^{2{{CT:3}}-1}}{x^{2{{CT:3}}}+{{CT:4}}}\\,dx\\)</div>\n<p>בהצבה <span dir=\"ltr\">\\(u=x^{2{{CT:3}}}+{{CT:4}}\\)</span> מתקבל</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle \\frac{y^2}{2}=\\frac{{{CT:2}}}{2{{CT:3}}}\\ln\\left(x^{2{{CT:3}}}+{{CT:4}}\\right)+C\\)</div>\n<p>מציבים <span dir=\"ltr\">\\(x=0\\)</span> ו־<span dir=\"ltr\">\\(y={{CT:0}}\\)</span>, ומקבלים</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle y^2={{CT:0}}^2+\\frac{{{CT:2}}}{{{CT:3}}}\\ln\\left(\\frac{x^{2{{CT:3}}}+{{CT:4}}}{{{CT:4}}}\\right)\\)</div>\n<p>מאחר שתנאי ההתחלה חיובי, נבחר הענף החיובי</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px; font-weight: bold;\">\\(\\displaystyle y(x)={{CT:5}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 42, "insertstars": 5, "forbidfloat": true, "forbidwords": "diff", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "ביטוי ב-x", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "res:radcan((x^(2*mm)+AA)*ans1*diff(ans1,x)-bb*x^(2*mm-1));\nic:radcan(subst(x=0,ans1)-y0);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "res", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0.7, "nextnode": 1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ic", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.3, "nextnode": -1, "answernote": "Result-1-T ", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-1-F ", "feedback": ""}}]}], "qvnames": ["AA", "bb", "correctanswer", "mm", "ode", "y0"], "nvariants": 50}