": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans4", "tans": "ulo", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt4-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(a\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt4-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(a\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt5", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans5", "tans": "uhi", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt5-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(b\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt5-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(b\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt6", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans6", "tans": "vlo", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(c\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(c\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt7", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans7", "tans": "vhi", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(d\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(d\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt8", "value": 3, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans8", "tans": "val", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(I\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(I\\)</span> — שגוי.</b></div>"}}]}], "qvnames": ["Jdet", "Jm", "c0", "c1", "case", "fxy", "g", "innerv", "jac", "k", "kind", "m", "uExpr", "uhi", "ulo", "v0hi", "v0lo", "v1hi", "v1lo", "vExpr", "val", "vhi", "vlo", "xuv", "yuv"], "nvariants": 50}