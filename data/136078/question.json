{"id": "136078", "name": "מטריצת פעולה אלמנטרית", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randToHead", "params": ["list"], "body": "block([x],x: rand(list),list: delete(x,list),cons(x,list))"}, {"name": "permuteList", "params": ["list"], "body": "block([newlist],newlist: [],for i:1 unless (list = []) do(list: randToHead(list),push(pop(list),newlist)),newlist)"}, {"name": "nChooseK", "params": ["dm", "rank"], "body": "block([cols],cols: makelist(i,i,dm),rest(permuteList(cols),-(dm-rank)))"}, {"name": "switchRowsMatrix", "params": ["height", "r1", "r2"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1]: ident(height)[r2],tempMat[r2]: ident(height)[r1],tempMat)"}, {"name": "rowMultMatrix", "params": ["height", "r", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r]: alpha*tempMat[r],tempMat)"}, {"name": "rowAddMatrix", "params": ["height", "r1", "r2", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1][r2]: alpha,tempMat)"}, {"name": "isElementary", "params": ["M"], "body": "block([nzOffDg,ans],nzOffDg: findNonzeroOffDiag(M),option: length(nzOffDg),if (option = 0) then isScalarMult(M) elseif (option = 1) then is(M = setelmx(M[nzOffDg[1][1],nzOffDg[1][2]],nzOffDg[1][1],nzOffDg[1][2],ident(length(M)))) elseif (option = 2) then is(M=switchRowsMatrix(length(M),nzOffDg[1][1],nzOffDg[1][2])) else false)"}, {"name": "findNonzeroOffDiag", "params": ["M"], "body": "block([coordlist],coordlist:[],for i:1 thru length(M) do(for j:1 thru length(M) do(coordlist: if (i=j or M[i][j]=0) then coordlist else cons([i,j],coordlist))),coordlist)"}, {"name": "isScalarMult", "params": ["M"], "body": "block([ans,foundScalar],ans: true,foundScalar: false,for i:1 thru length(M) do(if ((not M[i][i] = 1) and (not foundScalar)) then foundScalar: true elseif ((not M[i][i] = 1) and foundScalar) then ans: false),ans)"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>הזינו מטריצה <span dir=\"ltr\">\\(E\\)</span> כך שבכפל משמאל במטריצה ריבועית בגודל <span dir=\"ltr\">\\(3\\times 3\\)</span>, היא מבצעת עליה את פעולת השורה הבאה:</p><p dir=\"ltr\" style=\"text-align:center\">\\(R_{{CT:0}} {{CT:1}} {{CT:2}}R_{{CT:3}} {{CT:4}} {{CT:5}}{{CT:6}}_{{CT:7}} \\)</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(E=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p></div></div>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "[[,]]", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "matrix([?,?,?],[?,?,?],[?,?,?])", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "isSquare: is(length(ans1) = dm and length(ans1[1]) = dm);\nisEl: if (isSquare) then isElementary(ans1) else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "isSquare", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">המטריצה שהזנת אינה ריבועית מסדר {{CT:8}}</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "isEl", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 2, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<div dir=\"rtl\">המטריצה שהזנת אינה אלמנטרית</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctAns", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-3-T", "feedback": "<div dir=\"rtl\">תשובתך נכונה</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<div dir=\"rtl\">המטריצה האלמנטרית שהזנת אינה מבצעת את הפעולה המבוקשת</div>"}}]}], "qvnames": ["add", "arrow", "correctAns", "dm", "firstrow", "firstscalar", "maybeplus", "mult", "oplist", "optype", "rows", "scalarAdd", "scalarMult", "secondR", "secondrow", "secondscalar", "switch"], "nvariants": 50}