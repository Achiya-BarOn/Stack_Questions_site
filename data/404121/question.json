{"id": "404121", "name": "m_tangent_line", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "l", "params": ["x"], "body": "m*x-1-log(m)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: center;\" dir=\"rtl\"><span style=\"font-size: medium;\"><img src=\"data/404121/files/1.jpeg\" alt=\"\" width=\"417\" height=\"244\" /></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">לפי משפט לגרנז׳ קיימת נקודה </span><span style=\"font-size: medium;\">\\(c \\in [{{CT:0}},{{CT:1}}]\\) </span><span style=\"font-size: medium;\">שעבורה מתקיימת המשוואה </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\frac{\\ln({{CT:1}})-\\ln({{CT:0}})}{{{CT:1}}-{{CT:0}}}=\\ln'(c)\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> <span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"> </span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">במקרה הזה נתון לנו שישנה בדיוק נקודה אחת כזו שנמשיך לסמן אותה <span><span><span> </span></span></span><span><span><span>\\(c\\)</span></span></span>. תהא </span></span></span><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">\\(L(x)\\) </span></span></span><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">משוואת הישר המשיק לגרף של הפונקציה </span></span></span><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">\\(f(x)=\\ln(x)\\) </span></span></span><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">מעל הנקודה </span></span></span><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">\\(c\\)</span></span></span><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">. חשבו את הערך </span></span></span><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"><span style=\"font-size: medium;\">\\(L(0) \\). </span></span></span></p>\n<p style=\"text-align: left;\" dir=\"ltr\">  </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>שימו לב: </strong>האיור למעלה ממחיש את המצב, אבל אינו תואם את נתוני השאלה הספיציפית שקיבלתם!<br /></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד.  </span><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(L(0)=\\) </span><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbacksty