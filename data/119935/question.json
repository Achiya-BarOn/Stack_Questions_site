{"id": "119935", "name": "נגזרת של aˣ·xᵃ – מכפלה עם מעריכית", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "pz", "params": ["x"], "body": "if numberp(x) then (if x<0 then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)) elseif atom(x) then tex1(x) elseif member(op(x),[\"+\",\"-\"]) or (op(x)=\"*\" and numberp(first(x)) and first(x)<0) then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "pz1", "params": ["x"], "body": "if not atom(x) and op(x)=\"+\" then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(append([pz1(first(args(e)))], map(pz, rest(args(e)))), \" \\\\cdot \")"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>מצאו את הנגזרת של הפונקציה</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\frac{d}{d{{CT:0}}}({{CT:1}}) = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> הפונקציה היא מכפלה של פונקציה מעריכית ושל חזקה, ולכן גוזרים לפי כלל המכפלה.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הגורמים ונגזרותיהם</b><br>נסמן <span dir=\"ltr\">\\(u(x)={{CT:2}}\\)</span> ו-<span dir=\"ltr\">\\(v(x)={{CT:3}}\\)</span>. הנגזרת של <span dir=\"ltr\">\\(a^x\\)</span> היא <span dir=\"ltr\">\\(a^x\\ln a\\)</span>, ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ u'(x)={{CT:4}},\\qquad v'(x)={{CT:5}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — כלל המכפלה</b><br><div style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;margin:12px 0\">כלל המכפלה: <span dir=\"ltr\">\\( \\frac{d}{dx}(uv)=u'v+uv' \\)</span></div><p dir=\"ltr\" style=\"text-align:center\">\\[ f'(x)=u'v+uv'={{CT:6}}+{{CT:7}} \\]</p>ולאחר פישוט:<p dir=\"ltr\" style=\"text-align:center\">\\[ f'(x)={{CT:8}} \\]</p></div></div>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Diff", "sans": "ans1", "tans": "diff(p,v)", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["p", "p1", "p2", "rdm1", "v"], "nvariants": 3}