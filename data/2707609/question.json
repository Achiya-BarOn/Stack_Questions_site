ect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "checkbox", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "mcq_correct(ta)", "tans": "ans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}], "qvnames": ["a", "b", "c", "d", "f", "fxy", "fy", "labalf", "labalt", "label", "messy_ode", "n", "ode", "pts", "ptsP", "ta", "taP", "tf", "x0val", "y0val"], "nvariants": 50}