{"id": "207818", "name": "linear_approximation", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f1", "params": ["x", "y", "z"], "body": "func1"}, {"name": "f2", "params": ["x", "y", "z"], "body": "func2"}, {"name": "F", "params": ["x", "y", "z"], "body": "matrix([f1(x,y,z)],[f2(x,y,z)])"}, {"name": "df", "params": ["x", "y", "z"], "body": "matrix([diff(f1(x,y,z),x), diff(f1(x,y,z),y), diff(f1(x,y,z),z)], [diff(f2(x,y,z),x), diff(f2(x,y,z),y), diff(f2(x,y,z),z)])"}], "questiontext": "<p style=\"text-align: right;\">&nbsp;</p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">נתונה הפונקציה</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"> \\(F:R^3 \\rightarrow R^2\\)</span>&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[F(x,y,z)={{CT:0}}\\]</span></p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתבונן בנקודות</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[p_0 = {{CT:1}}, p={{CT:2}} \\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">קל לחשב בעזרת מחשבון את ערך הפונקציה בנקודה&nbsp;</span><span style=\"font-size: medium;\">\\(F(p)\\).&nbsp;</span><span style=\"font-size: medium;\">בתרגיל הזה אתם מתבקשים להעריך את ערך הפונקציה בנקודה זו, ללא מחשבון. זאת על ידי כך שתחשבו את הערך של הפונקציה והנגזרות שלה בנקודה&nbsp;</span><span style=\"font-size: medium;\">\\( p_0\\) ואז תשתמשו בנוסחת הקירוב הלינארי:&nbsp;</span></p>\n<p style=\"text-align: left;\" dir=\"rtl\">&nbsp;</p>\n<p><span style=\"font-size: medium;\">\\(F(p) \\cong L(p) = L_{p_0}(p)=F(p_0)+DF(p-p_0)\\)</span></p>\n<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את הערך של הפונקציה בנקודת הבסיס&nbsp;</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(F(p_0)\\) =</span><span style=\"font-size: medium;\">&nbsp;[[input:ans1]] [[validation:ans1]]</span>&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">כעת תנו ביטוי מתמטי מדויק (לא בצורת שבר עשרוני) לקירוב הלינארי לפונקציה בנקודה&nbsp;</span><span style=\"font-size: medium;\">\\(p\\). מומלץ לבדוק בצד בעזרת מחשבון שהערך שאתם מקבלים אכן קרוב לערך של הפונקציה.</span></p>\n<p dir=\"rtl\">&nbsp;&nbsp;</p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">L(p) =&nbsp;</span><span style=\"font-size: medium;\">[[input:ans2]] [[validation:ans2]]</span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>", "generalfeedback": "", "specificfeedback": "<p dir=\"ltr\"><span style=\"font-size: medium;\">[[feedback:prt1]]</span></p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">[[feedback:prt2]]</span></p>", "prtcorrect": "<p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "[[BASIC-CALCULUS]]", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">החישוב שלכם לערך הפונקציה \\(F(p_0)\\) בנקודת הבסיס הוא נכון.&nbsp;&nbsp;</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "tans2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">החישוב שלכם לקירוב הלינארי הפונקציה \\(L(p)\\) הוא נכון. לפניכם הערך של הפוקנציה ושל הקירוב הלינארי בנקודה הזו, נתונים בצורה עשרונית. מעניין להשוות אותם.&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[L(p)={{CT:3}}={{CT:4}}, \\qquad F(p)={{CT:5}} \\]</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<p>&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\"><span>החישוב שלכם לקירוב הלינארי הפונקציה \\(\\ell(p)\\) הוא שגוי, נסו שוב.</span><br></span></p>"}}]}], "qvnames": ["a", "b", "c", "dis", "ds", "dt", "du", "dval", "exact", "func1", "func2", "la", "m", "n", "nans2", "p", "p0", "s", "t", "tans1", "tans2", "u", "val"], "nvariants": 50}