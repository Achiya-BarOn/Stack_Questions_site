{"id": "85798", "name": "נגזרת של e^(ax/π) (באנגלית)", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"ltr\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><p>Find the following derivative:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\frac{d}{d{{CT:0}}}({{CT:1}}) = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"ltr\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">The chain rule</b><br>The derivative of <span dir=\"ltr\">\\(e^u\\)</span> is <span dir=\"ltr\">\\(e^u\\)</span>. Here the exponent is <span dir=\"ltr\">\\(u={{CT:2}}\\)</span>, whose derivative is <span dir=\"ltr\">\\(u'={{CT:3}}\\)</span>, so by the chain rule<p dir=\"ltr\" style=\"text-align:center\">\\[ \\frac{d}{d{{CT:0}}}\\left({{CT:1}}\\right)={{CT:1}}\\cdot {{CT:3}}={{CT:4}} \\]</p></div></div>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<span class='correct'>Correct answer, well done.</span>", "prtpartiallycorrect": "<span class='partially'>Your answer is partially correct.</span>", "prtincorrect": "<span class='incorrect'>Incorrect answer.</span>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "diff", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Diff", "sans": "ans1", "tans": "diff(p,v)", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "diff(p,v)/rdm1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-T ", "feedback": "<div dir=\"ltr\">The derivative of \\(e^{mx}\\) is \\(me^{mx}\\); you appear to have forgotten the factor m, in this case {{CT:5}}.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "Result-1-F ", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "-diff(p,v)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-2-T ", "feedback": "<div dir=\"ltr\">The derivative of \\(e^x\\) is \\(e^x\\); you appear to have used \\(-e^x\\) as the derivative.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 3, "answernote": "Result-2-F ", "feedback": ""}}, {"name": 3, "answertest": "AlgEquiv", "sans": "ans1", "tans": "rdm1*exp(v)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-3-T ", "feedback": "<div dir=\"ltr\">The derivative of \\(e^{mx}\\) is \\(me^{mx}\\) not \\(me^x\\).</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-3-F ", "feedback": ""}}]}], "qvnames": ["p", "rdm1", "v"], "nvariants": 6}