{"id": "263263", "name": "vectors - 5", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossproduct", "params": ["o", "t"], "body": "block(matrix((o[2]*t[3]-o[3]*t[2]),(o[3]*t[1]-o[1]*t[3]), (o[1]*t[2]-o[2]*t[1])))"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "L1", "params": ["t"], "body": "simplify(u + (t+a1)*v + (t+b1)*w)"}, {"name": "L2", "params": ["t"], "body": "simplify(u+ (t+a2)*v + (t+b2)*w + t*n)"}, {"name": "L3", "params": ["t"], "body": "simplify(u+ u0 + (t+a3)*v + (t+b3)*w)"}, {"name": "f", "params": ["x", "t"], "body": "if (x=0) then L1(t) else if (x=1) then L2(t) else  L3(t)"}], "questiontext": "<p style=\"margin-left: 30px; text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"margin-left: 30px; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בואו נתנסה בשאלה קצת יותר אתגרית. עליכם להבין את הגיאומטריה של השאלה ואז למצוא בעצמכם דרך לחשב בעזרת כל המושגים שלמדנו את הגדלים הנדרשים. במידה ואתם צריכים לחשב מכפלות וקטוריות, סקלריות, נורמות של וקטורים, הטלות וכד׳ מומלץ לא לעשות זאת ביד אלא להשתמש במחשבון. ישנם הרבה מחשבונים כאילו זמינים באינטרנט נסו למשל את זה: </span></p>\n<p style=\"margin-left: 30px; text-align: left;\" dir=\"ltr\"><a title=\"סימבולאב\" href=\"https://he.symbolab.com/\" target=\"_blank\"><span style=\"font-size: medium;\">https://he.symbolab.com/</span></a></p>\n<p style=\"margin-left: 30px; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתון מישור בהצגה פרמטרית</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">\\[ U + a V + b W  \\  (a,b\\in\\mathbb{R})\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">כאשר</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">\\[ U = {{CT:0}}, V = {{CT:1}}, W = {{CT:2}}\\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">ונתונים שלושה ישרים בהצגה פרמטרית</span></p>\n<p style=\"text-align: right;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[ L_1 = {{CT:3}} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[ L_2 = {{CT:4}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[ L_3 = {{CT:5}}\\] </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>1.</strong> כתבו את מספרו של הישר (הזינו ספרה בלבד 1,2 או 3) בעל התכונות הבאות:</span></p>\n<p style=\"margin-left: 60px; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">    נמצא על המישור [[input:ans1]] [[validation:ans1]][[feedback:prt1]]</span></p>\n<p style=\"margin-left: 60px; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">    חותך את המישור בנקודה [[input:ans2]] [[validation:ans2]][[feedback:prt2]]</span></p>\n<p style=\"margin-left: 60px; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">    מקביל למישור [[input:ans3]] [[validation:ans3]][[feedback:prt3]]</span></p>\n<p style=\"margin-left: 60px; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בשאלות הבאות כתבו את התשובה בדיוק של 2 מקומות אחרי הנקודה:</span></p>\n<p style=\"margin-left: 60px; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>2.</strong> מהו סינוס הזוית בין הישר החותך את המישור לבין המישור?</span></p>\n<p style=\"margin-left: 60px; text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"margin-left: 60px; text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"> [[input:ans4]] [[validation:ans4]][[feedback:prt4]]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>3.</strong> מהו המרחק בין הישר המקביל למישור לבין המישור?</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"> [[input:ans5]] [[validation:ans5]][[feedback:prt5]]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>4.</strong> מהו המרחק בין הישר המקביל למישור לבין הישר שנמצא על המישור?</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"> [[input:ans6]] [[validation:ans6]][[feedback:prt6]]</span></p>", "generalfeedback": "", "specificfeedback": "", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": false, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans5", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": false, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans6", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": false, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value"