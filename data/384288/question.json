{"id": "384288", "name": "lim_at_infty", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f", "params": ["n"], "body": "[ln(c*n),ln(n^b),(ln(n))^b,c*n^b,a*b^n,a*n!,a*n^n]"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נניח כי </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(\\{a_n\\},\\{b_n\\}\\)</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">שתי סדרות. נסמן </span><span style=\"font-size: medium;\">\\(a \\ll b\\) </span><span style=\"font-size: medium;\">אם </span><span style=\"font-size: medium;\">\\(\\lim_{n \\rightarrow \\infty} \\frac{a_n}{b_n} = 0\\). </span><span style=\"font-size: medium;\">המטרה שלכם היא לסדר את שלושת הסדרות המופיעות למטה. למשל אם אתם חושבים ש-</span><span style=\"font-size: medium;\">\\(b_n \\ll a_n \\ll c_n\\) </span><span style=\"font-size: medium;\">כלומר ש</span> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(\\lim_{n \\rightarrow \\infty} \\frac{b_n}{a_n}=\\lim_{n \\rightarrow \\infty} \\frac{a_n}{c_n} = 0 \\)</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בחרו את האופציה </span><span style=\"font-size: medium;\">\\([b,a,c]\\).</span></p>\n<p dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>בנושא הניקוד:</strong> האופציה הנכונה תקנה את מלא הנקודות. בחירת הסדר ההפוך לגמרי לא תקנה אף נקודה. כל בחירה אחרת, כלומר כל מצב שבו לפחות שתיים מן הסדרות מסודרות בסדר הנכון, תקנה 20% מן הנקודות עבור השאלה. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 20% מהניקוד.  </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. </span></p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[a_n={{CT:0}}, \\ b_n={{CT:1}}, \\ c_n={{CT:2}}\\]</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "6", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0.2, "nextnode": -1, "answernote": "prt1-2-F", "feedback": ""}}]}], "qvnames": ["I", "LT", "N", "P", "Per", "a", "b", "c", "l", "n1", "n2", "n3", "ta_multiple", "ta_multiple_correct"], "nvariants": 50}