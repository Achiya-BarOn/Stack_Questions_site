{"id": "3327527", "name": "אינטגרל כפול בקואורדינטות קוטביות – תחום מורכב, כמה מקרים", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 2, "questiontext": "<div title=\"BGU_STACK_Q8_CLEAR_POLAR_V1\" dir=\"rtl\" style=\"width:100%;font-family:Arial,Helvetica,sans-serif;color:#1f2937;line-height:1.65;text-align:right;\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:16px 18px;margin-bottom:14px;\"><div style=\"font-size:20px;font-weight:bold;color:#4B1F6F;\">קואורדינטות קוטביות – תחום מורכב</div></div><div style=\"background:#fff;border:1px solid #D9D1DD;border-radius:12px;padding:16px 18px;margin-bottom:14px;\">\n          <div>יהי <span dir=\"ltr\">\\(\\displaystyle D\\)</span> התחום הבא</div>\n\n          [[if test=\"{{CT:7}}\"]]\n          <div dir=\"ltr\" style=\"text-align:center;font-size:18px;margin:8px 0;\">\n            \\(\\displaystyle {{CT:0}}\\le x^2+y^2\\le{{CT:1}},\\qquad {{CT:2}}\\le y\\le{{CT:3}}\\)\n          </div>\n          [[/if]]\n\n          [[if test=\"{{CT:8}}\"]]\n          <div dir=\"ltr\" style=\"text-align:center;font-size:18px;margin:8px 0;\">\n            \\(\\displaystyle {{CT:4}}\\le x^2+y^2\\le{{CT:5}},\\qquad {{CT:2}}\\le y\\le{{CT:3}}\\)\n          </div>\n          [[/if]]\n\n          [[if test=\"{{CT:9}}\"]]\n          <div dir=\"ltr\" style=\"text-align:center;font-size:18px;margin:8px 0;\">\n            \\(\\displaystyle {{CT:0}}\\le x^2+y^2\\le{{CT:5}},\\qquad {{CT:2}}\\le y\\le{{CT:3}}\\)\n          </div>\n          [[/if]]\n\n          <div>חשבו את האינטגרל</div>\n          <div dir=\"ltr\" style=\"text-align:center;font-size:19px;margin:8px 0;\">\n            \\(\\displaystyle I=\\iint_D {{CT:6}}\\,dx\\,dy\\)\n          </div>\n\n          <div style=\"margin-top:8px;\">\n            השתמשו בקואורדינטות קוטביות\n          </div>\n          <div dir=\"ltr\" style=\"text-align:center;font-size:17px;margin:8px 0;\">\n            \\(\\displaystyle x=r\\cos\\theta,\\qquad y=r\\sin\\theta,\\qquad J=r\\)\n          </div>\n        </div><div style=\"background:#fff;border:1px solid #D9D1DD;border-radius:12px;padding:16px 18px;margin-bottom:14px;\">\n          <div style=\"font-weight:bold;color:#4B1F6F;margin-bottom:10px;\">א. גבולות האינטגרציה</div>\n\n          <div>\n            כתבו את האינטגרל לאחר ההחלפה בצורה\n          </div>\n\n          <div dir=\"ltr\" style=\"text-align:center;font-size:18px;margin:8px 0 12px 0;\">\n            \\(\\displaystyle\n            I=\n            \\int_a^b\n            \\int_{c(\\theta)}^{d(\\theta)}\n            G(r,\\theta)\\,dr\\,d\\theta\n            \\)\n          </div>\n\n          <div style=\"display:grid;grid-template-columns:repeat(2,minmax(210px,330px));gap:11px;justify-content:center;align-items:start;\">\n       <div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle a=\\)</span>[[input:ans1]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans1]]</div>\n     </div><div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle b=\\)</span>[[input:ans2]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans2]]</div>\n     </div><div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle c(\\theta)=\\)</span>[[input:ans3]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans3]]</div>\n     </div><div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle d(\\theta)=\\)</span>[[input:ans4]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans4]]</div>\n     </div>\n     </div>\n        </div><div style=\"background:#fff;border:1px solid #D9D1DD;border-radius:12px;padding:16px 18px;margin-bottom:14px;\">\n          <div style=\"font-weight:bold;color:#4B1F6F;margin-bottom:10px;\">ב. ההצבה הקוטבית</div>\n\n          <div style=\"margin-bottom:10px;\">\n            כתבו את <span dir=\"ltr\">\\(x\\)</span> ואת <span dir=\"ltr\">\\(y\\)</span>\n            במונחי <span dir=\"ltr\">\\(r,\\theta\\)</span>.\n          </div>\n\n          <div style=\"display:grid;grid-template-columns:repeat(2,minmax(240px,390px));gap:12px;justify-content:center;align-items:start;\">\n       <div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle x(r,\\theta)=\\)</span>[[input:ans5]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans5]]</div>\n     </div><div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle y(r,\\theta)=\\)</span>[[input:ans6]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans6]]</div>\n     </div>\n     </div>\n        </div><div style=\"background:#fff;border:1px solid #D9D1DD;border-radius:12px;padding:16px 18px;margin-bottom:14px;\">\n          <div style=\"font-weight:bold;color:#4B1F6F;margin-bottom:10px;\">ג. האינטגרנד החדש והתוצאה</div>\n\n          <div style=\"margin-bottom:10px;\">\n            כאן <span dir=\"ltr\">\\(G(r,\\theta)\\)</span> הוא האינטגרנד לאחר ההצבה,\n            <b>כולל</b> היעקוביאן <span dir=\"ltr\">\\(J=r\\)</span>.\n          </div>\n\n          <div style=\"display:grid;grid-template-columns:repeat(2,minmax(240px,390px));gap:12px;justify-content:center;align-items:start;\">\n       <div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle G(r,\\theta)=\\)</span>[[input:ans7]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans7]]</div>\n     </div><div style=\"background:#F8F7F9;border:1px solid #E4DEE7;border-radius:10px;padding:11px 13px;\">\n       <div dir=\"ltr\" style=\"display:flex;justify-content:center;align-items:center;gap:8px;white-space:nowrap;\">\n         <span>\\(\\displaystyle I=\\)</span>[[input:ans8]]\n       </div>\n       <div style=\"text-align:center;font-size:12px;color:#665f6b;margin-top:5px;\">[[validation:ans8]]</div>\n     </div>\n     </div>\n        </div></div>", "generalfeedback": "<div title=\"BGU_STACK_Q8_CLEAR_POLAR_V1\" dir=\"rtl\" style=\"width:100%;font-family:Arial,Helvetica,sans-serif;color:#1f2937;line-height:1.65;text-align:right;\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:16px 18px;margin-bottom:14px;\"><div style=\"font-size:20px;font-weight:bold;color:#4B1F6F;\">פתרון מלא</div></div><div style=\"background:#fff;border:1px solid #D9D1DD;border-radius:12px;padding:16px 18px;margin-bottom:14px;\">\n          <p>בקואורדינטות קוטביות</p>\n          <div dir=\"ltr\" style=\"text-align:center;font-size:17px;\">\n            \\(\\displaystyle\n            x={{CT:10}},\\qquad\n            y={{CT:11}},\\qquad\n            J=r\n            \\)\n          </div>\n\n          <p>גבולות האינטגרציה הם</p>\n          <div dir=\"ltr\" style=\"text-align:center;font-size:17px;\">\n            \\(\\displaystyle\n            {{CT:12}}\\le\\theta\\le{{CT:13}},\\qquad\n            {{CT:14}}\\le r\\le{{CT:15}}\n            \\)\n          </div>\n\n          <p>לאחר ההצבה, כולל היעקוביאן, מתקבל</p>\n          <div dir=\"ltr\" style=\"text-align:center;font-size:17px;\">\n            \\(\\displaystyle G(r,\\theta)={{CT:16}}\\)\n          </div>\n\n          <div dir=\"ltr\" style=\"text-align:center;font-size:17px;margin-top:10px;\">\n            \\(\\displaystyle\n            I=\n            \\int_{{{CT:12}}}^{{{CT:13}}}\n            \\int_{{{CT:14}}}^{{{CT:15}}}\n            {{CT:16}}\\,dr\\,d\\theta\n            ={{CT:17}}\n            \\)\n          </div>\n        </div></div>", "specificfeedback": "<div style=\"display: none;\">[[feedback:prt1]][[feedback:prt2]][[feedback:prt3]][[feedback:prt4]][[feedback:prt5]][[feedback:prt6]][[feedback:prt7]][[feedback:prt8]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">חלק מן התשובה נכון. בדקו את שאר הרכיבים.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה עדיין אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 8, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 8, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 16, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 16, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans5", "type": "algebraic", "boxsize": 18, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans6", "type": "algebraic", "boxsize": 18, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans7", "type": "algebraic", "boxsize": 24, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}, {"name": "ans8", "type": "algebraic", "boxsize": 18, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "th0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}, {"name": "prt2", "value": 