div>"}}]}, {"name": "prt6", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans6", "tans": "ypol", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(y(r,\\theta)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(y(r,\\theta)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt7", "value": 2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans7", "tans": "g", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(G(r,\\theta)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(G(r,\\theta)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt8", "value": 2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans8", "tans": "val", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(I\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳, <span dir=\"ltr\">\\(I\\)</span> — שגוי.</b></div>"}}]}], "qvnames": ["Gant", "R1", "R1sq", "R2", "R2sq", "a", "angpair", "b", "bestlength", "c0", "c1", "c2", "case", "dth", "fxy", "g", "innerR", "intc2", "intc4", "kind", "line0", "line1", "m0", "m1", "p", "rhi", "rlo", "shift1", "shift2", "th0", "th1", "trylength", "val", "val0", "val1", "val2", "xpol", "ypol"], "nvariants": 50}