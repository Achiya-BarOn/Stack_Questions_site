{"id": "1792281", "name": "גבול באמצעות רציפות הלוגריתם", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "num_factored", "params": ["x"], "body": "makepositive*(x-aa)*(x-bb)"}, {"name": "numa", "params": ["x"], "body": "ev(num_factored(x),expand)"}, {"name": "denom_factored", "params": ["x"], "body": "(x-bb)*(x-cc)"}, {"name": "denoma", "params": ["x"], "body": "ev(denom_factored(x),expand)"}, {"name": "ff", "params": ["x"], "body": "(numa(x))/(denoma(x))"}, {"name": "gg", "params": ["x"], "body": "log(ff(x))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width: none; width: 100%; box-sizing: border-box; margin: 0 auto; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q6_VISUAL_V7\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 18px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">גבול באמצעות רציפות הלוגריתם</div>\n</div>\n<div style=\"background: #FFFFFF; border: 1px solid #D9D1DD; border-radius: 12px; padding: 18px; margin-bottom: 16px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 12px;\">נתונה הפונקציה</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 19px; line-height: 1.9; overflow-x: visible;\">\\(\\displaystyle g\\left(x\\right)=\\ln\\left(\\frac{{{CT:0}}}{{{CT:1}}}\\right)\\)</div>\n</div>\n<div style=\"background: #FFFFFF; border: 1px solid #D9D1DD; border-radius: 12px; padding: 18px; margin-bottom: 16px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">חשבו את הגבול</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 20px; line-height: 2; overflow-x: visible;\">\\(\\displaystyle \\lim_{x\\to{{CT:2}}}g\\left(x\\right)=\\) [[input:ans1]]</div>\n<div style=\"border-top: 1px solid #EEECEF; margin-top: 12px; padding-top: 8px; text-align: center; color: #665f6b; font-size: 13px;\"><strong>בדיקת ההקלדה</strong><br>[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width: 980px; margin: 0 auto; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q6_CONTINUITY_V4_CASES_LIMITINLINE\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 18px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #FFFFFF; border: 1px solid #D9D1DD; border-radius: 12px; padding: 18px; margin-bottom: 16px;\">\n<p>תחילה מחשבים את הגבול של הביטוי שבתוך הלוגריתם.</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 1.9; overflow-x: auto;\">\\(\\displaystyle \\frac{{{CT:0}}}{{{CT:1}}}=\\frac{{{CT:3}}}{{{CT:4}}}\\)</div>\n<p>לאחר צמצום הגורם המשותף מתקבל</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 1.9; overflow-x: auto;\">\\(\\displaystyle \\lim_{x\\to{{CT:2}}}\\frac{{{CT:0}}}{{{CT:1}}}={{CT:5}}\\)</div>\n<p>הערך \\(\\displaystyle {{CT:5}}\\) חיובי, והלוגריתם רציף שם. לכן</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 1.9; overflow-x: auto;\">\\(\\displaystyle \\lim_{x\\to{{CT:2}}}g\\left(x\\right)=\\ln\\left({{CT:5}}\\right)={{CT:6}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctLimit", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["aa", "bb", "cc", "correctLimit", "extraCheck", "ffatb", "makepositive"], "nvariants": 50}