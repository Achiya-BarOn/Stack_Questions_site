{"id": "1827772", "name": "גבול חד-צדדי עם שורש וקוסינוס – (1−√cos(ax))/(1−cos√(bx))", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>חשבו את הגבול:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\lim_{x\\to0^+}\\frac{1-\\sqrt{\\cos\\left({{CT:0}}\\right)}}{1-\\cos\\left(\\sqrt{{{CT:1}}}\\right)} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> כופלים את המונה בצמוד, ומשווים את סדרי הגודל של המונה ושל המכנה.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — כפל בצמוד</b><br><p>נכפול את המונה בצמוד:</p><p dir=\"ltr\" style=\"text-align:center\">\\[ 1-\\sqrt{\\cos\\left({{CT:0}}\\right)}=\\frac{1-\\cos\\left({{CT:0}}\\right)}{1+\\sqrt{\\cos\\left({{CT:0}}\\right)}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — השוואת סדרי גודל</b><br><p>כעת נשתמש בגבול <span dir=\"ltr\">\\(\\frac{1-\\cos t}{t^2}\\to\\frac12\\)</span>. במונה מתקבל סדר <span dir=\"ltr\">\\(x^2\\)</span>, ואילו במכנה, מפני ש־<span dir=\"ltr\">\\(\\left(\\sqrt{{{CT:1}}}\\right)^2={{CT:1}}\\)</span>, מתקבל סדר <span dir=\"ltr\">\\(x\\)</span>. לכן המנה כולה שואפת לאפס:</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to0^+}\\frac{1-\\sqrt{\\cos\\left({{CT:0}}\\right)}}{1-\\cos\\left(\\sqrt{{{CT:1}}}\\right)}=0={{CT:2}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "limit", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: if is(limit=ans1) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["a", "b", "limit"], "nvariants": 45}