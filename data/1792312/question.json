{"id": "1792312", "name": "נגזרת – מכפלה של חזקה ופונקציה מעריכית aˣ", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "pz", "params": ["x"], "body": "if numberp(x) then (if x<0 then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)) elseif atom(x) then tex1(x) elseif member(op(x),[\"+\",\"-\"]) or (op(x)=\"*\" and numberp(first(x)) and first(x)<0) then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "pz1", "params": ["x"], "body": "if not atom(x) and op(x)=\"+\" then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(append([pz1(first(args(e)))], map(pz, rest(args(e)))), \" \\\\cdot \")"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">נגזרת – מכפלה של חזקה ופונקציה מעריכית</div><p>מצאו את הנגזרת של הפונקציה</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\displaystyle f\\left(x\\right)={{CT:0}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle f'\\left(x\\right)= \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> הפונקציה היא מכפלה של פונקציה מעריכית ושל חזקה, ולכן גוזרים לפי כלל המכפלה.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הגורמים ונגזרותיהם</b><br>נשתמש בכלל המכפלה. נסמן<p dir=\"ltr\" style=\"text-align:center\">\\[ u\\left(x\\right)={{CT:1}}\\;,\\;v\\left(x\\right)={{CT:2}} \\]</p>הנגזרת של <span dir=\"ltr\">\\(a^x\\)</span> היא <span dir=\"ltr\">\\(a^x\\ln a\\)</span>, ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ u'\\left(x\\right)=\\ln\\left({{CT:3}}\\right){{CT:1}}\\;,\\;v'\\left(x\\right)={{CT:4}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — כלל המכפלה</b><br><div style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;margin:12px 0\">כלל המכפלה: <span dir=\"ltr\">\\( \\frac{d}{dx}(uv)=u'v+uv' \\)</span></div>ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ f'\\left(x\\right)=u'v+uv'={{CT:5}}+{{CT:6}} \\]</p>ולאחר פישוט:<p dir=\"ltr\" style=\"text-align:center\">\\[ f'\\left(x\\right)={{CT:7}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 42, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 2, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "varss:listofvars(ans1);\nan1:ans1;\nfor i:1 while i<=length(varss) do an1:ev(an1,varss[i]=v);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Diff", "sans": "an1", "tans": "diff(p,v)", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["base", "c", "m", "p", "p1", "p2", "v"], "nvariants": 50}