{"id": "1806919", "name": "שימושי האינטגרל – נפח גוף סיבוב סביב ציר x", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "fout", "params": ["x"], "body": "co*x^(-p)"}, {"name": "fin", "params": ["x"], "body": "ci*x^(-q)"}, {"name": "Vant", "params": ["x"], "body": "co^2*x^(1-2*p)/(1-2*p)-ci^2*x^(1-2*q)/(1-2*q)"}], "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">נפח גוף סיבוב</div>\n<div>התחום שבין הגרפים</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 1.9; margin-top: 6px;\">\\(\\displaystyle y={{CT:0}}\\)<br>\\(\\displaystyle y={{CT:1}}\\)</div>\n<div>ומעל הקטע <span dir=\"ltr\">\\(\\displaystyle [{{CT:2}},{{CT:3}}]\\)</span> מסובב סביב ציר <span dir=\"ltr\">\\(\\displaystyle x\\)</span>.</div>\n<div dir=\"ltr\" style=\"text-align: center; margin-top: 12px;\">{{CT:4}}</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-bottom: 8px;\">כתבו תשובה מדויקת. את <span dir=\"ltr\">\\(\\displaystyle \\pi\\)</span> אפשר לכתוב כ־<strong>pi</strong>.</div>\n<div dir=\"ltr\" style=\"text-align: center;\">[[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>לכל <span dir=\"ltr\">\\(\\displaystyle x\\ge1\\)</span> מתקיים <span dir=\"ltr\">\\(\\displaystyle {{CT:5}}&gt;{{CT:6}}\\)</span> וגם <span dir=\"ltr\">\\(\\displaystyle {{CT:7}}&gt;{{CT:8}}\\)</span>, ולכן הגרף החיצוני הוא <span dir=\"ltr\">\\(\\displaystyle y={{CT:0}}\\)</span> והגרף הפנימי הוא <span dir=\"ltr\">\\(\\displaystyle y={{CT:1}}\\)</span>.</p>\n<p>בשיטת הטבעות</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle V=\\pi\\int_{{{CT:2}}}^{{{CT:3}}}\\left[\\left({{CT:0}}\\right)^2-\\left({{CT:1}}\\right)^2\\right]dx\\)</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle =\\pi\\int_{{{CT:2}}}^{{{CT:3}}}\\left({{CT:5}}^2x^{-2\\cdot{{CT:8}}}-{{CT:6}}^2x^{-2\\cdot{{CT:7}}}\\right)dx\\)</div>\n<p>פונקציה קדומה של הביטוי שבסוגריים היא</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle {{CT:9}}\\)</div>\n<p>ולכן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px; font-weight: bold;\">\\(\\displaystyle V={{CT:10}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 26, "insertstars": 5, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "למשל: 7*pi/12", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "volume", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["aa", "bb", "ci", "co", "p", "q", "volume", "xDomain", "yDomain"], "nvariants": 50}