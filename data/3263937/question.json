 "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans8", "type": "numerical", "boxsize": 5, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans9", "type": "numerical", "boxsize": 4, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 0.2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "p1parallel:\nif is(ans3=0)\nthen false\nelse is(ans1=ans3*n1a) and is(ans2=ans3*n1b);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "p1parallel", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — שגוי.</b> וקטור הנורמל של המישור אינו בכיוון הנכון. בדקו מחדש שני וקטורי כיוון במישור ואת המכפלה הווקטורית שלהם.</div>"}}]}, {"name": "prt2", "value": 0.1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "p1same:\nif is(ans3=0)\nthen false\nelse is(ans1=ans3*n1a) and is(ans2=ans3*n1b) and is(ans4=ans3*d1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "p1same", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt2-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt2-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — שגוי.</b> כדי לקבל את מלוא הניקוד על המישור, ודאו שלא