ון במישור ואת המכפלה הווקטורית שלהם.</div>"}}]}, {"name": "prt2", "value": 0.1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "p1same:\nif is(ans3=0)\nthen false\nelse is(ans1=ans3*n1a) and is(ans2=ans3*n1b) and is(ans4=ans3*d1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "p1same", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt2-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt2-F", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">כדי לקבל את מלוא הניקוד על המישור, ודאו שלא רק וקטור הנורמל נכון, אלא גם שהמישור עובר דרך הנקודות הנתונות. בדקו את האיבר החופשי.</div>"}}]}, {"name": "prt3", "value": 0.2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "p2parallel:\nif is(ans6=0)\nthen false\nelse is(ans5=-ans6*n2a) and is(ans7=0);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "p2parallel", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt3-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt3-F", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">וקטור הנורמל של המישור השני אינו בכיוון הנכון. בדקו מחדש שני וקטורי כיוון במישור ואת המכפלה הווקטורית שלהם.</div>"}}]}, {"name": "prt4", "value": 0.1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "p2same:\nif is(ans6=0)\nthen false\nelse is(ans5=-ans6*n2a) and is(ans7=0) and is(ans8=-ans6*d2);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "p2same", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt4-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt4-F", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">כדי לקבל את מלוא הניקוד על המישור השני, ודאו שהמשוואה שקיבלתם אכן עוברת דרך \\(A,D,E\\), ובפרט בדקו את האיבר החופשי.</div>"}}]}, {"name": "prt5", "value": 0.2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "dir_ok:\nif is(ans12=0)\nthen false\nelse is(ans13=ans12*ly) and is(ans14=ans12*lz);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "dir_ok", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt5-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt5-F", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">וקטור הכיוון של הישר אינו נכון. זכרו שווקטור כיוון של ישר החיתוך חייב להיות מאונך לשני וקטורי הנורמל של המישורים.</div>"}}]}, {"name": "prt6", "value": 0.15, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "point_ok:\nis(ans10-Ay=(ans9-Ax)*ly) and\nis(ans11-Az=(ans9-Ax)*lz);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "point_ok", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt6-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt6-F", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">הנקודה שבחרתם אינה נמצאת על ישר החיתוך. בדקו שהנקודה מקיימת את שתי משוואות המישורים שמצאתם.</div>"}}]}, {"name": "prt7", "value": 0.05, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "dir_ok:\nif is(ans12=0)\nthen false\nelse is(ans13=ans12*ly) and is(ans14=ans12*lz);\n\npoint_ok:\nis(ans10-Ay=(ans9-Ax)*ly) and\nis(ans11-Az=(ans9-Ax)*lz);\n\nline_ok:dir_ok and point_ok;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "line_ok", "tans": "true", "te