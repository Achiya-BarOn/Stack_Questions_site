{"id": "307936", "name": "שאיפה במ״ש.", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "y", "params": ["t"], "body": "exp(t)*C.transpose([1,t,t^2,t^3,t^4])"}], "questiontext": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">שאלה אמריקאית (16 נק׳, 8 על כל סעיף) נסמן </span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[P_n(t) = (t-1)^n = t^n-\\begin{pmatrix}n\\\\n-1 \\end{pmatrix}t^{n-1} + \\begin{pmatrix} n \\\\ n-2 \\end{pmatrix} t^{n-2} - \\ldots + (-1)^{n} \\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">ונניח שהפונקציה </span><span style=\"font-size: medium;\"> </span><span style=\"font-size: medium;\">\\(x_n(t)\\) </span><span style=\"font-size: medium;\">היא הפתרון למשוואה ההתחלה הבאה: </span></p>\n<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[P_n(D)x=x^{(n)}-\\begin{pmatrix}n\\\\n-1 \\end{pmatrix}x^{(n-1)} + \\begin{pmatrix} n \\\\ n-2 \\end{pmatrix} x^{(n-2)} - \\ldots + (-1)^{n} x = 0 \\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"> <span style=\"font-size: medium;\">\\[x(0)={{CT:0}}, x'(0)={{CT:1}}, x''(0)= {{CT:2}}, x^{(3)}(0)=x^{(4)}(0) = \\ldots =x^{(n-1)}(0) = 0\\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתון שהפונקציות הללו מתכנסות בהחלט ובמ״ש על כל קטע סגור וחסום לפולינום ריבועי בעל מקדמים שלמים אי שליליים: </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\lim_{n \\rightarrow \\infty} x_n(t) = at^2+bt+c\\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">א. (8 נק׳) חשבו את הערך של הפונקציה (זהירות סמנו רק תשובה אחת בלבד):</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(x_{5}(1) = \\)</span>  <span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>\n<p dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">ב. (8 נק׳) </span><span style=\"font-size: medium;\">מצאו את המקדמים של הפולינום הגבולי (עליכם להזין שלושה מספרים שלמים אי שליליים, אחד בכל משבצת. נקודות תתקבלנה רק אם מצאתם את כל המקדמים נכון):</span><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">a = [[input:ans2]] [[validation:ans2]]</span> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">b = [[input:ans3]] [[validation:ans3]]</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">c = [[input:ans4]] [[validation:ans4]]</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\" dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"ltr\"> </p>", "generalfeedback": "", "specificfeedback": "<p dir=\"ltr\">[[feedback:prt1]]</p>\n<p dir=\"ltr\">[[feedback:prt2]]</p>\n<p dir=\"ltr\"> </p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "checkbox", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "[1]", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good: is((ans2=a) and is(ans3=b) and is(ans4=c));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "good", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": ""}}]}], "qvnames": ["A", "B", "C", "IC", "MM", "a", "b", "c", "div1", "div2", "div3", "div4", "div5", "div6", "div7", "div8", "mm", "ta_multiple", "tans1", "toe"], "nvariants": 50}