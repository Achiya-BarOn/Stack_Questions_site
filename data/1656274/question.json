{"id": "1656274", "name": "חלק ממשי וחלק מדומה של מספר מרוכב", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randcomplex", "params": ["n"], "body": "block([re,im],re: rand_with_prohib(-n,n,[0]),im: rand_with_prohib(-n,n,[0]),re + im*%i)"}, {"name": "igcd2", "params": ["a", "b"], "body": "if b=0 then abs(a) else igcd2(b,mod(a,b))"}, {"name": "texp", "params": ["x"], "body": "if constantp(x) and freeof(%i,x) and is(x<0) then sconcat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(map(texp, args(e)), \" \\\\cdot \")"}, {"name": "texnsum", "params": ["e"], "body": "block([L:first(args(e))], sconcat(tex1(first(L)), apply(sconcat, map(lambda([t], if constantp(t) and is(t<0) then sconcat(\"-\",tex1(-t)) else sconcat(\"+\",tex1(t))), rest(L)))))"}, {"name": "texpar", "params": ["e"], "body": "texp(first(args(e)))"}, {"name": "texsq", "params": ["e"], "body": "sconcat(texp(first(args(e))), \"^2\")"}, {"name": "rsq", "params": ["x"], "body": "block([s,t,nn,dd,aa:1,mm:1,g,u], if ratnump(x) then return(tex1(x)), s: if is(x<0) then \"-\" else \"\", t: ratsimp(x^2), nn: num(t), dd: denom(t), for f in ifactors(nn*dd) do (aa: aa*f[1]^floor(f[2]/2), mm: mm*f[1]^mod(f[2],2)), g: igcd2(aa,dd), aa: aa/g, dd: dd/g, u: sconcat(if aa=1 then \"\" else string(aa), \"\\\\sqrt{\", string(mm), \"}\"), if dd=1 then sconcat(s,u) else sconcat(s,\"\\\\frac{\",u,\"}{\",string(dd),\"}\"))"}, {"name": "texrs", "params": ["e"], "body": "rsq(first(args(e)))"}, {"name": "cxq", "params": ["p", "q"], "body": "block([r1:\"\", i1:\"\"], if p#0 then r1: rsq(p), if q#0 then (i1: if is(abs(q)=1) then \"\\\\mathrm{i}\" else sconcat(rsq(abs(q)), \"\\\\mathrm{i}\"), i1: if is(q<0) then sconcat(\"-\",i1) else if p#0 then sconcat(\"+\",i1) else i1), if p=0 and q=0 then \"0\" else sconcat(r1,i1))"}, {"name": "texcx", "params": ["e"], "body": "apply(cxq, args(e))"}, {"name": "ugly", "params": ["x"], "body": "integerp(ssearch(\"^(\", string(x)))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתון המספר המרוכב:</p><p dir=\"ltr\" style=\"text-align:center\">\\[ z = {{CT:0}} \\]</p></div><p>חשבו את החלק הממשי והחלק המדומה שלו.</p><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">א׳</span></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\text{Re}(z)=\\)[[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ב׳</span></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\text{Im}(z)=\\)[[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans2]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">החלק הממשי והחלק המדומה</b><br>מספר מרוכב כתוב בצורה <span dir=\"ltr\">\\(z=x+y\\mathrm{i}\\)</span>, כאשר <span dir=\"ltr\">\\(x\\)</span> ו-<span dir=\"ltr\">\\(y\\)</span> ממשיים. החלק הממשי הוא <span dir=\"ltr\">\\(\\text{Re}(z)=x\\)</span>, והחלק המדומה הוא המקדם של <span dir=\"ltr\">\\(\\mathrm{i}\\)</span>, <span dir=\"ltr\">\\(\\text{Im}(z)=y\\)</span>: זהו מספר ממשי, בלי <span dir=\"ltr\">\\(\\mathrm{i}\\)</span>. כאן <span dir=\"ltr\">\\(z={{CT:1}}\\)</span>, ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ \\text{Re}(z)={{CT:2}},\\qquad \\text{Im}(z)={{CT:3}} \\]</p></div></div>", "specificfeedback": "[[feedback:prt1]][[feedback:prt2]]", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "z,w", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "realpart(zz)", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ —</b> תשובה נכונה.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ —</b> תשובה שגויה.</div>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "