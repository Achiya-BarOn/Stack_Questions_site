wernote": "pgy-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — שגוי.</b> הפעילו את כלל השרשרת על שתי ההרכבות וקבלו מערכת בשני רכיבי הגרדיאנט.</div>"}}]}], "qvnames": ["A", "B", "C", "D", "G", "H", "P", "Ptuple", "cfg", "configs", "du", "fam", "gx", "gy", "points", "r", "s", "tans1", "tans2", "tans3", "ua", "ub", "unorm", "uraw", "usq", "x0", "x1", "x2", "y0", "y1", "y2"], "nvariants": 50}