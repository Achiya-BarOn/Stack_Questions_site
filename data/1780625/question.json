n", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: is(equal([ansa,ansb,ansc],[tansa,tansb,tansc]));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "correct", "tans": "true", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — שגוי.</b></div>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: is(equal(tanseigset,anseigset));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "correct", "tans": "true", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳ — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳ — שגוי.</b></div>"}}]}, {"name": "prt3", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "if is(equal(anseignum,1)) then (valssd:[anslambda1],vecssd:[[ansv1,ansv2]]);\nif is(equal(anseignum,2)) then (valssd:[anslambda1,anslambda2],vecssd:[[ansv1,ansv2],[answ1,answ2]]);\nif is(equal(anseignum,3)) then (valssd:[anslambda1,anslambda2V2, anslambda3],vecssd:[[ansv1,ansv2],[answ1V2,answ2V2],[ansu1,ansu2]]);\n\nnotzero(vv):= not(zeromatrixp(vv));\nisValVecCorrect(val,vec):= zeromatrixp(A.vec-val*vec);\ncorrectEigValWithVecs(val,vecs):= (for vec in vecs do(if(not(isValVecCorrect(val,vec))) then return (false)),if (length(vecs)#length(args(nullspace(A-val*ident(3))))) then return(false)\n,true);\ncorrect:makelist(true,length(valssd));\nfor i:1 thru length(valssd) do (val:valssd[i], vecs:vecssd[i], vecs:sublist(vecs, notzero), if(not(correctEigValWithVecs(val,vecs))) then correct[i]:false);\n\n\nwrong:[];\nfor i:1 thru length(valssd) do (if not correct[i] then wrong:append(wrong,[i]));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "anseignum", "tans": "cardinality(tanseigset)", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt3-1-T", "feedback": "<div dir=\"rtl\">מספר הע\"ע השונים נכון.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt3-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳ — שגוי.</b> מספר הע\"ע השונים שגוי.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "setify(valssd)", "tans": "tanseigset", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 2, "answernote": "prt3-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt3-2-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳ — שגוי.</b> זה לא הערכים העצמיים הנכונים</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "wrong", "tans": "[]", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt3-3-T", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳ — נכון.</b> מצאתם את כל הע\"ע והו\"ע הנכונים</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt3-3-F", "feedback": "<div dir=\"rtl\"><b>סעיף ג׳ — שגוי.</b> טעיתם במציאת ע\"ע/ו\"ע מספר <span dir=\"ltr\">{@wrong@}</span></div>"}}]}, {"name": "prt4", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "diagonalizable", "tans": "dgzable", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt4-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ד׳ — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt4-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ד׳ — שגוי.</b></div>"}}]}], "qvnames": ["A", "D", "P", "bases", "charpol", "coineig", "coinjord", "diagonalizable", "eigval1", "eigval2", "eigval3", "eigvals", "howmanyEig", "howmanyEigVecs", "k", "matrixEntry", "n", "sols", "tansa", "tansb", "tansc", "tanseigset"], "nvariants": 50}