{"id": "210679", "name": "grad curl div", "defaultgrade": 0, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "grad", "params": ["qq"], "body": "matrix([diff(qq,x),diff(qq,y),diff(qq,z)])"}, {"name": "div", "params": ["UU"], "body": "diff(UU[1],x)+diff(UU[2],y) + diff(UU[3],z)"}, {"name": "curl", "params": ["UU"], "body": "matrix([diff(UU[3],y) - diff(UU[2],z), diff(UU[1],z) - diff(UU[3],x), diff(UU[2],x) - diff(UU[1],y)])"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתונים פונקציה ושדה וקטורי:&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"><span>\\[f(x,y,z)={{CT:0}}, \\quad U(x,y,z)= {{CT:1}}\\]</span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את הביטויים הבאים:</p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\text{grad}(f) =\\) [[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\text{curl}(U)=\\) [[input:ans2]] [[validation:ans2]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\text{div}(U)=\\) [[input:ans3]] [[validation:ans3]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\text{curl}(\\text{grad}(f))=\\)&nbsp; [[input:ans4]] [[validation:ans4]]</p>\n<p style=\"text-align: left;\" dir=\"ltr\">&nbsp;</p>", "generalfeedback": "", "specificfeedback": "<p><span style=\"font-size: medium;\">&nbsp;[[feedback:prt1]]</span></p>\n<p><span style=\"font-size: medium;\">[[feedback:prt2]]</span></p>\n<p><span style=\"font-size: medium;\">[[feedback:prt3]]</span></p>\n<p><span style=\"font-size: medium;\">[[feedback:prt4]]</span></p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "matrix", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans4", "type": "matrix", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good1:is(equal(trigrat((ans1)),trigrat(tans1)));\n", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "good1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">יפה, הגרדיינט חושב נכון.</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">הגרדיינט שחישבתם שגוי.&nbsp;</span></p>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good2:is(equal(trigrat((ans2)),trigrat(tans2)));\n", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "good2", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "הקרל נכון.<p dir=\"rtl\" style=\"text-align: right;\"></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><br class=\"Apple-interchange-newline\"><span>הקרל שחישבתם שגוי.&nbsp;</span></span></p>"}}]}, {"name": "prt3", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good3:is(equal(trigrat((ans3)),trigrat(tans3)));\n", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "good3", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt3-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">החישוב שלכם עבור הדיוורגנס נכון.&nbsp;</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt3-1-F", "feedback": "<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">החישוב שלכם עבור הדיוורגנס שגוי.&nbsp;</span></p>"}}]}, {"name": "prt4", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans4", "tans": "tans4", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt4-1-T", "feedback": "<p dir=\"rtl\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">החישוב שלכם עבור \\(curl(grad(f))\\) נכון. למעשה נקבל כאן את ווקטור האפס לכל פונקציה שהיא גזירה פעמיים ברציפות. שכן חישוב מראה כי:&nbsp;</span></p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">\\[curl(grad(f))=\\begin{pmatrix} \\frac{\\partial^2 f}{\\partial y \\partial z}-\\frac{\\partial^2 f}{\\partial z \\partial y} &amp; \\frac{\\partial^2 f}{\\partial z \\partial x} -\\frac{\\partial^2 f}{\\partial x \\partial z} &amp; \\frac{\\partial^2 f}{\\partial x \\partial y}-\\frac{\\partial^2 f}{\\partial y \\partial x} \\end{pmatrix} \\]</span></p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">ביטוי שמתאפס בזכות שוויון הנגזרות המעורבות, בתנאי שהפונקציה גזירה פעמיים ברציפות.&nbsp;</span></p>\n<p dir=\"ltr\">&nbsp;</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt4-1-F", "feedback": "<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">החישוב שלכם עבור \\(curl(grad(f))\\) שגוי. למעשה לכל פונקציה שהיא מתקיים&nbsp;</span></p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">\\[curl(grad(f))=\\begin{pmatrix} \\frac{\\partial^2 f}{\\partial y \\partial z}-\\frac{\\partial^2 f}{\\partial z \\partial y} &amp; \\frac{\\partial^2 f}{\\partial z \\partial x} -\\frac{\\partial^2 f}{\\partial x \\partial z} &amp; \\frac{\\partial^2 f}{\\partial x \\partial y}-\\frac{\\partial^2 f}{\\partial y \\partial x} \\end{pmatrix} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">ביטוי שמתאפס בזכות שוויון הנגזרות המעורבות, בתנאי שהפונקציה גזירה פעמיים ברציפות. לכן על סעיף זה התשובה הנכונה היא:&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">&nbsp;&nbsp;\\[curl(grad(f))=[0,0,0] \\]</span></p>"}}]}], "qvnames": ["Len", "U", "c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "f", "funcs", "tans1", "tans2", "tans3", "tans4"], "nvariants": 50}