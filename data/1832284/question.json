{"id": "1832284", "name": "גבול סדרה בעזרת מקלורן – n³(ln(1+a/n)−sin(b/n)−…)", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">גבול סדרה באמצעות פולינומי מקלורן</div><p>חשבו את הגבול באמצעות פיתוחי מקלורן מתאימים</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\displaystyle \\lim_{n\\to\\infty}{{CT:0}}=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> מפתחים לפי חזקות של <span dir=\"ltr\">\\(1/n\\)</span>; האיברים מסדר ראשון ושני מצטמצמים, ונשאר האיבר מסדר שלישי.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הפיתוחים לפי חזקות של 1/n</b><br>נסמן <span dir=\"ltr\">\\(\\displaystyle a={{CT:1}}\\)</span> ו־<span dir=\"ltr\">\\(\\displaystyle b={{CT:2}}\\)</span><br>כאשר <span dir=\"ltr\">\\(\\displaystyle n\\to\\infty\\)</span> נפתח לפי החזקות של <span dir=\"ltr\">\\(\\displaystyle 1/n\\)</span> <p dir=\"ltr\" style=\"text-align:center\">\\[ \\displaystyle \\ln\\left(1+\\frac{a}{n}\\right)=\\frac{a}{n}-\\frac{a^2}{2n^2}+\\frac{a^3}{3n^3}+O\\left(\\frac{1}{n^4}\\right) \\]</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\displaystyle \\sin\\left(\\frac{b}{n}\\right)=\\frac{b}{n}-\\frac{b^3}{6n^3}+O\\left(\\frac{1}{n^5}\\right) \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — צמצום</b><br>האיברים מסדר ראשון ושני מצטמצמים לפי המבנה של הביטוי, ולכן <p dir=\"ltr\" style=\"text-align:center\">\\[ \\displaystyle {{CT:0}}=\\frac{a^3}{3}+\\frac{b^3}{6}+O\\left(\\frac{1}{n}\\right) \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 3 — הגבול</b><br>מכאן <p dir=\"ltr\" style=\"text-align:center\">\\[ \\displaystyle \\lim_{n\\to\\infty}{{CT:0}}={{CT:3}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:prt1]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 22, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 2, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: if is(equal(radcan(ans1),radcan(limit))) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}], "qvnames": ["a", "b", "g", "limit"], "nvariants": 50}