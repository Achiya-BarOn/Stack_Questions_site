{"id": "384657", "name": "inverse", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">פונקציה </span><span style=\"font-size: medium;\">\\(f: R \\rightarrow R\\) נתונה </span><span style=\"font-size: medium;\">על ידי הנוסחה הבאה</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">  </p>\n<p class=\"p2\"><span style=\"font-size: medium;\">\\[f(x)= \\left\\{\\begin{array}{ll} a+x &amp; x &lt; 4 \\\\ {{CT:0}} &amp; x = 4 \\\\ c \\sqrt{x} &amp; x &gt;4 \\end{array} \\right. \\]</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\">  </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">כאשר </span><span style=\"font-size: medium;\">\\(a,c\\) </span><span style=\"font-size: medium;\">פרמטרים. </span><span style=\"font-size: medium;\">נתון לנו שהפונקציה הזו הפיכה (כלומר חד חד ערכית ועל). נסמן את הפונקציה ההפוכה לה ב-</span><span style=\"font-size: medium;\">\\(g=f^{-1}: R \\rightarrow R\\). </span><span style=\"font-size: medium;\">בהסתמך על כך חשבו את הערך של הפרמטרים a,c וענו על השאלות הבאות.</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד. </span> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. <br /></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">  </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את הערך </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\"> </span><span style=\"font-size: medium;\">\\(g({{CT:1}})\\) = </span><span style=\"font-size: medium;\">[[input:ans3]] [[validation:ans3]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans3", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 4, "nodes": [{"name": 4, "answertest": "AlgEquiv", "sans": "ans3", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-5-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 5, "answernote": "prt1-5-F", "feedback": ""}}, {"name": 5, "answertest": "AlgEquiv", "sans": "ans3", "tans": "7", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.15, "nextnode": -1, "answernote": "prt1-6-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-6-F", "feedback": ""}}]}], "qvnames": ["a", "b", "c", "d2", "d3", "d4", "d5", "d6", "dy", "ta_multiple3", "ta_multiple3_correct", "tans3", "y"], "nvariants": 50}