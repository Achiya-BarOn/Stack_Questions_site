{"id": "2791780", "name": "מערכת מד\"ר סדר ראשון 3X3 לא הומוגנית עם מטריצה לכסינה עע שונים", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "random_invertible_matrix", "params": ["n"], "body": "genmatrix (LowerWithDiag, n, n).transpose(genmatrix (LowerWithDiag, n, n))"}, {"name": "range", "params": ["k"], "body": "makelist(n,n,-k,k)"}], "questiontext": "<p></p>\n<p></p>\n<p dir=\"rtl\" style=\"direction: rtl;\">מצאו פתרון פרטי \\(y_p\\) למערכת \\(y'=Ay+b\\) עבור&nbsp;</p>\n<p style=\"direction: ltr; text-align: center;\">\\[ A={{CT:0}}\\]&nbsp;</p><p style=\"direction: ltr; text-align: center;\">\\[ b={{CT:1}}\\]&nbsp;<br></p>\n<p dir=\"rtl\">הערה: נתון בסיס \\[\\{y_1, y_2, y_3\\}\\] למערכת ההומוגנית.</p><p dir=\"rtl\" style=\"direction: ltr; text-align: center;\"><span style=\"font-size: 0.9375rem;\">\\(y_1 = {{CT:2}},\\quad&nbsp;y_2 = {{CT:3}},\\quad&nbsp;y_3 = {{CT:4}}\\)</span></p><p dir=\"rtl\" style=\"text-align: right; direction: rtl;\"><span style=\"font-size: 0.9375rem;\">הזינו פה את תשובתכם</span></p><p dir=\"rtl\" style=\"direction: ltr; text-align: center;\"></p>\n<p></p>\n<p style=\"direction: ltr; text-align: center;\">\\[y_p(x)\\]= [[input:ans1]] [[validation:ans1]]</p>\n<p></p>\n<p style=\"direction: ltr; text-align: center;\"><br></p><br>\n<p></p>\n<p></p>", "generalfeedback": "", "specificfeedback": "[[feedback:prt1]]", "prtcorrect": "Correct answer, well done.", "prtpartiallycorrect": "Your answer is partially correct.", "prtincorrect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 45, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: zeromatrixp(trigsimp(fullratsimp(radcan(diff(ans1,x)-A.ans1-b))));\n", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "זה אכן פתרון פרטי למערכת<p dir=\"rtl\" style=\"text-align: right;\"></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">זה אינו פתרון פרטי למערכת<br></p>"}}]}], "qvnames": ["A", "D", "LowerWithDiag", "P", "X", "a", "b", "bestlength", "bgen", "eigs", "n", "trylength", "u", "vars", "y", "yh", "yp", "ys"], "nvariants": 50}