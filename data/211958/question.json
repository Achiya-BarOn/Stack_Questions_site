{"id": "211958", "name": "type_two_2", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "grad", "params": ["qq"], "body": "matrix([diff(qq,x),diff(qq,y),diff(qq,z)])"}, {"name": "div", "params": ["UU"], "body": "diff(UU[1],x)+diff(UU[2],y) + diff(UU[3],z)"}, {"name": "curl", "params": ["UU"], "body": "matrix([diff(UU[3],y) - diff(UU[2],z), diff(UU[1],z) - diff(UU[3],x), diff(UU[2],x) - diff(UU[1],y)])"}, {"name": "f", "params": ["x", "y", "z"], "body": "a1*x^2+a2*y^2+a3*z^2"}, {"name": "U", "params": ["x", "y", "z"], "body": "[2*a1*x,2*a2*y,2*a3*z]"}, {"name": "x", "params": ["u", "v"], "body": "R*cos(u)"}, {"name": "y", "params": ["u", "v"], "body": "v"}, {"name": "z", "params": ["u", "v"], "body": "R*sin(u)"}, {"name": "X", "params": ["u", "v"], "body": "transpose([x(u,v),y(u,v),z(u,v)])"}, {"name": "Xu", "params": ["u", "v"], "body": "[diff(x(u,v),u), diff(y(u,v),u),diff(z(u,v),u)]"}, {"name": "Xv", "params": ["u", "v"], "body": "[diff(x(u,v),v), diff(y(u,v),v),diff(z(u,v),v)]"}, {"name": "W", "params": ["u", "v"], "body": "factor(-crossprod(Xu(u,v),Xv(u,v)))"}, {"name": "integ", "params": ["u", "v"], "body": "factor(U(x(u,v),y(u,v),z(u,v)).W(u,v))"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">הטמפרטורה במרחב מתוארת על ידי הפונקציה&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[f(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">השדה הווקטורי \\(U(x,y,z)\\) מתאר את זרימת החום במרחב. החום תמיד יזרום לכיוון ששם הטמפרטורה נמוכה ביותר. מכיוון ש \\(-\\nabla f = -\\operatorname{grad}(f)\\) תמיד מצביע לכיוון של ירידת הטמפרטורה התלולה ביותר זה אומר שמתקיימת המשוואה:&nbsp;&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y,z)=-\\alpha \\operatorname{grad}(f)(x,y,z) = -\\alpha \\nabla f (x,y,z) \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">כאן \\(\\alpha\\) קבוע שנקרא מקדם הולכת החום. במקרה שלנו ניקח&nbsp;<span>&nbsp;\\(\\alpha=1\\).&nbsp;</span></span><span style=\"font-size: medium;\">מצאו את זרימת החום החוצה מתוך חתיכת הגליל הבאה:&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[S=\\{(x,y,z) \\in R^3 \\ | \\ x^2+z^2={{CT:1}}^2, 0 \\le y \\le {{CT:2}} \\} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span style=\"font-size: 10px;\">&nbsp;</span></span></p>\n<p dir=\"ltr\" style=\"text-align: center;\">\\(\\iint\\limits_{S} U \\cdot N d\\sigma = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p dir=\"ltr\" style=\"direction: rtl;\">&nbsp;<span style=\"font-size: 0.9375rem;\">כאשר \\(\\sigma\\) אלמנט השטח לאורך המשטח.</span></p><p dir=\"ltr\" style=\"direction: rtl;\"><span style=\"font-size: 0.9375rem;\">הנה תיאור של המשטח עם שני נורמלים (בצבע שחור) בשתי נקודות על המשטח שמסביר את כיוון הנורמל:</span></p><p dir=\"ltr\" style=\"direction: rtl;\"><span style=\"font-size: 0.9375rem;\"><img src=\"data/211958/files/1.png\" alt=\"\" width=\"714\" height=\"400\" role=\"presentation\" class=\"img-fluid atto_image_button_text-bottom\"><br></span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good: is(ans1=tans1);\nalmost: is(ans1=-tans1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "good", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">יופי חישבתם את האינטגל נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\"></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "almost", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "זה החישוב שמתאים לנורמל בכיוון השני.<p dir=\"rtl\" style=\"text-align: right;\"></p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">האינטגרל שלכם שגוי.&nbsp;<br></p>"}}]}], "qvnames": ["R", "a1", "a2", "a3", "b", "tans1", "u0", "u1", "v0", "v1", "vec"], "nvariants": 50}