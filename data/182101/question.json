{"id": "182101", "name": "Series_2 (copy)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p><span style=\"font-size: medium;\">Using the Binomial series result, find the first four non zero terms in the Maclaurin series for</span></p>\n<p><span style=\"font-size: medium;\"> \\[\\sqrt{({{CT:0}}+{{CT:1}}x)}\\]</span></p>\n<p><span style=\"font-size: medium;\"> </span></p>\n<p><span style=\"font-size: medium;\">Answer: [[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "<p><span style=\"font-size: medium;\"> \\[\\sqrt{({{CT:0}}+{{CT:1}}x)}\\]can be written as\\[\\sqrt{{{CT:0}}} \\sqrt{(1+{{CT:2}})}.\\]As \\[ {(1+x)}^{1/2} = 1 +\\frac{1}{2} x + \\frac{(1/2)(1/2-1)}{2 !} x^2 +\\frac{(1/2)(1/2 -1)(1/2 - 2)}{3 ! } x^3 + \\ldots ,\\]</span></p>\n<p><span style=\"font-size: medium;\">\\[ {(1+ {{CT:3}} )}^{1/2} = 1 +\\frac{1}{2} {{CT:3}} + \\frac{(1/2)(1/2-1)}{2 !} ({{CT:3}} )^2 +\\frac{(1/2)(1/2 -1)(1/2 - 2)}{3 ! } ({{CT:3}} )^3 + \\ldots .\\]</span></p>\n<p><span style=\"font-size: medium;\">Hence</span></p>\n<p><span style=\"font-size: medium;\">\\[\\sqrt{({{CT:0}}+{{CT:1}}x)} = \\sqrt{{{CT:0}}} (1 + {{CT:4}} - {{CT:5}} + {{CT:6}} + \\ldots) \\]</span></p>\n<p><span style=\"font-size: medium;\">or\\[\\sqrt{({{CT:0}}+{{CT:1}}x)} = \\sqrt{{{CT:0}}} +\\sqrt{{{CT:7}}} x- \\sqrt{{{CT:8}}} x^2 + \\sqrt{{{CT:9}}} x^3 + \\ldots \\]</span></p>", "specificfeedback": "<p><span style=\"font-size: medium;\">[[feedback:Result]]</span></p>", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "diff,taylor,sum,solve", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctanswer", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "wronganswer1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-F", "feedback": ""}}]}], "qvnames": ["correctanswer", "f", "n1", "n2", "wronganswer1"], "nvariants": 50}