{"id": "138448", "name": "העתק מציאת תמונת הפונקציה - אקספוננט של פולינום", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "exp( aa*x^2 + bb*x + cc)"}], "questiontext": "<p>/*Determine the image set \\({\\rm im}(f)\\) of the function\\[ {{CT:0}}.\\] Give your answer as an inequality in \\(y\\), e.g. \\( y &lt;= \\alpha\\).*/</p>\n<p style=\"text-align: right;\" dir=\"rtl\">מהי תמונתה של הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:1}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כתבו את התשובה כאי שיוויונים במשתנה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[y\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדוגמת</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y&gt; \\alpha \\mbox{ and } y &lt;= \\beta. \\]</p>\n<p style=\"text-align: right;\" dir=\"ltr\">כדי לכתוב</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[e^{-\\frac{3}{5}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הקישו:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">%e^(-(3/5))</p>\n<p style=\"text-align: center;\">[[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">תמונתה של הפונקציה הריבועית</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:2}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {{CT:3}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">האקספוננט מקבל כקלט את כל הערכים הללו, ולכן התמונה של הפונקציה כולה היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {{CT:4}} \\]</p>", "specificfeedback": "<p style=\"text-align: center;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה, יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובה נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "solve", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ineqprepare(ans1)", "tans": "correctanswer", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<p> </p>\n<p style=\"direction: ltr; text-align: center;\"> </p>\n<p> </p>\n<p> </p>"}}]}], "qvnames": ["aa", "bb", "cc", "correctanswer", "correctanswerdisplay", "image_of_quad"], "nvariants": 50}