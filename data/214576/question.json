{"id": "214576", "name": "נכון/לא נכון: A∪B כאשר A⊂B", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>אם <span dir=\"ltr\">\\(A\\subset B\\)</span> אז <span dir=\"ltr\">\\(A \\cup B ={{CT:0}}\\)</span>.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> משתמשים בהגדרת האיחוד ובהכלה הנתונה.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — האיחוד כאשר A מוכלת ב-B</b><br>תמיד <span dir=\"ltr\">\\(B\\subset A\\cup B\\)</span>. בכיוון השני: איבר של <span dir=\"ltr\">\\(A\\cup B\\)</span> שייך ל-<span dir=\"ltr\">\\(A\\)</span> (ואז, מההכלה, גם ל-<span dir=\"ltr\">\\(B\\)</span>) או ל-<span dir=\"ltr\">\\(B\\)</span>. בשני המקרים הוא ב-<span dir=\"ltr\">\\(B\\)</span>. לכן<p dir=\"ltr\" style=\"text-align:center\">\\[ A\\subset B\\;\\Longrightarrow\\; A\\cup B=B \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — בדיקת הטענה</b><br>[[if test=\"{{CT:1}}\"]]הטענה <b>נכונה</b>.[[else]]האיחוד שווה ל-<span dir=\"ltr\">\\(B\\)</span>, ולא בהכרח ל-<span dir=\"ltr\">\\(A\\)</span>. דוגמה נגדית: <span dir=\"ltr\">\\(A=\\{1\\}\\)</span>, <span dir=\"ltr\">\\(B=\\{1,2\\}\\)</span>. אז <span dir=\"ltr\">\\(A\\cup B=\\{1,2\\}\\neq A\\)</span>. הטענה <b>אינה נכונה</b>.[[/if]]</div></div>", "specificfeedback": "[[feedback:prt1]]", "prtcorrect": "Correct answer, well done.", "prtpartiallycorrect": "Your answer is partially correct.", "prtincorrect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "boolean", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "ta", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}], "qvnames": ["s1", "ta", "tmp"], "nvariants": 2}