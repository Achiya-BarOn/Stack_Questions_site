: left;\">\\(b =\\) [[input:ans7]] [[validation:ans7]]</p><p dir=\"ltr\" style=\"text-align: left;\">\\(c =\\) [[input:ans8]] [[validation:ans8]]</p><br><p></p>", "generalfeedback": "", "specificfeedback": "<p>סעיף א': [[feedback:prt1]]</p><p>סעיף ב': [[feedback:prt2]]</p><p>סעיף ג': [[feedback:prt3]]</p><p>סעיף ד': [[feedback:prt4]]<br></p>", "prtcorrect": "Correct answer, well done.", "prtpartiallycorrect": "Your answer is partially correct.", "prtincorrect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "boolean", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "matrix([x],[y])", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 5, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 5, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans5", "type": "algebraic", "boxsize": 5, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans6", "type": "algebraic", "boxsize": 5, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans7", "type": "algebraic", "boxsize": 5, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustve