{"id": "97110113", "name": "אינטגרל בעזרת זהות טריגונומטרית – מכפלה לסכום, sin(2A) או tan²", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>חשבו את האינטגרל</p><p dir=\"ltr\" style=\"text-align:center\">\\[ I=\\int {{CT:0}}\\,dx \\]</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(I=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p style=\"font-size:0.92em;margin:8px 0 0\">הוסיפו קבוע אינטגרציה, למשל <code dir=\"ltr\">+C</code>. את <span dir=\"ltr\">\\(\\sin(2x)\\)</span> מזינים <code dir=\"ltr\">sin(2*x)</code>, ואת <span dir=\"ltr\">\\(\\tan x\\)</span> מזינים <code dir=\"ltr\">tan(x)</code>.</p></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> בעזרת זהות טריגונומטרית הופכים את האינטגרנד לסכום של פונקציות שהאינטגרל שלהן מיידי.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הזהות</b><br>[[if test=\"{{CT:3}}\"]]לפי <span dir=\"ltr\">\\(\\sin A\\cos B=\\frac{1}{2}\\left[\\sin(A+B)+\\sin(A-B)\\right]\\)</span>:[[/if]][[if test=\"{{CT:4}}\"]]לפי <span dir=\"ltr\">\\(\\cos A\\cos B=\\frac{1}{2}\\left[\\cos(A-B)+\\cos(A+B)\\right]\\)</span>:[[/if]][[if test=\"{{CT:5}}\"]]לפי <span dir=\"ltr\">\\(\\sin A\\sin B=\\frac{1}{2}\\left[\\cos(A-B)-\\cos(A+B)\\right]\\)</span>:[[/if]][[if test=\"{{CT:6}}\"]]לפי <span dir=\"ltr\">\\(\\sin A\\cos A=\\frac{1}{2}\\sin 2A\\)</span>:[[/if]][[if test=\"{{CT:7}}\"]]לפי <span dir=\"ltr\">\\(\\tan^2 A=\\frac{1}{\\cos^2 A}-1\\)</span>:[[/if]]<p dir=\"ltr\" style=\"text-align:center\">\\[ {{CT:0}}={{CT:1}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — אינטגרציה</b><br>משתמשים ב-<span dir=\"ltr\">\\(\\int\\cos(kx)\\,dx=\\frac{\\sin(kx)}{k}+C\\)</span>, <span dir=\"ltr\">\\(\\int\\sin(kx)\\,dx=-\\frac{\\cos(kx)}{k}+C\\)</span> ו-<span dir=\"ltr\">\\(\\int\\frac{dx}{\\cos^2(kx)}=\\frac{\\tan(kx)}{k}+C\\)</span>:<p dir=\"ltr\" style=\"text-align:center\">\\[ I=\\int\\left({{CT:1}}\\right)dx={{CT:2}}+C \\]</p></div></div>", "specificfeedback": "[[feedback:prt1]]", "prtcorrect": "Correct answer, well done.", "prtpartiallycorrect": "Your answer is partially correct.", "prtincorrect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "int,integrate,diff", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Int", "sans": "ans1", "tans": "ta+c", "testoptions": "x", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "diff(ans1,x)", "tans": "w1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "<div dir=\"rtl\"><span dir=\"ltr\">\\(\\tan^2 u=\\frac{1}{\\cos^2 u}-1\\)</span>: לא לשכוח את המחובר <span dir=\"ltr\">\\(-1\\)</span>.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": ""}}]}], "qvnames": ["aa", "bb", "cf", "kind", "p", "r", "ta", "w1"], "nvariants": 50}