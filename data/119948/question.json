{"id": "119948", "name": "אי-שוויון עם ערך מוחלט וחזקה רביעית – |c − 2x⁴| ≤ d (א)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p></p><p style=\"text-align: right;\"><br></p><p style=\"text-align: right;\">פתרו את אי השוויון הבא</p><p style=\"text-align: center;\">\\[ \\left| {{CT:0}} - 2*{{CT:1}}^4 \\right| &lt;= {{CT:2}} \\]&nbsp;</p><p style=\"text-align: center;\"></p><p style=\"text-align: right;\">הציגו את תשובתכם כסדרת אי-שיוויונים מקושרים בקשרים לוגיים. כמו לדוגמא</p><p></p><p style=\"text-align: center;\">&nbsp;\\( x&gt;=5\\) and/or \\(x&lt; 13\\).&nbsp;</p><p style=\"text-align: right;\">תשובתכם<br></p><p style=\"text-align: right;\"></p><div><p style=\"text-align: center;\"><span>[[input:ans1]] [[validation:ans1]]</span></p></div><br><p></p><p style=\"text-align: left;\"><span style=\"text-align: center;\"><br></span></p><p></p>", "generalfeedback": "<p style=\"text-align: right;\">מאחר ו</p><p style=\"text-align: center;\">&nbsp;\\[{{CT:3}}.\\]</p><p style=\"text-align: right;\">אז</p>\n<p style=\"text-align: center;\">\\[{{CT:4}} \\le {{CT:5}}\\mbox{&nbsp; &nbsp;&nbsp; and &nbsp; &nbsp; }{{CT:4}} \\ge {{CT:6}}.\\]</p><p style=\"text-align: right;\">ולכן</p>\n<p style=\"text-align: center;\">\\[{{CT:7}} \\le {{CT:5}}+{{CT:8}}\\mbox{&nbsp; &nbsp;&nbsp; and &nbsp; &nbsp; }{{CT:7}} \\ge {{CT:6}}+{{CT:8}}.\\]</p>\n<p style=\"text-align: center;\">\\[{{CT:7}} \\le {{CT:9}}\\mbox{&nbsp; &nbsp;&nbsp; and &nbsp; &nbsp; }{{CT:7}} \\ge {{CT:10}}.\\]</p>\n<p style=\"text-align: right;\">חלוקה ב-2 נותנת</p>\n<p style=\"text-align: center;\">\\[{{CT:11}} \\le {{CT:12}}\\mbox{&nbsp; &nbsp;&nbsp; and &nbsp; &nbsp; }{{CT:11}} \\ge {{CT:13}}.\\]</p>\n<p style=\"text-align: right;\">&nbsp; &nbsp; נוציא שורש רביעי</p><p style=\"text-align: center;\">\\[{{CT:1}}\\ge -{{CT:14}}\\mbox{&nbsp;&nbsp; and&nbsp; }{{CT:1}}\\le {{CT:14}}\\mbox{&nbsp;&nbsp; and&nbsp; } ({{CT:1}} \\ge {{CT:15}}\\mbox{&nbsp;&nbsp; or&nbsp;&nbsp; }{{CT:1}} \\le -{{CT:15}})\\]<br></p>\n<p style=\"text-align: right;\">תשובה זו ניתן להזין כך</p><p style=\"text-align: center;\">&nbsp;\\(({{CT:1}}&gt;={{CT:16}} \\mbox{&nbsp;&nbsp; and&nbsp;&nbsp; } {{CT:1}}&lt;=-1) \\mbox{&nbsp;&nbsp; or&nbsp;&nbsp;&nbsp; }({{CT:1}}&gt;= 1 \\mbox{&nbsp;&nbsp; and &nbsp; } {{CT:1}}&lt;={{CT:17}})\\)</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\">תשובה נכונה, יפה מאוד</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\"><span class=\"incorrect\">תשובה שגויה</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctanswer", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctanswer2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "Result-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-2-F", "feedback": ""}}]}], "qvnames": ["c1", "c2", "correctanswer", "correctanswer2", "n1", "p", "v", "wronganswer1", "wronganswer2"], "nvariants": 4}