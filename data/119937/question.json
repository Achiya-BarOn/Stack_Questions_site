{"id": "119937", "name": "נגזרת 4", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p><br></p><p style=\"text-align: right;\">גזרו את הפונקציה הבאה. נסו לפשט את הביטוי לפני הגזירה</p><p style=\"text-align: center;\">&nbsp;\\[ \\frac{d}{d{{CT:0}}}\\left[ {{CT:1}}\\right]. \\] [[input:ans1]] [[validation:ans1]]</p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p><br></p><p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\"><br></p><p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\"><br></p><p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "q:pp2/pp1;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Diff", "sans": "ans1", "tans": "ta", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "<p><br></p><p style=\"text-align: right;\">&nbsp;לפני הגזירה נסדר את הביטוי מחדש</p><p style=\"text-align: center;\">\\[ {{CT:1}}={{CT:2}}.\\]&nbsp;<br></p><p style=\"text-align: right;\"><span style=\"text-align: center;\">יש להשתמש בכלל המכפלה. נסמן</span><br></p><p style=\"text-align: right;\"><p style=\"text-align: center;\"><span>\\(u={{CT:3}}\\) and \\(v={{CT:4}}\\).&nbsp;</span><br></p><br><br></p><p style=\"text-align: right;\">ונקבל</p><p style=\"text-align: center;\">\\[\\begin{array}{rcl} \\displaystyle \\frac{d}{d{{CT:0}}}[{{CT:2}}] &amp;=&amp; \\displaystyle \\frac{du}{d{{CT:0}}}\\cdot v + u\\cdot \\frac{dv}{d{{CT:0}}} \\\\ &amp;=&amp; \\displaystyle {{CT:5}} \\cdot {{CT:6}} + {{CT:3}}\\cdot{{CT:7}} \\\\ &amp;=&amp; \\displaystyle {{CT:8}}. \\end{array} \\]<br></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["p", "p2", "pp1", "pp2", "ppp1", "ppp2", "rdm1", "rdm2", "ta", "v"], "nvariants": 20}