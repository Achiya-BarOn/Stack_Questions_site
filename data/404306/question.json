{"id": "404306", "name": "פולינום מקלורן מסדר 2 של פונקציה המוגדרת כאינטגרל (בחירה מרשימה)", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f", "params": ["t"], "body": "t/((t-C)^2+1)"}, {"name": "F", "params": ["x"], "body": "integrate(f(t),t,C,0)"}, {"name": "tans1", "params": ["x"], "body": "a0+a1*x+a2*x^2"}, {"name": "w2", "params": ["x"], "body": "log(C^2+1)/2+a2*x^2"}, {"name": "w3", "params": ["x"], "body": "C*x^2/2+(C+1)*x+C+2"}, {"name": "w4", "params": ["x"], "body": "f(C)*x^2+(C+1)*x-C^2"}, {"name": "w5", "params": ["x"], "body": "tans1(x)+C*x"}, {"name": "w6", "params": ["x"], "body": "a2*x^2+C^2"}, {"name": "w7", "params": ["x"], "body": "a2*x^2+x+1"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את פולינום מקלורן (טילור סביב אפס) <span>\\(P(x)\\)</span> מסדר 2 עבור הפונקציה הבאה:</span> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">\\[F(x) = \\int_{{{CT:0}}}^{x} {{CT:1}} dt \\]</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p><span> </span> <span style=\"font-size: medium;\"><span style=\"font-size: 10px;\"> </span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד.  </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(P(x)\\) = </span><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "8", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.15, "nextnode": -1, "answernote": "prt1-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": ""}}]}], "qvnames": ["C", "a0", "a1", "a2", "bestlength", "ta_multiple1", "trylength"], "nvariants": 50}