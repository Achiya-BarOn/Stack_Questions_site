, "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.111112, "nextnode": 9, "answernote": "Result-9-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0, "nextnode": 9, "answernote": "Result-9-F", "feedback": ""}}, {"name": 9, "answertest": "AlgEquiv", "sans": "true", "tans": "true", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-10-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-10-F", "feedback": ""}}]}], "qvnames": ["a", "abc", "asymPoint", "b", "c", "classification_op1", "classification_op2", "ffNotDefined1", "ffNotDefined2", "form_options", "forms", "holePoint", "limAsymMinus", "limAsymPlus", "limAtNegInf", "limAtPlusInf", "limAtx1minus", "limAtx1plus", "limAtx2minus", "limAtx2plus", "limHoleMinus", "limHolePlus", "r", "tansPointsAndclassification", "whereIsForm"], "nvariants": 50}