{"id": "148632", "name": "לכסון אורתוגונלי של סימטרית ממשית - 2 על 2", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "diag_matrixify", "params": ["expr"], "body": "if matrixp (expr) then expr else matrix ([expr])"}, {"name": "diag_zeropad_row", "params": ["r", "indent", "width"], "body": "block([right: width - (left + length(r))],append (makelist (0, indent), r, makelist (0, right)))"}, {"name": "diago", "params": ["lst"], "body": "block ([lst: map (diag_matrixify, lst), width, height, left: 0, rows: []],width: lsum (length (first (A)), A, lst), height: lsum (length (A), A, lst), for A in lst do ( for r in args(A) do  rows: cons (diag_zeropad_row (r, left, width), rows), left: left + length (first (A))), apply (matrix, reverse (rows)))"}, {"name": "diagomatrixp", "params": ["mat"], "body": "block([diagflag:true],for i thru length(mat) do for j thru length(mat) do if not(i=j) and not(mat[i,j]=0) then return(diagflag:false), diagflag)"}, {"name": "randvervect", "params": ["n", "k"], "body": "transpose(makelist(rand_with_step(-k,k,1),n))"}, {"name": "randvervectnonzero", "params": ["n", "k"], "body": "transpose(makelist(rand_with_prohib(-k,k,[0]),n))"}, {"name": "matrify", "params": ["veclst"], "body": "block([mat:matrix([])], for i:1 thru length(veclst) do(mat:addcol(mat,veclst[i])),mat)"}, {"name": "dependentvects", "params": ["veclst"], "body": "is(rank(matrify(veclst))<length(veclst))"}, {"name": "inSpan", "params": ["veclst1", "veclst2"], "body": "is(rank(matrify(veclst1)) = rank(matrify(append(veclst1,veclst2))))"}, {"name": "dezero", "params": ["vec", "n", "k"], "body": "if (zeromatrixp(vec)) then randvervectnonzero(n,k) else vec"}, {"name": "mysimp", "params": ["x"], "body": "rootscontract(simplify(rootscontract(simplify(rootscontract(x)))))"}, {"name": "prod", "params": ["u", "v"], "body": "mysimp(expand(transpose(u).v))"}, {"name": "perpp", "params": ["u", "v"], "body": "is(prod(u,v)=0)"}, {"name": "unitvectp", "params": ["u"], "body": "is(prod(u,u)=1)"}, {"name": "unitvectify", "params": ["u"], "body": "block([norm: sqrt(prod(u,u))], if (norm=0) then u else (u/norm))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונה המטריצה הממשית הסימטרית</p><p dir=\"ltr\" style=\"text-align:center\">\\[A = {{CT:0}}\\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>מצאו מטריצה <span dir=\"ltr\">\\(M\\in M_{2\\times 2}(\\mathbb{R})\\)</span> אורתוגונלית ומטריצה <span dir=\"ltr\">\\(D\\in M_{2\\times 2}(\\mathbb{R})\\)</span> אלכסונית המקיימות</p><p dir=\"ltr\" style=\"text-align:center\">\\[MAM^{t}=D\\]</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(M=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(D=\\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans2]]</div></div></div>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "dimnmat(mat,n):= is(length(mat) = n and length(transpose(mat))=n);\nvalidM: dimnmat(ans1,n);\nvalidD: dimnmat(ans2,n);\nstudM: if(validM) then ans1 else zeromatrix(n,n);\nstudD: if(validD) then ans2 else zeromatrix(n,n);\n\nisdiag: diagomatrixp(studD);\nisorth: is(simplify(studM.transpose(studM))=ident(n));\n\nstudMAMt: mysimp(studM.A.transpose(studM));\ngoodans: is(studMAMt=mysimp(studD));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "validD", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">המטריצה <span dir=\"ltr\">\\(D\\)</span> שהזנת אינה מהגודל הנכון.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "validM", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 2, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<div dir=\"rtl\">המטריצה <span dir=\"ltr\">\\(M\\)</span> שהזנת אינה מהגודל הנכון.</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "isdiag", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 3, "answernote": "prt1-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<div dir=\"rtl\">המטריצה <span dir=\"ltr\">\\(D\\)</span> שהזנת אינה אלכסונית.</div>"}}, {"name": 3, "answertest": "AlgEquiv", "sans": "isorth", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 4, "answernote": "prt1-4-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-4-F", "feedback": "<div dir=\"rtl\">המטריצה <span dir=\"ltr\">\\(M\\)</span> שהזנת אינה אורתוגונלית.</div>"}}, {"name": 4, "answertest": "AlgEquiv", "sans": "goodans", "tans": "true", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-5-T", "feedback": "<div dir=\"rtl\">תשובתך נכונה.</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-5-F", "feedback": "<div dir=\"rtl\">תשובתך אינה נכונה. עבור המטריצה <span dir=\"ltr\">\\(M\\)</span> שהזנת מתקיים<p dir=\"ltr\" style=\"text-align:center\">\\[MAM^t={@studMAMt@}\\]</p>וזו אינה המטריצה <span dir=\"ltr\">\\(D\\)</span> שהזנת.</div>"}}]}], "qvnames": ["A", "D", "M", "k", "n", "v1", "v2"], "nvariants": 50}