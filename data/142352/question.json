{"id": "142352", "name": "חישוב אורך של עקום 1", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "FF", "params": ["x"], "body": "aa*x^4 - bb*x^(-2)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את אורך העקום</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;\\[\\displaystyle{ y = {{CT:0}} }\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">שנמצא מעל הקטע</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;\\[ [{{CT:1}},{{CT:2}}]\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כתבו את תשובתכם כשלם או מנת שלמים, ולא פיתוח עשרוני.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">[[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">הנוסחה לחישוב אורך עקום היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[L=\\int_a^b \\sqrt{1+y'^2} \\,dx\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נחשב את האינטגרנד:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[y' = {{CT:3}} = {{CT:4}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[(y')^2 = {{CT:5}} = {{CT:6}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[1 + (y')^2 =  {{CT:7}}= {{CT:8}}=\\left({{CT:9}}\\right)^2\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\sqrt{1 + (y')^2} = \\left|{{CT:9}}\\right| = {{CT:9}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הסרת הערך המוחלט מוצדקת, הואיל ובתחום האינטגרציה שלנו, הביטוי הוא חיובי. נחשב אינטגרל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\int_{{CT:1}}^{{CT:2}} {{CT:9}} \\, dx = \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\int_{{CT:1}}^{{CT:2}} {{CT:10}} \\, dx = \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ = {{CT:11}} \\Big|_{{CT:1}}^{{CT:2}}= {{CT:12}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "length", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["SqrtffpsPlusOne", "aa", "bb", "ff", "ffPrime", "ffPrimeSimp", "ffPrimeSquared", "ffPrimeSquaredSimp", "ffpsPlusOne", "ffpsPlusOneSimp", "fromWhere", "integrand", "length", "pp", "qq", "toWhere"], "nvariants": 20}