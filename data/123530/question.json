{"id": "123530", "name": "חישוב גבול סדרה 3 בעזרת כלל המנה", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "a", "params": ["n"], "body": "(n^aa)/(bb^n)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">חשבו את גבול הסדרה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ a_n = {{CT:0}}\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\lim_{n\\to\\infty} a_n = \\) [[input:ans1]] [[validation:ans1]]</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">הואיל והמונה הוא פולינומיאלי במשתנה,&nbsp;והמכנה הוא מעריכי במשתנה,&nbsp;הסדרה שואפת לאפס.</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדי להצדיק זאת, נשתמש בקריטריון המנה. סדרת המנות:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\frac{a_{n+1}}{a_n} = \\frac{{CT:1}}{{CT:0}} = (\\frac{n+1}{n})^{{CT:2}} \\cdot \\frac{1}{{CT:3}} \\to \\frac{1}{{CT:3}} &lt;1.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הואיל והגבול של סדרת המנות קטן מ- 1, הסדרה שלנו שואפת ל- 0.</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correctLimit : 0;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctLimit ", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">מצאת את הגבול הנכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הגבול שמצאת אינו נכון.</p>\n<p style=\"text-align: right;\" dir=\"ltr\">\\[\\lim_{n\\to\\infty} a_n = {@correctLimit@}\\]</p>"}}]}], "qvnames": ["aa", "bb"], "nvariants": 27}