{"id": "126979", "name": "מציאת פולינום שמספר הוא שורש שלו", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randcomplexnonzero", "params": ["n"], "body": "block([re,im],re: rand_with_prohib(-n,n,[]),im: rand_with_prohib(-n,n,[0]),re + im*%i)"}], "questiontext": "<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\">נתון המספר המרוכב \\(z = {{CT:0}}\\). מצאו פולינום ריבועי מהצורה</p><p style=\"text-align: center; direction: rtl;\" dir=\"rtl\">&nbsp;\\(p(x)=x^2+b\\cdot x +c\\)&nbsp;</p><p style=\"direction: rtl; text-align: right;\" dir=\"rtl\">במקדמים <strong>ממשיים</strong>&nbsp;(כלומר \\(b,c\\) ממשיים), כך ש-\\(p(z)=0\\):</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(b=\\) [[input:ans1]] [[validation:ans1]]</p><p style=\"text-align: center;\" dir=\"ltr\">\\(c=\\) [[input:ans2]] [[validation:ans2]]<br></p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את השורש הנוסף של הפולינום שמצאתם:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">[[input:ans3]] [[validation:ans3]]</p><p class=\"input-hint input-hint-complex\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: את היחידה המדומה \\(i\\) מזינים באות <code dir=\"ltr\">i</code> (אפשר גם <code dir=\"ltr\">%i</code>), וכפל מסמנים בכוכבית. למשל <code dir=\"ltr\">3-2*i</code>.</p><p style=\"text-align: left;\" dir=\"ltr\"><br></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "a,b,c,d,e,f,g,h,j,k,l,m,n,o,p,q,r,s,t,u,v,w,y,z", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "a,b,c,d,e,f,g,h,j,k,l,m,n,o,p,q,r,s,t,u,v,w,y,z", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct_poly: if is(equal(ans1,bb)) and is(equal(ans2,cc)) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "correct_poly", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": 1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">מצאת פולינום כמבוקש בשאלה</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הפולינום שסיפקת אינו כמבוקש בשאלה</p><p style=\"text-align: right;\" dir=\"rtl\">{@remainder(pp,ans1)@}<br></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans3", "tans": "conjugate(zz)", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">ציינת את השורש הנוסף הנכון</p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">המספר הנוסף שציינת אינו שורש של הפולינום המבוקש</p>"}}]}], "qvnames": ["bb", "cc", "pp", "zz"], "nvariants": 50}