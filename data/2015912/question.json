{"id": "2015912", "name": "סכום של שני טורים הנדסיים Σ(1/aⁿ+1/bⁿ)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>חשבו את סכום הטור</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\left({{CT:0}}\\right)+ \\left({{CT:1}}\\right)+\\left({{CT:2}}\\right)+\\cdots=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p style=\"font-size:0.92em;margin:8px 0 0\">עבור אינסוף יש לרשום <code dir=\"ltr\">inf</code>, עבור מינוס אינסוף יש לרשום <code dir=\"ltr\">minf</code></p></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> מפרקים לשני טורים הנדסיים מתכנסים ומחברים את סכומיהם.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — שני טורים הנדסיים</b><br>הטור הוא <span dir=\"ltr\">\\(\\sum_{n=1}^\\infty\\left(q_1^{\\,n}+q_2^{\\,n}\\right)\\)</span> עם <span dir=\"ltr\">\\(q_1={{CT:3}}\\)</span> ו-<span dir=\"ltr\">\\(q_2={{CT:4}}.\\)</span> בשני המקרים <span dir=\"ltr\">\\(|q|\\lt 1\\)</span>, ולכן כל אחד מהטורים ההנדסיים מתכנס, ומותר לסכום כל אחד לחוד לפי <span dir=\"ltr\">\\(\\sum_{n=1}^\\infty q^n=\\frac{q}{1-q}.\\)</span></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — הסכום</b><br><p dir=\"ltr\" style=\"text-align:center\">\\[ \\sum_{n=1}^\\infty q_1^{\\,n}=\\frac{ {{CT:3}} }{1-\\left({{CT:3}}\\right)}={{CT:5}},\\qquad \\sum_{n=1}^\\infty q_2^{\\,n}=\\frac{ {{CT:4}} }{1-\\left({{CT:4}}\\right)}={{CT:6}} \\]</p>ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ \\left({{CT:0}}\\right)+\\left({{CT:1}}\\right)+\\cdots={{CT:5}}+\\left({{CT:6}}\\right)={{CT:7}} \\]</p></div></div>", "specificfeedback": "[[feedback:Result]]", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 8, "insertstars": 0, "forbidfloat": true, "forbidwords": "diff,taylor,sum,solve", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctanswer", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "<div dir=\"rtl\">תשובתכם נכונה, כל הכבוד!</div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<div dir=\"rtl\">תשובתכם שגויה.</div>"}}]}], "qvnames": ["a", "b", "correctanswer"], "nvariants": 50}