{"id": "119922", "name": "אינטגרל6", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p>&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו, ואל תשכחו את הקבוע</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;\\[ \\displaystyle{\\int {{CT:0}} d{{CT:1}} = }\\] [[input:ans1]] [[validation:ans1]]</p>", "generalfeedback": "<p>&nbsp;</p>\n<p style=\"text-align: right;\">תוך שימוש בחוקי לוג</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[e^{ln(x)} = x\\] and \\[ln(x^k) = k \\cdot ln(x)\\]&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נקבל ש</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;\\[\\begin{array}{rcl}\\displaystyle a^x &amp;\\displaystyle =&amp;\\displaystyle e^{ln(a^x)} \\\\ &amp;\\displaystyle =&amp;\\displaystyle e^{x\\cdot ln(a)} \\end{array}\\] So, \\[\\begin{array}{rcl}\\displaystyle \\int {{CT:0}} d{{CT:1}} &amp;\\displaystyle =&amp;\\displaystyle \\int e^{x\\cdot ln(a)} d{{CT:1}} \\\\ &amp;\\displaystyle =&amp;\\displaystyle {{CT:2}} \\end{array}\\]</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\">&nbsp;</p>\n<p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\">&nbsp;</p>\n<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\">&nbsp;</p>\n<p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "varss:listofvars(ans1);\nvarss:delete(a,delete(C,delete(c,varss)));\nan1:ans1;\nfor i:1 while i<=length(varss) do an1:ev(an1,varss[i]=v);\n\nta2:a^x/ln(abs(a))+c;\ndta2:ev(diff(ta2,v));\n\nstu:ev(diff(an1,v));\nc1:ev(diff(an1,c));\nc2:ev(diff(an1,C));\nd:c1^2+c2^2;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "stu", "tans": "p", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "nextnode": 1, "answernote": "Result-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "Result-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "d", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}, "on_false": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "Result-2-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "stu", "tans": "dta2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": 1, "answernote": "Result-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-3-F", "feedback": ""}}]}], "qvnames": ["p", "v"], "nvariants": 1}