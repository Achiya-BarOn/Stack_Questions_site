{"id": "1823769", "name": "מציאת העתקה לפי פעולה על איברי בסיס ב R_2[x]", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "colToPoly", "params": ["cl"], "body": "sum(cl[i][1]*x^(i-1),i,1,length(cl))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונה העתקה לינארית <span dir=\"ltr\">\\(T:\\mathbb{R}_2[x]\\to\\mathbb{R}_2[x]\\)</span> המקיימת:</p><p dir=\"ltr\" style=\"text-align:center\">\\[T(v_1)={{CT:0}},\\quad T(v_2)={{CT:1}},\\quad T(v_3)={{CT:2}}\\]</p><p>עבור הפולינומים</p><p dir=\"ltr\" style=\"text-align:center\">\\[v_1 = {{CT:3}},\\quad v_2= {{CT:4}},\\quad v_3 = {{CT:5}}\\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>מצאו את ההעתקה <span dir=\"ltr\">\\(T\\)</span>.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(T({{CT:6}})=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 35, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "a'+b'*x+c'*x^2", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "polyToCol(p,n):= transpose(makelist(coeff(p, x, i-1),i,n));\nans1cl:polyToCol(ans1,n);\ngoodvars: emptyp(delete(x, delete(a,delete(b,delete(c,listofvars(ans1cl))))));\ngooddim: is(hipow(ans1,x)<= n);\nif gooddim then an1:ans1cl else an1:transpose(ans1cl);\nstudT(v):= subst([a=v[1,1],b=v[2,1],c=v[3,1]],ans1);\n\nfirst: is(equal(studT(quBaseVecs[1]),colToPoly(quImVecs[1])));\nsecond: is(equal(studT(quBaseVecs[2]), colToPoly(quImVecs[2])));\nthird: is(equal(studT(quBaseVecs[3]), colToPoly(quImVecs[3])));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "goodvars", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">בתשובתך מופיעים משתנים שאינם מתוך <span dir=\"ltr\">\\(a,b,c,x\\)</span>.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "gooddim", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 2, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<div dir=\"rtl\">דרגת הפולינום שגויה.</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "first", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 3, "answernote": "prt1-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": "<div dir=\"rtl\">תשובתך שגויה. להעתקה <span dir=\"ltr\">\\(T\\)</span> שהזנת, מתקבל <span dir=\"ltr\">\\(T(v_1)={{CT:7}}\\)</span>.</div>"}}, {"name": 3, "answertest": "AlgEquiv", "sans": "second", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0, "nextnode": 4, "answernote": "prt1-4-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-4-F", "feedback": "<div dir=\"rtl\">תשובתך שגויה. להעתקה <span dir=\"ltr\">\\(T\\)</span> שהזנת, מתקבל <span dir=\"ltr\">\\(T(v_2)={{CT:8}}\\)</span>.</div>"}}, {"name": 4, "answertest": "AlgEquiv", "sans": "third", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-5-T", "feedback": "<div dir=\"rtl\">תשובתך נכונה</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-5-F", "feedback": "<div dir=\"rtl\">תשובתך שגויה. להעתקה <span dir=\"ltr\">\\(T\\)</span> שהזנת, מתקבל <span dir=\"ltr\">\\(T(v_3)={{CT:9}}\\)</span>.</div>"}}]}], "qvnames": ["k", "n", "quBaseVecs", "quImVecs", "standBaseImages", "vecNum", "vecs"], "nvariants": 50}