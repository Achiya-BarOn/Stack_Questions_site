{"id": "126680", "name": "תמונת פונקציה – מנה של פונקציות לינאריות (א)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "(aa*x +bb)/(cc*x + dd)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">קבע מהי תמונתה של הפונקציה הבאה:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ f(x) = {{CT:0}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כתבו את תשובתכם כאי שוויונים (בלבד) במשתנה&nbsp;<span style=\"text-align: center; font-size: 0.9375rem;\">\\(y\\)&nbsp;</span><span style=\"font-size: 0.9375rem;\">כדוגמת</span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\( y &gt; \\alpha \\mbox{ and } y&lt;=\\beta\\)</p>\n<p style=\"text-align: right;\" dir=\"rtl\">תמונת הפונקציה היא</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;[[input:ans1]] [[validation:ans1]]</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">אפשר להוכיח שהפונקציה הפכיה. כעת, כדי למצוא את התמונה, נתחיל עם:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y = {{CT:0}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ונבודד את&nbsp;<span style=\"font-size: 0.9375rem;\">\\(x\\)</span></p><p style=\"text-align: right;\" dir=\"ltr\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {{CT:1}} = {{CT:2}}\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {{CT:3}} = {{CT:4}}\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ x = \\frac{{CT:5}}{{CT:6}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כעת, התמונה של הפונקציה המקורית היא תחום ההגדרה של הביטוי האחרון, כלומר:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {{CT:7}} \\neq 0 \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y \\neq {{CT:8}}. \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נכתוב זאת בעזרת אי-שיוויונים באופן הבא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y &gt; {{CT:8}} \\mbox{ or } y &lt; {{CT:8}}.\\]</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ineqprepare(ans1)", "tans": "correctanswer", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">התשובה הנכונה היא:</p>\n<p style=\"text-align: right;\" dir=\"ltr\">{{CT:9}}</p>"}}]}], "qvnames": ["aa", "bb", "cc", "correctanswer", "dd"], "nvariants": 50}