{"id": "141258", "name": "מטריצת מעבר ווקטור קואורדינטות - פולינומים", "defaultgrade": 2, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randvervect", "params": ["n", "k"], "body": "transpose(makelist(rand_with_step(-k,k,1),n))"}, {"name": "randvervectnonzero", "params": ["n", "k"], "body": "transpose(makelist(rand_with_prohib(-k,k,[0]),n))"}, {"name": "randhorvect", "params": ["n", "k"], "body": "matrix(makelist(rand_with_step(-k,k,1),n))"}, {"name": "dezero", "params": ["vec", "n", "k"], "body": "if (zeromatrixp(vec)) then randvervectnonzero(n,k) else vec"}, {"name": "dezerolst", "params": ["veclst", "k"], "body": "map(lambda([vec], dezero(vec, length(vec),k)), veclst)"}, {"name": "matrify", "params": ["veclst"], "body": "block([mat:matrix([])], for i:1 thru length(veclst) do(mat:addcol(mat,veclst[i])),mat)"}, {"name": "collify", "params": ["M"], "body": "block([cols:[]],for i:1 thru length(transpose(M)) do(cols: endcons(col(M,i),cols)),cols)"}, {"name": "dependentvects", "params": ["veclst"], "body": "is(rank(matrify(veclst))<length(veclst))"}, {"name": "inSpan", "params": ["veclst1", "veclst2"], "body": "is(rank(matrify(veclst1)) = rank(matrify(append(veclst1,veclst2))))"}, {"name": "vectToPoly", "params": ["vect"], "body": "block([poly:0], for i:0 thru (length(vect)-1) do(poly: poly + x^i*vect[i+1,1]),poly)"}, {"name": "polyToVect", "params": ["poly"], "body": "transpose(rest(coeff_list(x^n+poly,x),-1))"}, {"name": "alltrue", "params": ["pred", "lst"], "body": "emptyp(delete(true,map(pred, lst)))"}, {"name": "leavefalses", "params": ["pred", "lst"], "body": "delete(true,map(lambda([ex],if pred(ex) then true else ex), lst))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונים בסיסים סדורים למרחב הפולינומים <span dir=\"ltr\">\\(\\mathbb{R}_{\\leq 3}[x]\\)</span>:</p><p dir=\"ltr\" style=\"text-align:center\">\\[B_1 = (1,x,x^2,x^3)\\]</p><p dir=\"ltr\" style=\"text-align:center\">\\[B_2 = ({{CT:0}}, {{CT:1}}, {{CT:2}},{{CT:3}})\\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>חשבו את מטריצות המעבר</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\([I]^{B_1}_{B_2}=\\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans2]]</div><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p><div style=\"margin-top:10px\"></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\([I]^{B_2}_{B_1}=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p style=\"margin-top:14px\">עבור הפולינום</p><p dir=\"ltr\" style=\"text-align:center\">\\[p(x)={{CT:4}}\\]</p><p>חשבו את וקטור הקואורדינטות</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\([p(x)]_{B_2}=\\) [[input:ans3]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans3]]</div></div></div>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt3]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 1, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "matrix", "boxsize": 1, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "matrix", "boxsize": 1, "insertstars": 0, "forbidfloat": true, "forbidwords": ".", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt3", "value": 2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "goodsizeM(M):= is(length(M)=n and length(transpose(M))=n);\nbadsize: leavefalses(goodsizeM,[ans2,ans1]);\ngoodszrv: is(length(ans3)=n and length(transpose(ans3))=1);\nperfect: is([ans2,ans1,ans3]=[TMBE, TMEB, rvB]);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "badsize", "tans": "[]", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt3-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 3, "answernote": "prt3-1-F", "feedback": "<div dir=\"rtl\">חלק מהקלטים שהזנת אינם מטריצות בגודל המתאים: {@badsize@}.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans2", "tans": "TMBE", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.25, "nextnode": 2, "answernote": "prt3-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 2, "answernote": "prt3-2-F", "feedback": "<div dir=\"rtl\">הערך שהזנת עבור <span dir=\"ltr\">\\([I]^{B_1}_{B_2}\\)</span> שגוי.</div>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "TMEB", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.25, "nextnode": 3, "answernote": "prt3-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 3, 