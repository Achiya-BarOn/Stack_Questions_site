, "on_true": {"scoremode": "+", "score": 0.25, "nextnode": 3, "answernote": "Result-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 3, "answernote": "Result-3-F", "feedback": "<div dir=\"rtl\"><p>טעית בנוגע לסדרה</p><p dir=\"ltr\" style=\"text-align:center\">\\[ d_n \\]</p></div>"}}, {"name": 3, "answertest": "AlgEquiv", "sans": "ans4", "tans": "subseq[4][2]", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.25, "nextnode": -1, "answernote": "Result-4-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-4-F", "feedback": "<div dir=\"rtl\"><p>טעית בנוגע לסדרה</p><p dir=\"ltr\" style=\"text-align:center\">\\[ e_n \\]</p></div>"}}]}], "qvnames": ["aa", "bb", "cc", "subseq"], "nvariants": 50}