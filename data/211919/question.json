{"id": "211919", "name": "אינטגרל משטחי מסוג ראשון על גרף מעל ריבוע", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "proj", "params": ["x", "y"], "body": "((x.y)/(y.y))*y"}, {"name": "x", "params": ["u", "v"], "body": "u"}, {"name": "y", "params": ["u", "v"], "body": "v"}, {"name": "z", "params": ["u", "v"], "body": "(2/3)*(u^(3/2)+v^(3/2))"}, {"name": "f", "params": ["x", "y", "z"], "body": "a*y+b*x"}, {"name": "Xu", "params": ["u", "v"], "body": "[diff(x(u,v),u), diff(y(u,v),u),diff(z(u,v),u)]"}, {"name": "Xv", "params": ["u", "v"], "body": "[diff(x(u,v),v), diff(y(u,v),v),diff(z(u,v),v)]"}, {"name": "W", "params": ["u", "v"], "body": "factor((crossprod(Xu(u,v),Xv(u,v))))"}, {"name": "J", "params": ["u", "v"], "body": "factor(norm(W(u,v)))"}, {"name": "integ", "params": ["u", "v"], "body": "factor(f(x(u,v),y(u,v),z(u,v))*J(u,v))"}], "questiontext": "<p dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את האינטגרל המשטחי (מן הסוג הראשון) של הפונקציה&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[f(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">על המשטח \\(S\\) המוגדר על ידי:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[S=\\left\\{ (x,y,z)\\;\\left|\\; \\begin{array}{c} 0 \\le x \\le {{CT:1}}\\\\0 \\le y \\le {{CT:1}}\\\\ \\\\z={{CT:2}} \\end{array}\\right.\\right\\}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"text-align: center;\">&nbsp;</span></p>\n<p dir=\"ltr\" style=\"text-align: center;\">\\(\\iint\\limits_{S} f(x,y,z) d\\sigma = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p dir=\"ltr\">&nbsp;</p>\n<p dir=\"rtl\">כאשר \\(\\sigma\\) אלמנט השטח לאורך המשטח.</p>\n<p dir=\"rtl\"><br></p>\n<p dir=\"rtl\">הנה המשטח:</p>\n<p dir=\"rtl\"><br></p>\n[[jsxgraph width='500px' height='500px']]var board = JXG.JSXGraph.initBoard(divid, {\nboundingbox: [-8, 8, 8, -8],\nkeepaspectratio: false,\naxis: false\n});\n\nvar box = [-2, {{CT:3}}];\nvar box2 = [-2,4/3*(JXG.Math.pow({{CT:4}},3/2))+2];\nvar view = board.create('view3d',\n[[-6, -3], [8, 8],\n[box2, box2, box2]]);\n\n\nvar c = view.create('parametricsurface3d', [\nfunction(u,v){return v;},\nfunction(u,v){return u;},\nfunction(u,v){return 2/3*(JXG.Math.pow(u,3/2)+JXG.Math.pow(v,3/2));},\n[0, 2 * Math.PI],\n[0, Math.PI]\n], {\nstrokeColor: '#ff0000',\nstepsU: 30,\nstepsV: 30\n});\n[[/jsxgraph]]", "generalfeedback": "<p dir=\"rtl\"><span style=\"font-size: medium;\"><span style=\"text-align: center;\">&nbsp;</span></span></p>", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">יופי חישבתם את האינטגל נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\">האינטגרל שלכם שגוי.&nbsp;</p>"}}]}], "qvnames": ["R", "a", "b", "tans1", "u0", "u1", "v0", "v1"], "nvariants": 50}