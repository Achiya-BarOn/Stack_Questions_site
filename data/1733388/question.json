{"id": "1733388", "name": "אינטגרלים כפולים – חצי טבעת בקואורדינטות קוטביות", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_CALC2_DOUBLE_V2\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">חצי טבעת בקואורדינטות קוטביות</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div>יהי <span dir=\"ltr\">\\(\\displaystyle D\\)</span> התחום</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 19px; margin: 7px 0;\">\\(\\displaystyle {{CT:0}}\\le x^2+y^2\\le {{CT:1}},\\qquad {{CT:2}}\\)</div>\n<div style=\"margin-top: 8px;\">חשבו באמצעות קואורדינטות קוטביות. הזינו את הערך המדויק של האינטגרל.</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div dir=\"ltr\" style=\"display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 18px;\">\\(\\displaystyle \\iint_D\\left({{CT:3}}\\right)\\,dA=\\)[[input:ans1]]</div>\n<div style=\"text-align: center; font-size: 12px; color: #665f6b; margin-top: 7px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_CALC2_DOUBLE_V2\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>במעבר לקואורדינטות קוטביות מתקבלים הגבולות</p>\n<div dir=\"ltr\" style=\"text-align: center;\">\\(\\displaystyle {{CT:4}}\\le r\\le {{CT:5}},\\qquad {{CT:6}}\\le\\theta\\le{{CT:7}}\\)</div>\n<p>וכן <span dir=\"ltr\">\\(\\displaystyle dA=r\\,dr\\,d\\theta\\)</span>. לכן האינטגרנד לאחר הכללת היעקוביאן הוא</p>\n<div dir=\"ltr\" style=\"text-align: center;\">\\(\\displaystyle {{CT:8}}\\)</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px; margin-top: 8px;\">\\(\\displaystyle \\int_{{{CT:4}}}^{{{CT:5}}}\\int_{{{CT:6}}}^{{{CT:7}}}{{CT:8}}\\,d\\theta\\,dr={{CT:9}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:prt1]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 24, "insertstars": 1, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "ta", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}], "qvnames": ["A", "B", "C", "D", "case", "func", "funcPolar", "half", "r1", "r2", "s1", "s2", "ta", "theta0", "theta1"], "nvariants": 50}