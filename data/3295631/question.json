div>"}}]}, {"name": "porder", "value": 0.1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "bad:if is(ans5>ans6)=true then 1 else 0;ord:1-bad;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ord", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "porder-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "porder-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ד׳ —</b> <div dir=\"rtl\" style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;font-weight:bold\">ערך המינימום שהזנתם גדול מערך המקסימום! זה לא הגיוני!</div></div>"}}]}, {"name": "ppoints", "value": 0.4, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "a1:if is(equal(radcan(ans1-tans1),0)) then 1 else 0;a2:if is(equal(radcan(ans2-tans2),0)) then 1 else 0;a3:if is(equal(radcan(ans3-tans3),0)) then 1 else 0;a4:if is(equal(radcan(ans4-tans4),0)) then 1 else 0;ps:(a1+a2+a3+a4)/4;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": "ps", "penalty": 0, "nextnode": -1, "answernote": "ppoints-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳–ג׳ —</b> קואורדינטות נכונות: <strong>{@a1+a2+a3+a4@}</strong> מתוך 4.</div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "ppoints-1-F", "feedback": ""}}]}, {"name": "pvalues", "value": 0.4, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "v1:if is(equal(radcan(ans5-tans5),0)) then 1 else 0;v2:if is(equal(radcan(ans6-tans6),0)) then 1 else 0;vs:(v1+v2)/2;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": "vs", "penalty": 0, "nextnode": -1, "answernote": "pvalues-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ד׳ —</b> ערכי קיצון נכונים: <strong>{@v1+v2@}</strong> מתוך 2.</div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "pvalues-1-F", "feedback": ""}}]}], "qvnames": ["Pc", "Ph", "Pl", "Pmax", "Pmin", "R", "Uf", "Ul", "Un", "bdry", "bx", "by", "cx", "cy", "dh", "dir", "dl", "ellipse", "ex", "ey", "fam", "func", "fx", "fy", "h", "k", "loc_op", "loccode", "maxVal", "minVal", "q", "rel", "rho", "sig", "tans1", "tans2", "tans3", "tans4", "tans5", "tans6", "u", "v", "vh", "vl"], "nvariants": 50}