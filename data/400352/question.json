{"id": "400352", "name": "d_triangle_string", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: center;\" dir=\"rtl\"><img src=\"data/400352/files/1.jpeg\" alt=\"\" width=\"417\" height=\"300\" /></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">שני מוטות בגבהים של </span><span style=\"font-size: medium;\">\\(a={{CT:0}}, b={{CT:1}}\\) תקועים על קרקע שטוחה במרחק של </span><span style=\"font-size: medium;\">\\(d={{CT:2}}\\) </span><span style=\"font-size: medium;\">מטר זה מזה. על הקרקע תקוע יתד במרחק </span><span style=\"font-size: medium;\">\\(x\\) מ</span><span style=\"font-size: medium;\">ן המוט המסומן </span><span style=\"font-size: medium;\">\\(a\\). תייל מתוח מראש המוט האחד, אל היתד ומשם לראש המוט השני. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">מצאו את המרחק </span><span style=\"font-size: medium;\">\\(x\\) במטרים שיבטיח </span><span style=\"font-size: medium;\">אורך תייל מינימלי. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד.  </span> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור: </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><strong><span style=\"font-size: medium;\">שימו לב: </span></strong><span style=\"font-size: medium;\">התמונה היא להמחשה בלבד - האורכים בציור אינם בקנה מידה לנתוני השאלה בפועל. </span><span style=\"font-size: medium;\"><br /></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(x\\) = </span><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "8", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.15, "nextnode": -1, "answernote": "prt1-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": ""}}]}], "qvnames": ["Max", "a", "b", "d", "min", "ta_multiple1", "tans1", "w2", "w3", "w4", "w5", "w6", "w7"], "nvariants": 50}