{"id": "1599591", "name": "חישוב עקבה – trace(A) ו-trace(AᵗA)", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "mattrace", "params": ["M"], "body": "sum(M[i][i],i,1,n)"}, {"name": "texp", "params": ["x"], "body": "if numberp(x) and x<0 then concat(\"\\\\left(\",tex1(x),\"\\\\right)\") else tex1(x)"}, {"name": "texmul", "params": ["e"], "body": "simplode(map(texp, args(e)), \" \\\\cdot \")"}, {"name": "texsumf", "params": ["e"], "body": "block([L:first(args(e))], concat(tex1(first(L)), apply(sconcat, map(lambda([t], concat(\"+\",texp(t))), rest(L)))))"}, {"name": "texsubf", "params": ["e"], "body": "concat(tex1(first(args(e))), \"-\", texp(second(args(e))))"}, {"name": "texsq", "params": ["e"], "body": "concat(texp(first(args(e))), \"^2\")"}, {"name": "prodshow", "params": ["P", "Q"], "body": "genmatrix(lambda([i,j], sumf(makelist(mul(P[i,l],Q[l,j]),l,1,length(Q)))), length(P), length(first(Q)))"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונה המטריצה</p><p dir=\"ltr\" style=\"text-align:center\">\\[A={{CT:0}}\\]</p></div><p>חשבו את הבאים:</p><p style=\"font-size:0.92em;margin:8px 0 0\">תזכורת: <span dir=\"ltr\">\\(\\text{trace}(A)\\)</span> (או <span dir=\"ltr\">\\(\\text{tr}(A)\\)</span>) מוגדר להיות סכום איברי האלכסון של המטריצה <span dir=\"ltr\">\\(A\\)</span>.</p><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">א׳</span></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\text{trace}(A)=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ב׳</span></div><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\text{trace}(A^t\\cdot A)=\\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans2]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> העקבה היא סכום איברי האלכסון. בסעיף ב׳ מחשבים קודם את <span dir=\"ltr\">\\(A^t\\cdot A\\)</span> ואז מחברים את האלכסון שלה.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — העקבה של <span dir=\"ltr\">\\(A\\)</span> (סעיף א׳)</b><br>מחברים את איברי האלכסון:<p dir=\"ltr\" style=\"text-align:center\">\\[ \\text{trace}(A)={{CT:1}}={{CT:2}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — המכפלה <span dir=\"ltr\">\\(A^t\\cdot A\\)</span></b><br>משחלפים (השורות של <span dir=\"ltr\">\\(A\\)</span> הופכות לעמודות) וכופלים שורה בעמודה:<p dir=\"ltr\" style=\"text-align:center\">\\[ A^t\\cdot A={{CT:3}}{{CT:0}}={{CT:4}}={{CT:5}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 3 — העקבה של <span dir=\"ltr\">\\(A^t\\cdot A\\)</span> (סעיף ב׳)</b><br>מחברים את איברי האלכסון של המכפלה:<p dir=\"ltr\" style=\"text-align:center\">\\[ \\text{trace}(A^t\\cdot A)={{CT:6}}+{{CT:7}}={{CT:8}} \\]</p>בדיקה: האיבר ה-<span dir=\"ltr\">\\(j\\)</span> באלכסון של <span dir=\"ltr\">\\(A^t A\\)</span> הוא סכום הריבועים של עמודה <span dir=\"ltr\">\\(j\\)</span> של <span dir=\"ltr\">\\(A\\)</span>, ולכן העקבה היא סכום הריבועים של כל איברי <span dir=\"ltr\">\\(A\\)</span>:<p dir=\"ltr\" style=\"text-align:center\">\\[ {{CT:9}}={{CT:8}} \\]</p></div></div>", "specificfeedback": "[[feedback:prt1]]<br>[[feedback:prt2]]<br>", "prtcorrect": "Correct answer, well done.", "prtpartiallycorrect": "Your answer is partially correct.", "prtincorrect": "Incorrect answer.", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "A", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "A", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "mattrace(A)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ — שגוי.</b></div>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "mattrace(transpose(A).A)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳ — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳ — שגוי.</b></div>"}}]}], "qvnames": ["A", "At", "AtA", "n", "sqShow", "trShow"], "nvariants": 50}