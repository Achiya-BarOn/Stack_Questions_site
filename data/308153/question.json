{"id": "308153", "name": "סדר 5 ריבוי לא הומוגנית", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "p", "params": ["t"], "body": "coef[1]+coef[2]*t+coef[3]*t^2"}, {"name": "y", "params": ["t"], "body": "exp(t)*C.transpose([1,t,t^2])"}], "questiontext": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">נסמן </span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[P_n(t) = (1-t)^n = t^n-\\begin{pmatrix}n\\\\n-1 \\end{pmatrix}t^{n-1} + \\begin{pmatrix} n \\\\ n-2 \\end{pmatrix} t^{n-2} - \\ldots + (-1)^{n} \\]</span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">הפונקציה</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\"> </span><span style=\"font-size: medium;\">\\(x_n(t)\\)</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\"><span style=\"font-size: medium;\">היא הפתרון למשוואה הדיפרנציאלית הבאה:</span><span style=\"font-size: medium;\"> </span> </p>\n<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(P_n(D)x=x^{(n)}-\\begin{pmatrix}n\\\\n-1 \\end{pmatrix}x^{(n-1)} + \\begin{pmatrix} n \\\\ n-2 \\end{pmatrix} x^{(n-2)} - \\ldots + (-1)^{n} x = {{CT:0}} \\)</span></p>\n<p dir=\"rtl\"> </p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">עם תנאי ההתחלה</span></p>\n<p dir=\"rtl\"> </p>\n<p style=\"text-align: center;\" dir=\"ltr\"> <span style=\"font-size: medium;\">\\(x(0)=x'(0)=x''(0)=\\ldots =x^{(n-1)}(0) = 0\\)</span><span style=\"font-size: medium;\"><br /></span></p>\n<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">מצאו את הערך הבא של הפונקציה (<strong>זהירות: </strong>סמנו תשובה אחת בלבד):</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(x(1) = \\)</span> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "checkbox", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "[1]", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": ""}}]}], "qvnames": ["A", "B", "C", "MM", "W", "WI", "b", "b1", "coef", "div1", "div2", "div3", "div4", "div5", "div6", "div7", "div8", "mm", "ta_multiple", "tans1", "toe"], "nvariants": 50}