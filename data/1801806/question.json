{"id": "1801806", "name": "נגזרת של אינטגרל מ a עד x", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["t"], "body": "funcs[ii]"}, {"name": "gg", "params": ["t"], "body": "funcs[jj]"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;<span style=\"font-size: 0.9375rem;\">אנו נשתמש בסימון המקובל עבור הנגזרת:</span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\frac{d}{dx} f(x)\\equiv f'(x).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את שתי הנגזרות הבאות (\\(a\\) שרירותי כך שהאינטגרל בין \\(a\\) ל \\(x\\) מוגדר):</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{d}{dx} \\displaystyle{\\int_a^x {{CT:0}}} \\, dt = \\] [[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{d}{dx}\\displaystyle{ \\int_x^a {{CT:1}}} \\, dt = \\] [[input:ans2]] [[validation:ans2]]</p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"ltr\">&nbsp;הזינו תשובתכם עם משתנה \\(x\\).</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">המשפט היסודי של החדו\"א אומר שאם&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[f(x)\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">רציפה בקטע&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ [a,b]\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אז הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F(x) := \\int_a^x f(t)\\,dt \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">היא גזירה בקטע&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ (a,b), \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ונגזרתה היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F'(x) = f(x). \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">לכן,</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{d}{dx} \\int_a^x {{CT:0}} \\, dt = {{CT:2}},\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{d}{dx} \\int_x^a {{CT:1}} \\, dt = \\frac{d}{dx} \\left(-\\int_a^x {{CT:1}} \\, dt \\right) = {{CT:3}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "radcan(ans1)", "tans": "radcan(fDeriv)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "penalty": 0, "nextnode": 1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans2", "tans": "gDeriv", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "Result-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-2-F", "feedback": ""}}]}], "qvnames": ["fDeriv", "funcs", "gDeriv", "ii", "jj"], "nvariants": 42}