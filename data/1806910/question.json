{"id": "1806910", "name": "שימושי האינטגרל – שטח בין ישר לפונקציה רציונלית", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "scale/x^2"}, {"name": "gg", "params": ["x"], "body": "expand(mm*x+nn)"}, {"name": "poly", "params": ["x"], "body": "expand(mm*x^3+nn*x^2-scale)"}, {"name": "Farea", "params": ["x"], "body": "mm*x^2/2+nn*x+scale/x"}], "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">חשבו את השטח ברביע הראשון הכלוא בין הישר והגרף</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 1.9;\">\\(\\displaystyle y={{CT:0}}\\)<br>\\(\\displaystyle f(x)={{CT:1}}\\)</div>\n<div dir=\"ltr\" style=\"text-align: center; margin-top: 12px;\">{{CT:2}}</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-bottom: 8px;\">כתבו תשובה מדויקת, ללא קירוב עשרוני.</div>\n<div dir=\"ltr\" style=\"text-align: center;\">[[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>נקודות החיתוך מתקבלות מן המשוואה</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle \\frac{{{CT:3}}}{x^2}={{CT:0}}\\)</div>\n<p>כיוון ש־<span dir=\"ltr\">\\(\\displaystyle x&gt;0\\)</span>, אפשר לכפול ב־<span dir=\"ltr\">\\(\\displaystyle x^2\\)</span> ולקבל</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle {{CT:4}}=0\\)</div>\n<p>שלושת השורשים הם <span dir=\"ltr\">\\(\\displaystyle x=1\\)</span>, <span dir=\"ltr\">\\(\\displaystyle x={{CT:5}}\\)</span> ו־<span dir=\"ltr\">\\(\\displaystyle x={{CT:6}}\\)</span>. האחרון שלילי, ולכן ברביע הראשון גבולות התחום הם</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle {{CT:7}}\\le x\\le {{CT:8}}\\)</div>\n<p>הפונקציה <span dir=\"ltr\">\\(\\displaystyle {{CT:1}}\\)</span> קמורה עבור <span dir=\"ltr\">\\(\\displaystyle x&gt;0\\)</span>, ולכן המיתר המחבר את שתי נקודות החיתוך נמצא מעל הגרף ביניהן. לכן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle S=\\int_{{{CT:7}}}^{{{CT:8}}}\\left({{CT:0}}-{{CT:1}}\\right)\\,dx\\)</div>\n<p>פונקציה קדומה היא</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle F(x)=\\frac{{{CT:9}}}{2}x^2+{{CT:10}}x+\\frac{{{CT:3}}}{x}\\)</div>\n<p>ומכאן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px; font-weight: bold;\">\\(\\displaystyle S={{CT:11}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "תשובה מדויקת", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "area", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["area", "leftFrame", "leftI", "mm", "nn", "r", "rightFrame", "rightI", "scale", "third", "xDomain", "xSpan", "yDomain"], "nvariants": 24}