{"id": "212077", "name": "משפט גאוס – שטף דרך שפת תחום חרוטי בין שני מישורים", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "grad", "params": ["qq"], "body": "matrix([diff(qq,x),diff(qq,y),diff(qq,z)])"}, {"name": "div", "params": ["UU"], "body": "diff(UU[1],x)+diff(UU[2],y) + diff(UU[3],z)"}, {"name": "curl", "params": ["UU"], "body": "matrix([diff(UU[3],y) - diff(UU[2],z), diff(UU[1],z) - diff(UU[3],x), diff(UU[2],x) - diff(UU[1],y)])"}, {"name": "U", "params": ["x", "y", "z"], "body": "[(R-2*a)*x+a*x^3/(3*z^2),a*y+b*y^3/(3*z^2),a*z-(R-a)*x^2/z-(R-b)*y^2/z]"}, {"name": "r0", "params": ["p"], "body": "c1/cos(p)"}, {"name": "r1", "params": ["p"], "body": "c2/cos(p)"}, {"name": "integ", "params": ["r", "p", "t"], "body": "R*r^2*sin(p)/(cos(p))^2"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתון שדה וקטורי במרחב&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>ונסמן ב-\\(S\\) את השפה של התחום הבא: </span></span>&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[D= \\left\\{{{CT:1}} \\in \\mathbb{R}^3 \\ | \\ {{CT:2}}(x^2+y^2) \\le {{CT:3}} z^2, \\;\\; {{CT:4}} \\le z \\le &nbsp;{{CT:5}} \\right\\} \\]</span></p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"ltr\">&nbsp;(השפה \\(S\\) היא חלק החרוט \\({{CT:2}}(x^2+y^2) = {{CT:3}} z^2\\) החסום בין מישור \\(z=&nbsp;{{CT:4}}\\) ובין מישור&nbsp;\\(z=&nbsp;{{CT:5}}\\) ביחד עם עם העיגולים המתקבלים מחיתוך &nbsp;\\({{CT:2}}(x^2+y^2) \\le {{CT:3}} z^2\\) במישורים&nbsp;\\(z=&nbsp;{{CT:4}}\\)&nbsp; ו&nbsp;\\(z=&nbsp;{{CT:5}}\\) ).</p><p style=\"direction: rtl; text-align: right;\" dir=\"ltr\">הנה תיאור סכמטי של חלק החרוט + העיגול העליון + העיגול התחתון:</p><p style=\"direction: rtl; text-align: right;\" dir=\"ltr\"><img src=\"data/212077/files/1.png\" alt=\"\" width=\"401\" height=\"300\" role=\"presentation\" class=\"img-fluid atto_image_button_text-bottom\"><br></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium; text-align: center;\">חשבו את השטף של השדה החוצה מן הגוף. כלומר אם \\(N\\) נורמל יחידה למשטח \\(S\\) הפונה החוצה מ-\\(D\\) חשבו את</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\iint\\limits_{S} U \\cdot N d\\sigma = \\) [[input:ans1]] [[validation:ans1]]</p><p dir=\"ltr\"></p>\n<p dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כאשר \\(\\sigma\\) אלמנט השטח לאורך המשטח.</p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">יופי חישבתם את האינטגל נכון.</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">האינטגרל שלכם שגוי. נסו אולי להשתמש במשפט גאוס. את האינטגרל שמתקבל אחרי שימוש במשפט גאוס ניתן לחשב הן במערכת קוארדינטות גלילית והן במערכת קוארדינטות כדורית.&nbsp;</span></p>"}}]}], "qvnames": ["R", "a", "b", "c1", "c2", "p0", "p1", "phi0", "tans1", "vec"], "nvariants": 50}