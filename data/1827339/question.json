{"id": "1827339", "name": "גבול מהצורה 1^∞ – ממוצע חזקות ((aˣ+bˣ+cˣ)/3)^(1/x)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>חשבו את הגבול:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\lim_{x\\to0}\\left(\\frac{{{CT:0}}^x+{{CT:1}}^x+{{CT:2}}^x}{3}\\right)^{1/x} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> זה גבול מהצורה <span dir=\"ltr\">\\(1^\\infty\\)</span>: לוקחים לוגריתם, ומפרקים לגבול מופלא של הלוגריתם ולגבולות מופלאים של פונקציות מעריכיות.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — לוגריתם של הגבול</b><br><p>נסמן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ u\\left(x\\right)=\\frac{{{CT:0}}^x+{{CT:1}}^x+{{CT:2}}^x}{3}-1 \\]</p><p>אז <span dir=\"ltr\">\\(u\\left(x\\right)\\to0\\)</span>. אם <span dir=\"ltr\">\\(L\\)</span> הוא הגבול, נקבל</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\ln L=\\lim_{x\\to0}\\frac{\\ln\\left(1+u\\left(x\\right)\\right)}{x}=\\lim_{x\\to0}\\frac{\\ln\\left(1+u\\left(x\\right)\\right)}{u\\left(x\\right)}\\cdot\\frac{u\\left(x\\right)}{x} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — חישוב</b><br><p>הגורם הראשון שואף ל־<span dir=\"ltr\">\\(1\\)</span>. בנוסף</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\frac{u\\left(x\\right)}{x}=\\frac13\\left(\\frac{{{CT:0}}^x-1}{x}+\\frac{{{CT:1}}^x-1}{x}+\\frac{{{CT:2}}^x-1}{x}\\right) \\]</p><p>ולכן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\ln L=\\frac{\\ln\\left({{CT:0}}\\right)+\\ln\\left({{CT:1}}\\right)+\\ln\\left({{CT:2}}\\right)}{3} \\]</p><p dir=\"ltr\" style=\"text-align:center\">\\[ L=\\sqrt[3]{{{CT:0}}\\cdot{{CT:1}}\\cdot{{CT:2}}}={{CT:3}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "limit", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: if is(equal(radcan(limit),radcan(ans1))) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["a", "b", "c", "limit"], "nvariants": 50}