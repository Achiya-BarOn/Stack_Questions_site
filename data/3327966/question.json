{"id": "3327966", "name": "שימושי האינטגרל – שטח המחייב פיצול לשני אינטגרלים", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_NEW5_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">תחום שהגבול העליון שלו משתנה</div>\n<div style=\"margin-bottom: 10px;\">ברביע הראשון חסום תחום על ידי שלוש העקומות הנתונות. חשבו את שטחו.</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 19px; line-height: 1.9;\">\\(\\displaystyle y={{CT:0}},\\qquad y={{CT:1}},\\qquad y={{CT:2}}\\)</div>\n<div style=\"margin-top: 8px; color: #665f6b; font-size: 14px;\">יש למצוא את שתי נקודות החיתוך עם ההיפרבולה ולפצל את השטח לשני אינטגרלים.</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-bottom: 8px;\">כתבו תשובה מדויקת, ללא קירוב עשרוני.</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">[[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_NEW5_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>הישר התלול יותר חותך את ההיפרבולה בנקודה</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle x_1=\\frac{{{CT:3}}}{{{CT:4}}}={{CT:5}}\\)</div>\n<p>והישר המתון יותר חותך אותה בנקודה</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle x_2=\\frac{{{CT:3}}}{{{CT:6}}}={{CT:7}}\\)</div>\n<p>לכן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle S=\\int_0^{{{CT:5}}}\\left({{CT:0}}-{{CT:1}}\\right)dx+\\int_{{{CT:5}}}^{{{CT:7}}}\\left({{CT:2}}-{{CT:1}}\\right)dx\\)</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle ={{CT:8}}+{{CT:9}}={{CT:10}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 28, "insertstars": 5, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "תשובה מדויקת", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "area", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "A1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "penalty": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<p dir=\"rtl\">חישבת נכון את החלק הראשון של התחום. הגבול העליון משתנה בנקודת החיתוך עם ההיפרבולה, ולכן חסר החלק השני.</p>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 2, "answernote": "Result-2-F", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "A2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "penalty": 0, "nextnode": -1, "answernote": "Result-3-T", "feedback": "<p dir=\"rtl\">חישבת נכון את החלק השני של התחום. חסר החלק שבין שני הישרים מן הראשית ועד החיתוך הראשון עם ההיפרבולה.</p>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-3-F", "feedback": ""}}]}], "qvnames": ["A1", "A2", "area", "gap", "hyp", "low", "p", "q", "t", "up", "x1", "x2"], "nvariants": 36}