{"id": "125229", "name": "חישוב ביטוי לפונקציה ההפוכה", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "aa * x^2  + bb * x + cc"}, {"name": "inverse", "params": ["x"], "body": "(-bb / (2*aa)) + sqrt((x-cc+bb^2 / (4*aa))/aa)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתונה הפונקציה:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[&nbsp; f(x) = {{CT:0}}.\\]</span></p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"ltr\"><span style=\"font-size: medium;\">בתחום&nbsp;</span><span style=\"font-size: medium; text-align: center;\">\\[x \\geq {{CT:1}}\\]&nbsp;</span><span style=\"font-size: medium;\">והטווח \\([{{CT:2}},{{CT:3}})\\).</span></p><p style=\"direction: rtl; text-align: right;\" dir=\"ltr\"><span style=\"font-size: medium;\">מצאו ביטוי לפונקציה ההופכית. השתמשו גם בפונקציה ההופכית במשתנה&nbsp; \\(x\\):</span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(g(x) = f^{-1}(x) = \\) [[input:ans1]] [[validation:ans1]]</span></p>\n<p style=\"text-align: right;\" dir=\"ltr\"><span style=\"font-size: medium;\">&nbsp;</span></p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">התשובה היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y(x) = {{CT:4}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדי למצוא זאת, עלינו לבודד את</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(x\\)</p>\n<p style=\"text-align: right;\" dir=\"rtl\">באופן הבא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y = {{CT:5}} \\]&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y = {{CT:6}} \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y = {{CT:7}} \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {@(y - cc + bb^2 / (4*aa))/aa@}&nbsp; = {{CT:8}} \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כעת אנו משתמשים בנתון ש</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(x \\geq &nbsp;{{CT:1}}\\)</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדי להוציא שורש, ולקבל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {@sqrt((y - cc + bb^2 / (4*aa))/aa)@}&nbsp; = {{CT:9}} \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ x = {@sqrt((y - cc + bb^2 / (4*aa))/aa) - bb/(2*aa)@}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">השלב האחרון הוא החלפת שמות המשתנים, ומתקבלת התשובה.</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 25, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "X:x;\ny:x;\nY:x;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "inverse(x)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["aa", "bb", "cc"], "nvariants": 50}