{"id": "1792276", "name": "גבול עם סינוס – שימוש בגבול מופלא", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "sin(inTheSin) / (theDenom)"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>חשבו את הגבול:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\lim_{x\\to {{CT:0}}}{{CT:1}} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> מסמנים ב-<span dir=\"ltr\">\\(u\\)</span> ביטוי ששואף לאפס, מפרקים לגורם של גבול מופלא ולמנה של פולינומים, ומצמצמים את הגורם המשותף.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הצבה וגבול מופלא</b><br><p>נסמן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ u={{CT:2}} \\]</p><p>כאשר <span dir=\"ltr\">\\(x\\to{{CT:0}}\\)</span>, מתקיים <span dir=\"ltr\">\\(u\\to0\\)</span>. נכתוב</p><p dir=\"ltr\" style=\"text-align:center\">\\[ {{CT:1}}=\\frac{\\sin u}{u}\\cdot\\frac{{{CT:2}}}{{{CT:3}}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — צמצום ומעבר לגבול</b><br><p>הגורם הראשון שואף ל־<span dir=\"ltr\">\\(1\\)</span>, ובגורם השני מצמצמים את <span dir=\"ltr\">\\({{CT:4}}\\)</span>:</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\frac{{{CT:2}}}{{{CT:3}}}=\\frac{{{CT:5}}\\left({{CT:6}}\\right)}{{{CT:7}}\\left({{CT:8}}\\right)} \\]</p><p>לכן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to{{CT:0}}}{{CT:1}}=\\frac{{{CT:5}}}{{{CT:7}}}\\frac{{{CT:9}}}{{{CT:10}}}={{CT:11}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "theLimit", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "-1*ans1", "tans": "theLimit", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.8, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<div dir=\"rtl\">התעלמת מהסימן של השבר!</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-2-F", "feedback": ""}}]}], "qvnames": ["aa", "alpha", "bb", "beta", "cc", "gamma", "inTheSin", "theDenom", "theLimit", "theLimit1"], "nvariants": 50}