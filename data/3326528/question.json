5-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(\\theta_2\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt6", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans6", "tans": "r1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(r_1(\\theta)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt6-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(r_1(\\theta)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt7", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans7", "tans": "r2", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(r_2(\\theta)\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt7-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(r_2(\\theta)\\)</span> — שגוי.</b></div>"}}]}, {"name": "prt8", "value": 3, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans8", "tans": "val", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(I\\)</span> — נכון.</b></div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "prt8-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳, <span dir=\"ltr\">\\(I\\)</span> — שגוי.</b></div>"}}]}], "qvnames": ["J", "a", "a2", "b", "b2", "h", "h2", "k", "k2", "r1", "r2", "th1", "th2", "twoh", "twok", "val", "xuv", "yuv"], "nvariants": 50}