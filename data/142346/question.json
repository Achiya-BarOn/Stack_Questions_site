{"id": "142346", "name": "שטח ברביע הראשון בין ישר לגרף פונקציה, עם גרף", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "x^(-2)"}, {"name": "gg", "params": ["x"], "body": "mm*x + nn"}, {"name": "FF", "params": ["x"], "body": "(mm/2) *x^2 + nn*x + 1/x"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את השטח, ברביע הראשון, החסום בין הישר</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[&nbsp;\\displaystyle{ y = {{CT:0}}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ובין גרף הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\displaystyle{f(x) = {{CT:1}}} \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">{{CT:2}}</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כתבו את תשובתכם כשלם או מנת שלמים, ולא פיתוח עשרוני.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">[[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">נחשב תחילה את נקודות החיתוך בין שני הגרפים.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:1}} = {{CT:0}}\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[(1)\\hspace{1cm}  {{CT:3}}x^3 + {{CT:4}}x^2 - 1 = 0\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אנו לא יודעים לפתור משוואה ממעלה שלישית. ננסה לנחש פתרון </p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ x = 1. \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נציב ונראה שהמשוואה מתקיימת. לכן הפולינום (1) מתחלק (ללא שארית) בפולינום</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ (x-1).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חלוקת פולינומים נותנת:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\frac{{{CT:3}}x^3 + {{CT:4}}x^2 - 1}{x-1} = {{CT:3}}x^2 + x + 1. \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נפתור את המשוואה הריבועית המתקבלת, ונקבל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[x_{1,2} = \\frac{-1\\pm {{CT:5}}}{{CT:6}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אם כן, החיתוכים של הגרפים, ברביע הראשון, הם:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:7}}, {{CT:8}} \\] </p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדי לחשב את השטח, נחשב אינטגרל מסוים של הפרש הפונקציות (תמיד הגבוהה פחות הנמוכה יותר):</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\int_{{CT:7}}^{{CT:8}} {{CT:0}} - {{CT:1}} \\, dx = \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ = {{CT:9}} \\Big|_{{CT:7}}^{{CT:8}}= {{CT:10}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "area", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["area", "downFrame", "kk", "kpo", "leftFrame", "leftIntercept", "mm", "nn", "pp", "rightFrame", "rightIntercept", "theLimit", "upFrame", "xDomain", "xSpan", "yDomain"], "nvariants": 24}