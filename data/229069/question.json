{"id": "229069", "name": "פירוק פולינום לגורמים - מעלה 2", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randcomplex", "params": ["n"], "body": "block([re,im],re: rand_with_prohib(-n,n,[]),im: rand_with_prohib(-n,n,[]),re + im*%i)"}, {"name": "randcomplexnonzero", "params": ["n"], "body": "block([re,im],re: rand_with_prohib(-n,n,[]),im: rand_with_prohib(-n,n,[0]),re + im*%i)"}, {"name": "pp", "params": ["z"], "body": "simplify((z - aa)*(z-bb))"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">נתון הפולינום המרוכב</p>\n<p style=\"text-align: center;\" dir=\"rtl\">\\(p(z)={{CT:0}}\\)</p>\n<p style=\"text-align: right;\" dir=\"rtl\">מצאו את הגורמים האי פריקים של הפולינום מעל \\(\\mathbb{R}\\):<br></p>\n<p style=\"text-align: right;\" dir=\"ltr\">[[input:ans1]] [[validation:ans1]]</p><p style=\"text-align: left;\" dir=\"ltr\">\n</p><p dir=\"rtl\" style=\"text-align: right;\">מצאו את הגורמים האי פריקים של הפולינום מעל \\(\\mathbb{C}\\):<br></p>\n<p dir=\"ltr\">[[input:ans2]] [[validation:ans2]]</p><p dir=\"ltr\"><br></p><p dir=\"rtl\" style=\"text-align: right;\"><b></b></p><p dir=\"rtl\"><b>אופן הזנת התשובה: </b>הזינו\n את הגורמים ברשימה בין סוגריים מרובעים מופרדים בפסיקים. גם אם לדעתכם יש\nרק גורם אחד, הזינו אותו בין סוגריים מרובעים. לדוגמה, אם אתם חושבים\nשהפולינום \\(p(z) = (z-i)^2(z+2i)\\) הזינו</p><p dir=\"rtl\" style=\"text-align: left;\">\\[&nbsp; [z - \\%i, z - \\%i, z + 2*\\%i] \\]<br></p><p></p><p dir=\"rtl\"><b>הערה נוספת</b>: כדי לכתוב חזקה הזינו פעמיים את סימן הכפל, לדוגמה כדי לכתוב \\(z^2\\) הזינו z**2.</p><p style=\"text-align: left;\" dir=\"ltr\"><br></p>", "generalfeedback": "", "specificfeedback": "<p>פירוק מעל הממשיים:<br></p><p>[[feedback:prt1]]</p><p><br></p><p>פירוק מעל המרוכבים:</p><p>[[feedback:prt2]]<br></p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "^", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "sort(ans1)", "tans": "sort(rans)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">התשובה נכונה<br></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">התשובה אינה נכונה</p>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "sort(ans2)", "tans": "sort(cans)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "התשובה נכונה<br>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<p>התשובה איננה נכונה<br></p>"}}]}], "qvnames": ["aa", "bb", "cans", "dummy", "kk", "must_be_complex", "rans"], "nvariants": 50}