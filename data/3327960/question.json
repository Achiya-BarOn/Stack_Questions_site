{"id": "3327960", "name": "הפרדת משתנים – arcsin ושורש, משפחת פתרונות", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q8_NEW6_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">הצבה טריגונומטרית טבעית בתוך מד״ר פרידה</div>\n<div style=\"margin-bottom: 10px;\">בנוסף למשפחה המבוקשת קיים הפתרון הקבוע <span dir=\"ltr\">\\(y=0\\)</span>. מצאו את משפחת הפתרונות שאינם זהותית אפס.</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 19px; line-height: 1.9;\">\\(\\displaystyle {{CT:0}}\\)</div>\n<div style=\"margin-top: 8px; color: #665f6b; font-size: 14px;\">עבדו בתחום <span dir=\"ltr\">\\(\\displaystyle -{{CT:1}} והשתמשו באות <span dir=\"ltr\"><strong>c</strong></span>.</span></div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle y(x)=\\) [[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q8_NEW6_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 14px 18px; margin-bottom: 12px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>מפרידים משתנים ומציבים</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle u=\\arcsin\\left(\\frac{x}{{{CT:1}}}\\right),\\qquad du=\\frac{dx}{\\sqrt{{{CT:1}}^2-x^2}}\\)</div>\n<p>לכן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle \\int\\frac{dy}{y^2}={{CT:2}}\\int u\\,du\\)</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle -\\frac1y={{CT:3}}u^2+C\\)</div>\n<p>ולאחר שינוי שם הקבוע</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px; font-weight: bold;\">\\(\\displaystyle y(x)={{CT:4}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 40, "insertstars": 5, "forbidfloat": true, "forbidwords": "diff", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "ביטוי ב-x הכולל c", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "res:radcan(sqrt(rr^2-x^2)*diff(ans1,x)-2*kk*ans1^2*asin(x/rr));\ncnst:ev(diff(ans1,c)^2+diff(ans1,C)^2,simp);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "res", "tans": "0", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0.8, "nextnode": 1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0