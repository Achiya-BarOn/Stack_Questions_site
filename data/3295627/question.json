: "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "py-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ —</b> <b>סעיף א׳ —</b> בדקו שוב את הערך של <span dir=\"ltr\">\\(y_0\\)</span>.</div>"}}]}, {"name": "pz", "value": 0.2, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans3", "tans": "tans3", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "pz-1-T", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ —</b> <b>סעיף א׳ —</b> הערך של <span dir=\"ltr\">\\(z_0\\)</span> נכון.</div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "pz-1-F", "feedback": "<div dir=\"rtl\"><b>סעיף א׳ —</b> <b>סעיף א׳ —</b> בדקו שוב את הערך של <span dir=\"ltr\">\\(z_0\\)</span>.</div>"}}]}], "qvnames": ["L", "P0", "Vmax", "Vx", "Vxy", "Vy", "a", "b", "c", "d", "eqx", "eqy", "m", "planeDisplay", "tans1", "tans2", "tans3", "tans4", "x0", "y0", "z0", "zxy"], "nvariants": 50}