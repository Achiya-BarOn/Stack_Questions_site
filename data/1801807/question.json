{"id": "1801807", "name": "נגזרת של אינטגרל מ a עד g(x)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["t"], "body": "funcs[ii]"}, {"name": "ffx", "params": ["x"], "body": "at(ff(t),t=x)"}, {"name": "gg", "params": ["x"], "body": "at(funcs[jj],t=x)"}, {"name": "gDeriv", "params": ["x"], "body": "diff(gg(x),x)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;<span style=\"font-size: 0.9375rem;\">אנו נשתמש בסימון המקובל עבור הנגזרת:</span></p><p dir=\"rtl\"></p><p dir=\"rtl\"></p><p dir=\"ltr\" style=\"text-align: center;\">\\[ \\frac{d}{dx} f(x)\\equiv f'(x).\\]</p><p></p><p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">חשבו את הנגזרת הבאה(\\(a\\) שרירותי כך שהאינטגרל בין \\(a\\) ל {{CT:0}} מוגדר):</span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\displaystyle{\\frac{d}{dx} \\int_a^{{CT:1}} {{CT:2}} \\, dt} = \\] [[input:ans1]] [[validation:ans1]]</p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"ltr\">&nbsp;הזינו תשובתכם עם משתנה \\(x\\).</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">המשפט היסודי של החדו\"א אומר שאם&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[f(x)\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">רציפה בקטע&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ [a,b]\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אז הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F(x) := \\int_a^x f(t)\\,dt \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">היא גזירה בקטע&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ (a,b), \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ונגזרתה היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F'(x) = f(x). \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נסמן</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ f(t) = {{CT:2}},\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[g(x) = {{CT:1}},\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F(x) := \\int_a^x f(t)\\,dt.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הפונקציה שאנו מתבקשים לגזור היא, אם כן:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[F(g(x)).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נגזור לפי כלל השרשרת, ונקבל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{d}{dx} F( g(x))&nbsp; = F'(g(x)) \\cdot g'(x) = f(g(x)) \\cdot g'(x)&nbsp; \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ = f({{CT:1}}) \\cdot {{CT:3}} = {{CT:4}}. \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "radcan(ans1)", "tans": "radcan(result)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["funcs", "ii", "jj", "result"], "nvariants": 30}