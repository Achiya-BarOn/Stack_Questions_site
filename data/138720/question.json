{"id": "138720", "name": "רציפות של פונקציה מקוטעת x²−1 ו-ax – מציאת פרמטר (א)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "leftFunc", "params": ["x"], "body": "x^2 -1"}, {"name": "rightFunc", "params": ["x"], "body": "a*x"}, {"name": "num_factored", "params": ["x"], "body": "(x-aa)*(x-bb)"}, {"name": "numa", "params": ["x"], "body": "ev(num_factored(x),expand)"}, {"name": "denom_factored", "params": ["x"], "body": "(x-bb)*(x-cc)"}, {"name": "denoma", "params": ["x"], "body": "ev(denom_factored(x),expand)"}, {"name": "ff", "params": ["x"], "body": "(numa(x))/(denoma(x))"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">נתונה הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ f(x) = \\begin{cases} {{CT:0}}, &amp; x&lt;{{CT:1}}\\\\ {{CT:2}}, &amp; x \\geq {{CT:1}}.\\end{cases}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את הערך של</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[a\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">עבורו הפונקציה רציפה בכל תחום הגדרתה.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\( a = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">הפונקציה רציפה בנקודה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[x_0={{CT:1}}\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אם</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ f({{CT:1}}) = \\lim_{x\\to {{CT:1}}} f(x).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אגף שמאל הוא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ f({{CT:1}}) = {{CT:1}} a.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדי שהגבול באגף ימין יהיה קיים, שני הגבולות החד צדדיים צריכים להיות קיימים, ושווים זה לזה.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\lim_{x\\to {{CT:1}}+} f(x) = \\lim_{x\\to {{CT:1}}+} {{CT:2}} = {{CT:3}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\lim_{x\\to {{CT:1}}-} f(x) = \\lim_{x\\to {{CT:1}}-} {{CT:0}} = {{CT:4}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אם כן, כדי שהפונקציה תהיה רציפה, צריך להתקיים:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ {{CT:4}} = {{CT:3}},\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כלומר</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ a = {{CT:5}}.\\]</p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "aa", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["aa", "bb", "cc", "correctLimit", "xx"], "nvariants": 50}