{"id": "128039", "name": "חישוב הצגה פולרית - העתק למטרת הכפלת השאלה בבוחן 2", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"></p><p dir=\"rtl\">נתון המספר המרוכב \\(z={{CT:0}}\\). מצאו את הייצוג הפולרי שלו&nbsp;</p><p dir=\"rtl\" style=\"text-align: center;\">&nbsp;\\(z=r\\cdot \\text{cis}(\\theta)=r\\cdot e^{i\\cdot \\theta}\\)</p><p dir=\"rtl\"><span>שימו לב שהזווית נמדדת ברדיאנים, ולא במעלות (180 מעלות = 1 רדיאן).</span></p><p dir=\"rtl\"></p><p dir=\"rtl\"></p><p dir=\"ltr\" style=\"text-align: center;\">\\(r\\)=[[input:ans1]] [[validation:ans1]]</p><p dir=\"ltr\" style=\"text-align: center;\">\\(\\theta\\)=[[input:ans2]] [[validation:ans2]]</p><p dir=\"rtl\">&nbsp;</p><p dir=\"rtl\" style=\"direction: rtl;\">הערה: הדרך להזין&nbsp; \\(\\pi\\) היא pi. הדרך להזין שורש \\({{CT:1}}\\) היא&nbsp;sqrt(a). הדרך להזין כפל \\({{CT:2}}\\) היא&nbsp;a*b.&nbsp;הדרך להזין שבר \\({{CT:3}}\\) היא&nbsp;a/b.</p><p style=\"text-align: left;\" dir=\"ltr\"></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "rr", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0.5, "nextnode": 1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הרדיוס \\(r\\) שסיפקת נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הרדיוס&nbsp;\\(r\\) שסיפקת שגוי.</p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "e^(%i*ans2)", "tans": "e^(%i*theta)", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הזוית \\(\\theta\\) שסיפקת נכונה.</p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">הזוית \\(\\theta\\) שסיפקת שגויה.</p>"}}]}], "qvnames": ["cartesian", "rr", "theta"], "nvariants": 50}