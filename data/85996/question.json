: 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "q:exp(v);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "Int", "sans": "ans1", "tans": "int(p,v)+c", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-F", "feedback": ""}}]}], "qvnames": ["p", "v"], "nvariants": 1}