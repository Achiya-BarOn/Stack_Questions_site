gEquiv", "sans": "ans8", "tans": "sqrt(r3^2-x^2)", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt8-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt8-1-F", "feedback": ""}}]}, {"name": "prt9", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans9", "tans": "4*%pi*r3^3/3", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt9-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt9-1-F", "feedback": ""}}]}], "qvnames": ["h1", "r1", "r3"], "nvariants": 50}