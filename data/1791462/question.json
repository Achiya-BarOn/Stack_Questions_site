iv style=\"margin-top: 10px; padding-top: 9px; border-top: 1px solid #EEECEF;\">\n<div style=\"font-size: 13px; font-weight: bold; color: #665f6b; margin-bottom: 4px;\">בדיקת ההקלדה</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center;\">[[validation:ans1]]</div>\n</div>\n</div>\n<div style=\"background: #FAF9FB; border: 1px solid #EEECEF; border-radius: 10px; padding: 14px; margin: 12px 0;\">\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 17px;\">\\(\\displaystyle \\left(g\\circ f\\right)\\left(x\\right)=\\) [[input:ans2]]</div>\n<div style=\"margin-top: 10px; padding-top: 9px; border-top: 1px solid #EEECEF;\">\n<div style=\"font-size: 13px; font-weight: bold; color: #665f6b; margin-bottom: 4px;\">בדיקת ההקלדה</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center;\">[[validation:ans2]]</div>\n</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width: 980px; margin: 0 auto; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q3_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 18px;\">\n<div style=\"font-size: 19px; font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">פתרון מלא</div>\n<div style=\"font-size: 13px; color: #665f6b; margin-top: 3px;\">הרכבת פונקציות – שני כיוונים</div>\n</div>\n<div style=\"background: #FFFFFF; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 16px;\">\n<p>בהרכבה \\(\\displaystyle \\left(f\\circ g\\right)\\left(x\\right)\\) מציבים את \\(\\displaystyle g\\left(x\\right)\\) בכל מקום שבו מופיע x בתוך f. בהרכבה השנייה עושים את ההפך.</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 2; margin: 8px 0; overflow-x: auto;\">\\(\\displaystyle \\left(f\\circ g\\right)\\left(x\\right)={{CT:2}}\\)</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 2; margin: 8px 0; overflow-x: auto;\">\\(\\displaystyle \\left(g\\circ f\\right)\\left(x\\right)={{CT:3}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\" style=\"margin-top: 12px;\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 25, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 25, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "X:x;\ny:x;\nY:x;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "fcompg", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 0.5, "penalty": 0, "nextnode": 1, "answernote": "Result-0-T ", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">ההרכבה f∘g נכונה.</div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": "<div dir=\"rtl\" style=\"text-align: right;\">בהרכבה f∘g יש להציב את g(x) בתוך f, ולא להפך.</div>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans2", "tans": "gcompf", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote":