{"id": "211956", "name": "שטף דרך פיסת פרבולואיד מעל מלבן", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "proj", "params": ["x", "y"], "body": "((x.y)/(y.y))*y"}, {"name": "x", "params": ["u", "v"], "body": "u"}, {"name": "y", "params": ["u", "v"], "body": "v"}, {"name": "z", "params": ["u", "v"], "body": "R-u^2-v^2"}, {"name": "X", "params": ["u", "v"], "body": "transpose([x(u,v),y(u,v),z(u,v)])"}, {"name": "U1", "params": ["x", "y", "z"], "body": "x*y"}, {"name": "U2", "params": ["x", "y", "z"], "body": "y*z"}, {"name": "U3", "params": ["x", "y", "z"], "body": "x*z"}, {"name": "U", "params": ["x", "y", "z"], "body": "[U1(x,y,z),U2(x,y,z),U3(x,y,z)]"}, {"name": "Xu", "params": ["u", "v"], "body": "[diff(x(u,v),u), diff(y(u,v),u),diff(z(u,v),u)]"}, {"name": "Xv", "params": ["u", "v"], "body": "[diff(x(u,v),v), diff(y(u,v),v),diff(z(u,v),v)]"}, {"name": "W", "params": ["u", "v"], "body": "factor(crossprod(Xu(u,v),Xv(u,v)))"}, {"name": "integ", "params": ["u", "v"], "body": "factor(U(x(u,v),y(u,v),z(u,v)).W(u,v))"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את השטף של השדה הווקטורי&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">דרך פיסת הפרבולואיד:&nbsp; &nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[S= \\left\\{{{CT:1}}\\in \\mathbb{R}^3 \\; \\left| \\; \\begin{array}{c}{{CT:2}} \\le x \\le {{CT:3}}\\\\ {{CT:4}} \\le y \\le {{CT:5}}\\\\ \\\\ z={{CT:6}} \\end{array}\\right.\\right\\}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p dir=\"ltr\" style=\"text-align: center;\">\\(\\iint\\limits_{S} U \\cdot N d\\sigma = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p dir=\"ltr\" style=\"direction: rtl;\">עם נורמל \\(N\\) בכיוון החיצוני של ההפרבולואיד.&nbsp;</p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\">כאשר \\(\\sigma\\) אלמנט השטח לאורך המשטח.</p><p style=\"text-align: right;\" dir=\"rtl\"><br></p><p style=\"text-align: right;\" dir=\"rtl\">הכיוון החיצוני של ההפרבולואיד מתואר באיור הבא (אפשרי לשחק עם הפרמטרים לקבל נורמלים בנקודות שונות):</p><p style=\"text-align: right;\" dir=\"rtl\"><br></p>\n<iframe src=\"https://www.geogebra.org/calculator/awbrxaze?embed\" width=\"800\" height=\"600\" allowfullscreen=\"\" style=\"border: 1px solid #e4e4e4;border-radius: 4px;\" frameborder=\"0\"></iframe>", "generalfeedback": "<p dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בכדי לחשב את האיטגרל הזה יש למצוא ראשית פרמטריזציה לפיסת המשטח. במקרה שלנו מאחר ומדובר בגרף של פונקציה הדבר קל:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[X(u,v)={{CT:7}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">מיד נמצא גם את הווקטורים המשיקים למשטח.</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[X_u = {{CT:8}}, X_v={{CT:9}} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נורמל למשטח מתקבל כמכפלה וקטורית של שני אילו</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[X_u \\times X_v = {{CT:10}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">וכעת השטף הוא האינטגרל על ידי המכפלה המשולבת. שימו לב, שהנורמל \\(X_u \\times X_v \\) הוא אכן בכיוון החיצוני .</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\int_{S} U \\cdot N d \\sigma =&nbsp;\\int_{{{CT:4}}}^{{{CT:5}}}&nbsp;\\int_{{{CT:2}}}^{{{CT:3}}} U(X(u,v)) \\cdot (X_u((u,v)) \\times X_v((u,v)))&nbsp; \\ du&nbsp; \\ dv \\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[=&nbsp;\\int_{{{CT:4}}}^{{{CT:5}}}&nbsp;\\int_{{{CT:2}}}^{{{CT:3}}} {{CT:11}} \\ du&nbsp; \\ dv = {{CT:12}}\\]</span></p>", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good: is(ans1=tans1);\nalmost: is(ans1=-tans1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "good", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">יופי חישבתם את האינטגל נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\"></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "almost", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "כמעט, יצא מינוס התשובה הנכונה.<p dir=\"rtl\" style=\"text-align: right;\"></p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">האינטגרל שלכם שגוי.&nbsp;<br></p>"}}]}], "qvnames": ["R", "a", "b", "tans1", "u0", "u1", "v0", "v1", "vec"], "nvariants": 50}