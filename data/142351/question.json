{"id": "142351", "name": "שטח בין שתי פרבולות x(x−k) ו-−x(x−k), עם גרף", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x"], "body": "expand(x*(x-kk))"}, {"name": "gg", "params": ["x"], "body": "expand(-x*(x-kk))"}, {"name": "FF", "params": ["x"], "body": "2*(kk/2 *x^2 - x^3 /3)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את השטח הכלוא בין הפרבולות</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\displaystyle{ f(x) = {{CT:0}}} \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\displaystyle{ g(x) = {{CT:1}}}\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">{{CT:2}}</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כתבו את תשובתכם כשלם או מנת שלמים, ולא פיתוח עשרוני.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">[[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">נחשב תחילה את נקודות החיתוך בין שני הגרפים.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[{{CT:0}} = {{CT:1}}\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[2x^2 -2\\cdot {{CT:3}} x = 0\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[2x(x -{{CT:3}}) = 0\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">והפתרונות הם:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ x=0, \\hspace{1cm} x={{CT:3}}.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כלומר, נקודות החיתוך בין הפרבולות הן:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[(0,0), \\hspace{1cm} ({{CT:3}},0).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדי לחשב את השטח, נחשב אינטגרל מסוים של הפרש הפונקציות (תמיד הגבוהה פחות הנמוכה יותר):</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\int_{0}^{{CT:3}} g(x) - f(x) \\, dx = \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\int_{0}^{{CT:3}} {{CT:1}} - ({{CT:0}}) \\, dx = \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ = {{CT:4}} \\Big|_{0}^{{CT:3}}= {{CT:5}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "area", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["area", "downFrame", "kk", "leftFrame", "rightFrame", "upFrame", "xDomain", "yDomain"], "nvariants": 5}