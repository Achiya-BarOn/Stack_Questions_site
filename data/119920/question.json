{"id": "119920", "name": "אינטגרל לא מסוים – צירוף של חזקות ושורש של t", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>חשבו, ואל תשכחו את הקבוע</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\int {{CT:0}}\\,d{{CT:1}} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">לינאריות האינטגרל</b><br><p>לפי לינאריות האינטגרל:</p><div style=\"background:#FFF8E6;border:1px solid #E8D29A;border-radius:10px;padding:10px 14px;margin:12px 0\">לינאריות האינטגרל: <span dir=\"ltr\">\\(\\int (af(x)+bg(x))\\,dx=a\\int f(x)\\,dx+b\\int g(x)\\,dx\\)</span></div><p dir=\"ltr\" style=\"text-align:center\">\\[ \\begin{aligned} \\int {{CT:0}} d{{CT:1}} &= \\int {{CT:2}} d{{CT:1}} + \\int {{CT:3}} d{{CT:1}} + \\int {{CT:4}} d{{CT:1}} \\\\ &= {{CT:5}}\\int {{CT:6}} d{{CT:1}} + \\left({{CT:7}}\\right)\\int {{CT:8}} d{{CT:1}} + \\int {{CT:4}} d{{CT:1}} \\\\ &= {{CT:9}} + \\left({{CT:10}}\\right) + {{CT:11}} +c \\\\ &= {{CT:12}} \\end{aligned} \\]</p></div></div>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה נכונה</p>\n<p style=\"text-align: right;\"> </p>", "prtpartiallycorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "varss:listofvars(ans1);\nvarss:delete(C,delete(c,varss));\nan1:ans1;\nfor i:1 while i<=length(varss) do an1:ev(an1,varss[i]=v);\n\nstu:ev(diff(an1,v));\nc1:ev(diff(an1,c));\nc2:ev(diff(an1,C));\nd:c1^2+c2^2;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "stu", "tans": "p", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "nextnode": 1, "answernote": "Result-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "d", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "Result-2-F", "feedback": ""}}]}], "qvnames": ["p", "pp1", "pp2", "pp3", "ppp1", "ppp2", "rdm1", "rdm2", "rdm3", "rdm4", "v"], "nvariants": 50}