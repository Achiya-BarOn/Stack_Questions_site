{"id": "126646", "name": "Linear_FO_ODE 2", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"text-align: right;\"><span class=\"\" style=\"color: rgb(0, 0, 0);\">&nbsp;</span></p>\n<p style=\"text-align: right;\"><span class=\"\" style=\"color: rgb(0, 0, 0);\">מצאו את הפתרון הכללי של המשוואה הדיפרנציאלית</span></p>\n<h6><span class=\"\" style=\"color: rgb(0, 0, 0);\">\\[ {{CT:0}}y+y'=e^{{{CT:1}}\\cdot x}\\]</span></h6>\n<p style=\"text-align: right;\"><span class=\"\" style=\"color: rgb(0, 0, 0);\">השתמשו באות</span></p>\n<p style=\"text-align: right;\"><span class=\"\" style=\"color: rgb(0, 0, 0);\">c</span></p>\n<p style=\"text-align: right;\"><span class=\"\" style=\"color: rgb(0, 0, 0);\">כדי לציין את הקבוע</span></p>\n<p style=\"text-align: left;\"><span class=\"\" style=\"color: rgb(0, 0, 0);\">y(x) = [[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "<p>&nbsp;</p>\n<p>&nbsp;</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "c(t):=C*t;\n\nan1:ev(ans1,tt=3);\nvarsl:listofvars(expand(an1));\nbvars:sort(listify(setdifference(setify(varsl),setify([x,c]))));\nan1:expand(an1);\n\nwvars:setify([X,t,T,x1,X1,x2,X2]);\nwcon:setify([C1,k1,K1,A,a,C])\n\nfor i:1 while i<=length(bvars) do (if elementp(bvars[i],wvars) then  an1:ev(an1,bvars[i]=x) else (if elementp(bvars[i],wcon) then  an1:ev(an1,bvars[i]=c)));\n\ncor:expand(ev(n1*an1+diff(an1,x)-e^(n2*x),simp));\ncnst:ev(diff(an1,c)^2+diff(an1,C)^2);\n", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "cor", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0.7, "nextnode": 1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<p style=\"direction: rtl; text-align: right;\">הפונקציה שכתבתם לא פותרת את המשוואה.<br></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "cnst", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<p style=\"direction: rtl; text-align: right;\">חסר לכם קבוע!<br></p>"}, "on_false": {"scoremode": "+", "score": 0.3, "nextnode": -1, "answernote": "Result-2-F", "feedback": "<p style=\"text-align: right; direction: rtl;\">תשובה נכונה, כל הכבוד!<br></p>"}}]}], "qvnames": ["correctanswer", "n1", "n2"], "nvariants": 48}