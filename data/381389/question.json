{"id": "381389", "name": "tangent", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f", "params": ["x"], "body": "a*x^2+b*x^3"}, {"name": "l", "params": ["x"], "body": "a+b+(x-1)*(2*a+3*b)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתונה הפונקציה הבאה </span><span style=\"font-size: medium;\">\\(f(x)={{CT:0}}\\). </span><span style=\"font-size: medium;\">נסמן ב-</span><span style=\"font-size: medium;\">\\(\\ell\\) </span><span style=\"font-size: medium;\">את הישר המשיק לגרף של הפונקציה בנקודה </span><span style=\"font-size: medium;\">\\(x=1\\).</span></p>\n<p style=\"text-align: right;\" dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">מבין כל הנקודות הבאות במישור יש בדיוק אחת שיושבת על הישר המשיק הזה. סמנו אותה. <strong>לדוגמה</strong> בחירה של התשובה </span><span style=\"font-size: medium;\">\\({{CT:1}}\\) </span><span style=\"font-size: medium;\">משמעותה שהנקודה </span><span style=\"font-size: medium;\">\\(x=3,y=2\\) היא הנקודה ש</span><span style=\"font-size: medium;\">נמצאת על הישר המשיק האמור. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד. <strong><br /></strong></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. <br /></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"> </p>\n<p><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "8", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.15, "nextnode": -1, "answernote": "prt1-2-T", "feedback": ""}, "on_false": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": ""}}]}], "qvnames": ["P", "a", "b", "dem", "q", "q1", "q2", "ta_multiple", "ta_multiple_correct", "tans1", "w1", "w2", "w3", "w4", "w5", "w6"], "nvariants": 50}