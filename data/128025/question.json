{"id": "128025", "name": "פתרון יחיד של מערכת 2×2 מעל המרוכבים", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randcomplex", "params": ["k"], "body": "block([re,im],re: rand_with_step(-k,k,1),im: rand_with_step(-k,k,1),re + im*%i)"}, {"name": "randcomplexnonzero", "params": ["k"], "body": "block([re,im],re: rand_with_prohib(-k,k,[0]),im: rand_with_step(-k,k,1),re + im*%i)"}, {"name": "switchRowsMatrix", "params": ["height", "r1", "r2"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1]: ident(height)[r2],tempMat[r2]: ident(height)[r1],tempMat)"}, {"name": "rowMultMatrix", "params": ["height", "r", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r]: alpha*tempMat[r],tempMat)"}, {"name": "rowAddMatrix", "params": ["height", "r1", "r2", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1][r2]: alpha,tempMat)"}, {"name": "scrambleMatrix", "params": ["height", "numOfActions"], "body": "block([mat, actions],mat:ident(height),for i:1 thru numOfActions do(mat:mat.block([choice, rows], choice: rand([1,2,3]),rows: nChooseK(height, 2),if (choice = 1) then switchRowsMatrix(height,rows[1],rows[2]) elseif (choice = 2) then rowMultMatrix(height,rows[1],randcomplexnonzero(scalarSize)) else rowAddMatrix(height,rows[1],rows[2],randcomplex(scalarSize)))),mat)"}, {"name": "randToHead", "params": ["list"], "body": "block([x],x: rand(list),list: delete(x,list),cons(x,list))"}, {"name": "permuteList", "params": ["list"], "body": "block([newlist],newlist: [],for i:1 unless (list = []) do(list: randToHead(list),push(pop(list),newlist)),newlist)"}, {"name": "nChooseK", "params": ["dm", "rank"], "body": "block([cols],cols: makelist(i,i,dm),rest(permuteList(cols),-(dm-rank)))"}, {"name": "eqs", "params": ["i"], "body": "(lhs:sum (exMat[i,j]*vars[j],j,1,n),rhs:exMat[i,n+1],lhs=rhs)", "array": true}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונה מערכת המשוואות המרוכבת הבאה:</p><p dir=\"ltr\" style=\"text-align:center\">{{CT:0}}</p><p dir=\"ltr\" style=\"text-align:center\">{{CT:1}}</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>נתון כי למערכת יש פתרון יחיד. מצאו אותו:</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(z_1=\\) [[input:ans1]] &nbsp;&nbsp;&nbsp;&nbsp; \\(z_2=\\) [[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]] [[validation:ans2]]</div><p style=\"font-size:0.92em;margin:8px 0 0\">הערה: הדרך להזנת המספר המרוכב <span dir=\"ltr\">\\(a+b\\cdot i\\)</span> היא <code dir=\"ltr\">a+b*i</code>.</p></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> זו מערכת של שתי משוואות בשני נעלמים, ולכן נוח לפתור אותה בכלל קרמר: מחשבים את הדטרמיננטה של מטריצת המקדמים ואת שתי הדטרמיננטות שמתקבלות מהחלפת עמודה בעמודת האגף הימני, ומחלקים.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — מטריצת המקדמים והדטרמיננטה שלה</b><br>מטריצת המקדמים ועמודת האגף הימני הן<p dir=\"ltr\" style=\"text-align:center\">\\[ A={{CT:2}},\\qquad b={{CT:3}} \\]</p>לכן<p dir=\"ltr\" style=\"text-align:center\">\\[ D=\\det A=\\left({{CT:4}}\\right)\\left({{CT:5}}\\right)-\\left({{CT:6}}\\right)\\left({{CT:7}}\\right)=\\left({{CT:8}}\\right)-\\left({{CT:9}}\\right)={{CT:10}} \\]</p>הדטרמיננטה שונה מאפס, ולכן למערכת יש פתרון יחיד, כפי שנתון.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — הדטרמיננטות של כלל קרמר</b><br>מחליפים את העמודה הראשונה של <span dir=\"ltr\">\\(A\\)</span> בעמודה <span dir=\"ltr\">\\(b\\)</span> כדי לקבל את <span dir=\"ltr\">\\(D_1\\)</span>, ואת העמודה השנייה כדי לקבל את <span dir=\"ltr\">\\(D_2\\)</span>:<p dir=\"ltr\" style=\"text-align:center\">\\[ D_1=\\det{{CT:11}}=\\left({{CT:12}}\\right)-\\left({{CT:13}}\\right)={{CT:14}} \\]</p><p dir=\"ltr\" style=\"text-align:center\">\\[ D_2=\\det{{CT:15}}=\\left({{CT:16}}\\right)-\\left({{CT:17}}\\right)={{CT:18}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 3 — הפתרון</b><br>לפי כלל קרמר <span dir=\"ltr\">\\(z_1=\\frac{D_1}{D}\\)</span> ו-<span dir=\"ltr\">\\(z_2=\\frac{D_2}{D}\\)</span>, ולכן הפתרון היחיד הוא<p dir=\"ltr\" style=\"text-align:center\">\\[ z_1=\\frac{D_1}{D}={{CT:19}},\\qquad z_2=\\frac{D_2}{D}={{CT:20}} \\]</p></div></div>", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "solve", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "a+b*i", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "a+b*i", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: is(sols[1][1] = ans1) and is(sols[2][1] = ans2);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\">התשובה נכונה</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">התשובה אינה נכונה</div>"}}]}], "qvnames": ["exMat", "n", "sA", "sD", "sD1", "sD2", "sP11", "sP12", "sQ11", "sQ12", "sQ21", "sQ22", "sZ1", "sZ2", "scalarSize", "scrambleActions", "sols", "vars"], "nvariants": 50}