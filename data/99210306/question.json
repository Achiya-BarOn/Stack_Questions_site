note": "prt3-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt3-1-F", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans3", "tans": "if w3=t3 then -1 else w3", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt3-2-T", "feedback": "<p>זו ההסתברות שחולצה פגומה של מפעל B היא ממשמרת היום. כאן לא נתון שהחולצה ממפעל B.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt3-2-F", "feedback": ""}}]}], "qvnames": ["PD", "aa", "dA", "dD", "dN", "pB", "ss", "t2", "t3", "w3"], "nvariants": 50}