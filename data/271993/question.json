{"id": "271993", "name": "קירוב לינארי", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "f1", "params": ["x", "y", "z"], "body": "func1"}, {"name": "f2", "params": ["x", "y", "z"], "body": "func2"}, {"name": "F", "params": ["x", "y", "z"], "body": "matrix([f1(x,y,z)],[f2(x,y,z)])"}, {"name": "df", "params": ["x", "y", "z"], "body": "matrix([diff(f1(x,y,z),x), diff(f1(x,y,z),y), diff(f1(x,y,z),z)], [diff(f2(x,y,z),x), diff(f2(x,y,z),y), diff(f2(x,y,z),z)])"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתונה הפונקציה</span></p>\n<p style=\"direction: ltr; text-align: center;\" dir=\"rtl\"><span style=\"font-size: medium;\"> \\(F:\\mathbb{R}^3 \\rightarrow \\mathbb{R}^2\\)</span>&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"rtl\"><span style=\"font-size: medium;\">\\[F(x,y,z)={{CT:0}}\\]</span></p>\n<p style=\"text-align: center;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">נתבונן בנקודות</span></p>\n<p style=\"text-align: center;\" dir=\"rtl\"><span style=\"font-size: medium;\">\\[p_0 = {{CT:1}},\\qquad p={{CT:2}} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את ערך הפונקציה בנקודת הבסיס \\( p_0\\):&nbsp;</span></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>שימו לב:</strong>&nbsp;כתבו את תשובתכם (בכל מקום בתרגיל) כביטוי מתמטי מדויק ולא כתיב עשרוני X.XX.<br></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"direction: ltr; text-align: center;\" dir=\"rtl\">\\(F(p_0)\\) =[[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;כעת העריכו, תוך שימוש בנוסחת הקירוב הלינארי:</p>\n<p dir=\"rtl\"></p>\n<p dir=\"rtl\"></p>\n<p dir=\"rtl\" style=\"text-align: center;\">\\[F(p)\\cong L{p_0}(p):=F(p_0)+ DF(p-p_0) \\]&nbsp;</p>\n<p dir=\"rtl\">את הערך של הפונקציה בנקודה&nbsp;\\(p\\).</p>\n<p dir=\"rtl\"></p>\n<p dir=\"rtl\"></p>\n<p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"direction: ltr; text-align: center;\" dir=\"rtl\">\\(L_{p_0}(p) = \\)[[input:ans2]]</p>\n<p style=\"text-align: center;\" dir=\"rtl\">[[validation:ans2]]</p>", "generalfeedback": "", "specificfeedback": "<p dir=\"ltr\"><span style=\"font-size: medium;\">[[feedback:prt1]]</span></p>\n<p dir=\"ltr\"><span style=\"font-size: medium;\">[[feedback:prt2]]</span></p>", "prtcorrect": "<p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\">תשובה נכונה חלקית</p>", "prtincorrect": "<p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": false, "forbidwords": "[[BASIC-CALCULUS]]", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": false, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;<span style=\"font-size: medium;\">החישוב שלכם לערך הפונקציה \\(F(p_0)\\) בנקודת הבסיס הוא נכון.&nbsp;&nbsp;</span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">&nbsp;<span>החישוב שלכם לערך הפונקציה \\(F(p_0)\\) בנקודת הבסיס אינו נכון.&nbsp;&nbsp;</span><br></p>"}}]}, {"name": "prt2", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "tans2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;<span style=\"font-size: medium;\">החישוב שלכם לקירוב הלינארי הפונקציה \\(L(p)\\) הוא נכון. לפניכם הערך של הפוקנציה ושל הקירוב הלינארי בנקודה הזו, נתונים בצורה עשרונית. מעניין להשוות אותם.&nbsp;</span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[L(p)={{CT:3}}={{CT:4}}, \\qquad F(p)={{CT:5}} \\]</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt2-1-F", "feedback": "<p>&nbsp;<span style=\"font-size: medium;\">החישוב שלכם לקירוב הלינארי הפונקציה \\(\\ell(p)\\) הוא שגוי, נסו שוב.</span></p>"}}]}], "qvnames": ["a", "b", "c", "dis", "ds", "dt", "du", "dval", "exact", "func1", "func2", "la", "nans2", "p", "p0", "s", "t", "tans1", "tans2", "u", "val"], "nvariants": 50}