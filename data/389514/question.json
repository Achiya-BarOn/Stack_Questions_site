{"id": "389514", "name": "מציאת כל הבסיסים מתוך קבוצה ב-R^3", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randvervect", "params": ["n", "k"], "body": "transpose(makelist(rand_with_step(-k,k,1),n))"}, {"name": "randvervectnonzero", "params": ["n", "k"], "body": "transpose(makelist(rand_with_prohib(-k,k,[0]),n))"}, {"name": "randhorvect", "params": ["n", "k"], "body": "matrix(makelist(rand_with_step(-k,k,1),n))"}, {"name": "dezero", "params": ["vec", "n", "k"], "body": "if (zeromatrixp(vec)) then randvervectnonzero(n,k) else vec"}, {"name": "dezerolst", "params": ["veclst", "k"], "body": "map(lambda([vec], dezero(vec, length(vec),k)), veclst)"}, {"name": "matrify", "params": ["veclst"], "body": "block([mat:matrix([])], for i:1 thru length(veclst) do(mat:addcol(mat,veclst[i])),mat)"}, {"name": "dependentvects", "params": ["veclst"], "body": "is(rank(matrify(veclst))<length(veclst))"}, {"name": "coin", "params": ["i"], "body": "is(rand(4)>0)", "array": true}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונים הוקטורים ב-<span dir=\"ltr\">\\(\\mathbb{R}^3\\)</span>:</p><p dir=\"ltr\" style=\"text-align:center\">\\[v_1={{CT:0}}, v_2={{CT:1}}, v_3={{CT:2}}, v_4={{CT:3}} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>סמנו את כל תתי-הקבוצות שמהווות בסיס למרחב:</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "checkbox", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "mcq_correct(ta_ans)", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<div dir=\"rtl\">תשובה נכונה, יפה מאוד.</div>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<div dir=\"rtl\">תשובה לא נכונה.</div>"}}]}], "qvnames": ["k", "n", "spandim", "ta_ans", "vecmat", "vecs"], "nvariants": 50}