{"id": "1671130", "name": "green_area", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "a", "params": ["t"], "body": "simplify([k1*t-k1*t^(k2), k3*t-k3*t^(k4)])"}, {"name": "v", "params": ["t"], "body": "diff(a(t),t)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">המטרה של תרגיל זה היא לראות איך אפשר לנצל את משפט גרין בכדי לחשב שטח. משפט גרין אומר שאם </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y)= \\begin{pmatrix} P(x,y) \\\\ Q(x,y) \\end{pmatrix} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">שדה וקטורי חלק ואם </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[D \\subset R^2, \\partial D = \\alpha\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">תחום חסום בעל שפה חלקה (למקוטעין) \\(\\alpha\\) אז מתקיים</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\int_{D} \\frac{\\partial Q}{\\partial x} - \\frac{\\partial P}{\\partial y} dx dy = \\oint_{\\alpha} \\alpha'(t) \\cdot U(\\alpha(t)) dt \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">כאשר האינטגרל מימין נקבע כך שהמעבר על השפה הוא בכיוון כזה שהתחום D נראה כל הזמן משמאל לכיוון ההתקדמות. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בפרט אם נמצא שדה \\(U\\) שמקיים את המשוואה (*):</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[ \\frac{\\partial Q}{\\partial x} - \\frac{\\partial P}{\\partial y}=1\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>אז האינטגרל מצד ימין מחשב בדיוק את השטח של התחום D. </span></span><span style=\"font-size: medium;\">נסו להישתמש בשיטה הזו בכדי לחשב את השטח החסום על ידי המסילה הסגורה </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[\\alpha(t)={{CT:0}}, \\quad 0 \\le t \\le 1\\]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"><span>{{CT:1}}</span></span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">ראשית מצאו שדה וקטורי מתאים \\(U\\) המקיים את המשוואה (*) למעלה. ואז תחשבו את האינטגרל המסילתי המופיע מצד ימין של משפט גרין בכדי לקבל את השטח: </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">U(x,y) = [[input:ans1]] [[validation:ans1]]</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"><span>Area(D) = [[input:ans2]] [[validation:ans2]]</span></span></p>", "generalfeedback": "", "specificfeedback": "<p><span style=\"font-size: medium;\">[[feedback:prt1]]</span></p>\n<p><span style=\"font-size: medium;\"><span>[[feedback:prt2]]</span></span></p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "feedbackstyle": 1, "feedbackvariables": "good: is(diff(ans1[2][1],x)-diff(ans1[1][1],y)=1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "good", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">השדה הוקטורי שמצאתם באמת מקיים את המשוואה (*). הנה כמה שדות וקטוריים שמקיימים משוואה זו: </span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U_1={{CT:2}},U_2={{CT:3}}, U_3={{CT:4}} \\]</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">השדה הוקטורי שמצאתם איננו מקיים את המשוואה (*). הנה כמה שדות וקטוריים שמקיימים משוואה זו: </span></p>\n<p style=\"text-align: center;\" dir=\"rtl\"><span style=\"font-size: medium;\">\\[U_1={{CT:2}},U_2={{CT:3}}, U_3={{CT:4}} \\]</span></p>"}}]}, {"name": "prt2", "value": 1, "feedbackstyle": 1, "feedbackvariables": "neg:is(aans2<0);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans2", "tans": "tans2", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt2-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חישוב השטח שלכם מדויק. </span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt2-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>חישוב השטח שלכם שגוי. </span></span></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "neg", "tans": "true", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "prt2-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">שימו לב: הזנתם מספר שלילי עבור השטח! שטח הוא תמיד מספר חיובי. עם זאת סביר להניח שביצעתם את האינטגרציה המסילתית בכיוון ההפוך ולכן קיבלתם מספר שלילי. </span></p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt2-2-F", "feedback": ""}}]}], "qvnames": ["U1", "U2", "U3", "k1", "k2", "k3", "k4", "t0", "t1", "tans1", "tans2"], "nvariants": 50}