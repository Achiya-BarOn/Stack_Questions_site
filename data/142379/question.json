{"id": "142379", "name": "חישוב נפח גוף סיבוב ציר איקס 1", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "FF", "params": ["x"], "body": "(x^(1-2*pp) / (1-2*pp) - x^(1-2*qq) / (1-2*qq))"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\">התחום בין שתי הפונקציות</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ y={{CT:0}},\\hspace{0.7cm} y={{CT:1}},\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ומעל הקטע</p>\n<p style=\"text-align: center;\" dir=\"ltr\"> \\[ [{{CT:2}},{{CT:3}}], \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">מסובב סביב ציר x. חשבו את נפח גוף הסיבוב.</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כתבו את תשובתכם כשלם או מנת שלמים כפול פאי (נכתב pi ) ולא פיתוח עשרוני.</p>\n<p style=\"text-align: center;\" dir=\"ltr\">[[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: right;\" dir=\"ltr\"> </p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">הנוסחה לחישוב נפח גוף סיבוב של פונקציה f סביב ציר x היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[V =\\pi \\int_a^b f^2(x) \\,dx\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">כדי לחשב את הנפח הנדרש בשאלה, נחשב את נפח גוף הסיבוב שיוצרת הפונקציה הגבוהה יותר, ונחסר את נפח גוף הסיבוב שיוצרת הפונקציה הנמוכה יותר. נכתוב זאת כאינטגרל אחד:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[V = \\pi \\int_{{CT:2}}^{{CT:3}} \\left({{CT:0}}\\right)^2 - \\left({{CT:1}}\\right)^2  \\,dx\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[= \\pi \\int_{{CT:2}}^{{CT:3}} {{CT:4}} - {{CT:5}}  \\,dx\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ = \\pi( {{CT:6}}) \\Big|_{{CT:2}}^{{CT:3}}= {{CT:7}}.\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "volume", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["aa", "bb", "ff", "ffSq", "gg", "ggSq", "pp", "qq", "volume"], "nvariants": 16}