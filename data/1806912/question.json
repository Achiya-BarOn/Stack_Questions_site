{"id": "1806912", "name": "שימושי האינטגרל – אורך עקום", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "none", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "Flen", "params": ["x"], "body": "u*x^(m+1)/(m+1)+v*x^(1-m)/(1-m)"}], "questiontext": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 18px; font-weight: bold; color: #4b1f6f; margin-bottom: 8px;\">חשבו את אורך העקום</div>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; line-height: 1.9;\">\\(\\displaystyle y={{CT:0}}\\)</div>\n<div style=\"margin-top: 8px;\">מעל הקטע</div>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px; margin-top: 6px;\">\\(\\displaystyle [{{CT:1}},{{CT:2}}]\\)</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-weight: bold; color: #4b1f6f; margin-bottom: 10px;\">התשובה</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-bottom: 8px;\">כתבו תשובה מדויקת, ללא קירוב עשרוני.</div>\n<div dir=\"ltr\" style=\"text-align: center;\">[[input:ans1]]</div>\n<div style=\"text-align: center; color: #665f6b; font-size: 13px; margin-top: 8px;\">[[validation:ans1]]</div>\n</div>\n</div>", "generalfeedback": "<div dir=\"rtl\" style=\"width: 100%; font-family: Arial,Helvetica,sans-serif; color: #1f2937; line-height: 1.65; text-align: right;\" title=\"BGU_STACK_Q9_APPLICATIONS_V1\">\n<div style=\"background: #F4F1F5; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<div style=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #fff; border: 1px solid #D9D1DD; border-radius: 12px; padding: 16px 18px; margin-bottom: 14px;\">\n<p>נשתמש בנוסחה</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle L=\\int_a^b\\sqrt{1+\\left(y'\\right)^2}\\,dx\\)</div>\n<p>במקרה שלנו</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle y'={{CT:3}}\\)</div>\n<p>הפרמטרים נבחרו כך ש־<span dir=\"ltr\">\\(\\displaystyle 4\\cdot{{CT:4}}\\cdot{{CT:5}}=1\\)</span>. לכן מתקבלת הזהות</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle 1+\\left({{CT:3}}\\right)^2=\\left({{CT:6}}\\right)^2\\)</div>\n<p>בקטע הנתון <span dir=\"ltr\">\\(\\displaystyle x&gt;0\\)</span>, ושני האיברים בתוך הסוגריים חיוביים, ולכן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle \\sqrt{1+\\left(y'\\right)^2}={{CT:6}}\\)</div>\n<p>מכאן</p>\n<div dir=\"ltr\" style=\"text-align: center; font-size: 17px;\">\\(\\displaystyle L=\\int_{{{CT:1}}}^{{{CT:2}}}{{CT:6}}\\,dx={{CT:7}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">\n<div>[[feedback:Result]]</div>\n</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 22, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 3, "syntaxhint": "תשובה מדויקת", "syntaxattribute": 1, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "length", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["ff", "ffPrime", "fromWhere", "length", "m", "rootTerm", "toWhere", "u", "v"], "nvariants": 50}