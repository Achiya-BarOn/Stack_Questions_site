eedback": "<div dir=\"rtl\"><b>סעיף ב׳ — נכון.</b> תשובתך נכונה.</div>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt2-6-F", "feedback": "<div dir=\"rtl\"><b>סעיף ב׳ — שגוי.</b> תשובתך לא נכונה.</div>"}}]}], "qvnames": ["Wbase", "baseA", "baseB", "baseC", "base_perm", "coin", "genMat", "intBase", "k", "matA", "matB", "matC", "n", "slD", "slF", "slM", "slS", "slT", "slX", "slu", "sumBase"], "nvariants": 50}