(listify(setdifference(setify(varsl),setify([x,c1,c2]))));\nan1:expand(ans1);\n\nwvars:setify([X,t,T,x1,X1,x2,X2]);\nwcona:setify([C1,k1,K1,A,a]);\nwconb:setify([C2,k2,K2,B,b]);\n\nfor i:1 while i<=length(bvars) do (if elementp(bvars[i],wvars) then  an1:ev(an1,bvars[i]=x) else (if elementp(bvars[i],wcona) then  an1:ev(an1,bvars[i]=c1) else (if elementp(bvars[i],wconb) then  an1:ev(an1,bvars[i]=c2))));\n\nstdivcheck:ev(diff(an1,x,2)+p*diff(an1,x)+p2*an1,simp);\nu1:ev(diff(an1,c1),simp);\nu2:ev(diff(an1,c2),simp);\nindep:ev(u1*diff(u2,x)-diff(u1,x)*u2,simp);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "stdivcheck", "tans": "g1", "testoptions": null, "quiet": false, "ranges": {"x": ["cc+0.1", "cc+5"]}, "on_true": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "Result-0-F ", "feedback": "<p dir=\"ltr\" style=\"text-align: left;\"><br></p><p dir=\"ltr\" style=\"text-align: left;\"><br></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "indep", "tans": "0", "testoptions": null, "quiet": false, "ranges": {"x": ["cc+0.1", "cc+5"]}, "on_true": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;התשובה שנתת אומנם פותרת את המשוואה, אך זה לא הפתרון הכללי.</p>"}, "on_false": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "Result-2-F", "feedback": "<p style=\"direction: rtl;\">תשובה נכונה, כל הכבוד!</p>"}}, {"name": 2, "answertest": "AlgEquiv", "sans": "stdivcheck", "tans": "0", "testoptions": null, "quiet": false, "ranges": {"x": ["cc+0.1", "cc+5"]}, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-3-T", "feedback": "<p style=\"text-align: right;\">התשובה שנתת היא פתרון למשוואה ההומוגנית, אבל לא למשוואה הנתונה</p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-3-F",