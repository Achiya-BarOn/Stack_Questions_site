"<div dir=\"rtl\">וקטור הקואורדינטות של <span dir=\"ltr\">\\(3u_1\\)</span> לא נכון.</div>"}}]}], "qvnames": ["base_mat", "cord_u1", "cord_u2", "cord_v", "cord_vecs_u", "cord_vecs_v", "solAug", "solEc", "solI1", "solI1P", "solIv", "solRr"], "nvariants": 50}