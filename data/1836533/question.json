tions", "g2", "limAtNegInf", "limAtPlusInf", "limAtx1minus", "limAtx1plus", "limAtx2minus", "limAtx2plus", "p1", "p2", "r", "sgn0", "slA1", "slA2", "slK", "tansPointsAndclassification", "whereIsf", "xDomain", "xm", "yDomain"], "nvariants": 50}