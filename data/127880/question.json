{"id": "127880", "name": "חישוב חזקה של מספר מרוכב", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">נתון המספר המרוכב \\(z={{CT:0}}\\). מצאו את \\(z^{{CT:1}}\\).</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(z^{{CT:1}}= \\)[[input:ans1]] [[validation:ans1]]</p><p class=\"input-hint input-hint-complex\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: את היחידה המדומה \\(i\\) מזינים באות <code dir=\"ltr\">i</code> (אפשר גם <code dir=\"ltr\">%i</code>), וכפל מסמנים בכוכבית. למשל <code dir=\"ltr\">3-2*i</code>.</p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">הדרך להזין כפל \\({{CT:2}}\\) היא&nbsp;a*b.&nbsp;</span></p><p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">הדרך להזין שבר \\({{CT:3}}\\) היא&nbsp;a/b.&nbsp;</span></p><p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">הדרך להזין חזקה \\({{CT:4}}\\) היא&nbsp;a^b.&nbsp;</span></p><p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">הדרך להזין את המספר המרוכב \\(r\\cdot e^{i\\cdot a}\\) היא r*e^(i*a).</span></p><p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">הדרך להזין את המספר המרוכב \\({{CT:5}}\\) היא pi.<br></span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 25, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 1, "nodes": [{"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "simplify(cartesian^n)", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">תשובתך נכונה</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">תשובתך אינה נכונה</p>"}}]}], "qvnames": ["cartesian", "n", "rr", "ta", "theta"], "nvariants": 50}