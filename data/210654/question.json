{"id": "210654", "name": "אינטגרל קווי מסוג שני – שדה (az, bx, cy) לאורך מסילה נתונה", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">שדה וקטורי \\(U:\\mathbb{R}^3 \\rightarrow \\mathbb{R}^3 \\) נתון על ידי הנוסחה</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y,z)={{CT:0}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">ומסילה \\(\\alpha :[0,\\pi/2]\\rightarrow \\mathbb{R}^3\\)&nbsp;</span><span style=\"font-size: medium;\">נתונה על ידי הנוסחה:</span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\">\\[\\alpha(t)={{CT:1}}\\]</span></p>\n<p style=\"text-align: center;\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את האינטגרל של השדה הווקטורי לאורך המסילה הזו.&nbsp;&nbsp;</span>&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(\\int_0^{\\pi/2} \\alpha'(t)\\cdot U(\\alpha(t)) dt = \\)&nbsp;[[input:ans1]] [[validation:ans1]]</span></p>", "generalfeedback": "", "specificfeedback": "<p><span style=\"font-size: medium;\">[[feedback:prt1]]</span></p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">יופי תשובתכם נכונה.&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">בכדי לחשב את האינטגרל יש למצוא קודם את כל המרכיבים שלו:</span></p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(\\alpha(t)={{CT:1}}, \\alpha'(t)={{CT:2}}, U(\\alpha(t))={{CT:3}}\\)</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">כעת אפשר לחשב את האינטגרנד</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(\\alpha(t) \\cdot \\alpha'(t) = {{CT:4}}\\]</span></p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">וכל שנותר הוא לחשב את האינטגרל עצמו.&nbsp;</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">תשובתכם שגויה.&nbsp;</span></p><p dir=\"rtl\"><span style=\"font-size: medium;\"></span></p><p dir=\"rtl\"><span>בכדי לחשב את האינטגרל יש למצוא קודם את כל המרכיבים שלו:</span></p><p dir=\"ltr\"><span>\\(\\alpha(t)={{CT:1}}, \\alpha'(t)={{CT:2}}, U(\\alpha(t))={{CT:3}}\\)</span></p><p dir=\"rtl\">כעת אפשר לחשב את האינטגרנד</p><p dir=\"ltr\"><span>\\[U(\\alpha(t) \\cdot \\alpha'(t) = {{CT:4}}\\]</span></p><p dir=\"rtl\">וכל שנותר הוא לחשב את האינטגרל עצמו.&nbsp;</p><br><p></p>"}}]}], "qvnames": ["U", "a1", "a2", "b1", "b2", "c1", "c2", "d2", "funcs", "p", "tans1", "upt", "v", "xt", "yt", "zt"], "nvariants": 50}