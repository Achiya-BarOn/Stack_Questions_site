tyle=\"font-size: 20px; font-weight: bold; color: #4b1f6f;\">פתרון מלא</div>\n</div>\n<div style=\"background: #FFFFFF; border: 1px solid #D9D1DD; border-radius: 12px; padding: 18px;\">\n<p>נשתמש בזהות</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; overflow-x: auto;\">\\(\\displaystyle \\sin u-\\sin v=2\\cos\\left(\\frac{u+v}{2}\\right)\\sin\\left(\\frac{u-v}{2}\\right)\\)</div>\n<p>ולכן</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; overflow-x: auto;\">\\(\\displaystyle \\frac{\\sin\\left({{CT:0}}\\right)-\\sin\\left({{CT:1}}\\right)}{\\sin\\left({{CT:2}}\\right)}=2\\cos\\left(\\frac{{{CT:3}}}2x\\right)\\frac{\\sin\\left(\\frac{{{CT:4}}}2x\\right)}{\\frac{{{CT:4}}}2x}\\frac{{{CT:4}}}{2{{CT:5}}}\\frac{{{CT:2}}}{\\sin\\left({{CT:2}}\\right)}\\)</div>\n<p>שלושת הגורמים התלויים ב־\\(\\displaystyle x\\) שואפים ל־\\(\\displaystyle1\\), ולכן</p>\n<div dir=\"ltr\" style=\"direction: ltr; unicode-bidi: isolate; text-align: center; font-size: 18px; overflow-x: auto;\">\\(\\displaystyle \\lim_{x\\to0}\\frac{\\sin\\left({{CT:0}}\\right)-\\sin\\left({{CT:1}}\\right)}{\\sin\\left({{CT:2}}\\right)}=\\frac{{{CT:4}}}{{{CT:5}}}={{CT:6}}\\)</div>\n</div>\n</div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "limit", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "feedbackstyle": 1, "feedbackvariables": "correct: if is(limit=ans1) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "<p style=\"text-align: right;\"></p>\n<p></p>\n<p></p>\n<p></p>\n<p></p>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["a", "b", "c", "limit"], "nvariants": 50}