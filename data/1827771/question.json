{"id": "1827771", "name": "גבול ב-0 של (sin(ax)−sin(bx))/sin(cx)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>חשבו את הגבול:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\lim_{x\\to0}\\frac{\\sin\\left({{CT:0}}\\right)-\\sin\\left({{CT:1}}\\right)}{\\sin\\left({{CT:2}}\\right)} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> הופכים את הפרש הסינוסים למכפלה, ומשתמשים בגבול המופלא <span dir=\"ltr\">\\(\\frac{\\sin t}{t}\\to1\\)</span>.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — זהות הפרש סינוסים</b><br><p>נשתמש בזהות</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\sin u-\\sin v=2\\cos\\left(\\frac{u+v}{2}\\right)\\sin\\left(\\frac{u-v}{2}\\right) \\]</p><p>ולכן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\frac{\\sin\\left({{CT:0}}\\right)-\\sin\\left({{CT:1}}\\right)}{\\sin\\left({{CT:2}}\\right)}=2\\cos\\left(\\frac{{{CT:3}}}2x\\right)\\frac{\\sin\\left(\\frac{{{CT:4}}}2x\\right)}{\\frac{{{CT:4}}}2x}\\frac{{{CT:4}}}{{{CT:5}}}\\frac{{{CT:2}}}{\\sin\\left({{CT:2}}\\right)} \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — מעבר לגבול</b><br><p>שלושת הגורמים התלויים ב־<span dir=\"ltr\">\\(x\\)</span> שואפים ל־<span dir=\"ltr\">\\(1\\)</span>, ולכן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to0}\\frac{\\sin\\left({{CT:0}}\\right)-\\sin\\left({{CT:1}}\\right)}{\\sin\\left({{CT:2}}\\right)}=\\frac{{{CT:4}}}{{{CT:6}}}={{CT:7}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "limit", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: if is(limit=ans1) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["a", "b", "c", "limit"], "nvariants": 50}