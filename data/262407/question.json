true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 2, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "mv : rotation_matrix(theta).coordinate_vector;\ngeneric_rotated_coordinates : first(args(transpose(mv )));", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "rot_angle", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\"><br></p>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\"></p><p dir=\"rtl\" style=\"text-align: right;\">התשובה הנכונה היא:</p><p dir=\"ltr\" style=\"text-align: center;\">\\[{{CT:2}}\\]</p><p dir=\"rtl\" style=\"text-align: right;\">גרף הפונקציה&nbsp;</p><p dir=\"ltr\" style=\"text-align: center;\">\\[ g(x,y) := f({@generic_rotated_coordinates[1]@},{@generic_rotated_coordinates[2]@} )\\]</p><p dir=\"ltr\" style=\"text-align: center;\">/*\\[ g(x,y) := f( x \\cos(\\theta) + y \\sin(\\theta), y \\cos(\\theta) - x \\sin(\\theta))\\]*/<br></p><p dir=\"rtl\" style=\"text-align: right;\">מתקבל מגרף הפונקציה \\(f\\), לאחר סיבובו בזוית \\(\\theta\\)&nbsp; <b>נגד כיוון השעון</b>,</p><p dir=\"rtl\" style=\"text-align: right;\">(ביחס למי שמסתכל מכיוון ציר ה- z החיובי, אל ראשית הצירים.)</p><p dir=\"rtl\" style=\"text-align: right;\">שימו לב שאנו מפעילים על וקטור הקואורדינטות סיבוב בזוית \\(\\theta\\) <b>עם כיוון השעון</b>:</p><p dir=\"ltr\" style=\"text-align: center;\">\\[ {{CT:3}} \\mapsto&nbsp; {{CT:4}} {{CT:3}} = {@mv@}\\]</p><p dir=\"ltr\"><br></p><br><br><p></p>"}}]}], "qvnames": ["aa", "coordinate_vector", "gg", "mm", "rot_angle", "rotated_coordinate_vector", "rotated_coordinates"], "nvariants": 11}