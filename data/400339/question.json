{"id": "400339", "name": "בעיית קיצון – גדר מינימלית למגרש המחולק ל-n חלקות (בחירה מרשימה)", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: center;\" dir=\"rtl\"><span style=\"font-size: medium;\"><img src=\"data/400339/files/1.png\" alt=\"\" width=\"457\" height=\"259\" /><br /></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">יש לגדר מגרש מלבני בעל שטח של </span><span style=\"font-size: medium;\">\\({{CT:0}}\\) </span><span style=\"font-size: medium;\">מטר רבוע, באופן שהגדר <strong>גם </strong>מקיפה את המגרש סביב סביב <strong>וגם</strong> מחלקת אותו ל-</span><span style=\"font-size: medium;\">\\({{CT:1}}\\) תת-</span><span style=\"font-size: medium;\">חלקות. החלוקה לתת-חלקות מתבצעת על ידי </span><span style=\"font-size: medium;\">\\({{CT:2}}\\) </span><span style=\"font-size: medium;\">גדרות מקבילות</span><span style=\"font-size: medium;\">.</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">מצאו את היחס בין הצלע הארוכה והקצרה של המלבן שיבטיח אורך גדר מינימלי.</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">  </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>שימו לב: </strong>השרטוט למעלה ממחיש את מקרה אחד ספיציפי שלא בהכרח תואם את תנאי השאלה, המקרה של חמש תת-חלקות הנוצרות על ידי ארבע גדרות. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אם אתם לא יודעים את התשובה לא לנחש! </strong>סמנו את האפשרות \"I don't know\" שתקנה לכם 15% מהניקוד.  </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>אין לבחור </strong>את האפשרות \"(No answer given)\". אפשרות זו לא מקנה נקודות. </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\(\\frac{x}{y} = \\)</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]]</span></p>\n<p> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> </span></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "radio", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 2, "answernote": "prt1-1-F", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans1", "tans": "8", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.15, "nextnode": -1, "answernote": "prt1-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-3-F", "feedback": ""}}]}], "qvnames": ["A", "Max", "min", "n", "ta_multiple1", "tans1", "w2", "w3", "w4", "w5", "w6", "w7"], "nvariants": 50}