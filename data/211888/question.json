{"id": "211888", "name": "אינטגרל משטחי מסוג ראשון על מישור בתוך גליל", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "proj", "params": ["x", "y"], "body": "((x.y)/(y.y))*y"}, {"name": "x", "params": ["u", "v"], "body": "u"}, {"name": "y", "params": ["u", "v"], "body": "v"}, {"name": "z", "params": ["u", "v"], "body": "a*u+b*v+c"}, {"name": "v0", "params": ["u"], "body": "-(R^2-u^2)^(1/2)"}, {"name": "v1", "params": ["u"], "body": "(R^2-u^2)^(1/2)"}, {"name": "f", "params": ["x", "y", "z"], "body": "noise*x+dd*y*z"}, {"name": "Xu", "params": ["u", "v"], "body": "[diff(x(u,v),u), diff(y(u,v),u),diff(z(u,v),u)]"}, {"name": "Xv", "params": ["u", "v"], "body": "[diff(x(u,v),v), diff(y(u,v),v),diff(z(u,v),v)]"}, {"name": "W", "params": ["u", "v"], "body": "factor((crossprod(Xu(u,v),Xv(u,v))))"}, {"name": "J", "params": ["u", "v"], "body": "factor(norm(W(u,v)))"}, {"name": "integ", "params": ["u", "v"], "body": "factor(f(x(u,v),y(u,v),z(u,v))*J(u,v))"}], "questiontext": "<p dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">חשבו את האינטגרל המשטחי (מן הסוג הראשון) של הפונקציה&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[f(x,y,z) = {{CT:0}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">על המשטח \\(S\\) המוגדר להיות החיתוך של המישור:</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[z={{CT:1}}\\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">עם הגליל</span></p>\n<p style=\"text-alig