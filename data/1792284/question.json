{"id": "1792284", "name": "גבול בעזרת רציפות הפונקציה המעריכית – e בחזקת מנה רציונלית", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונה הפונקציה</p><p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle f\\left(x\\right)=\\exp\\left(\\frac{{{CT:0}}}{{{CT:1}}}\\right)\\)</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>חשבו את הגבול</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\(\\displaystyle \\lim_{x\\to{{CT:2}}}f\\left(x\\right)=\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> מחשבים את גבול המעריך, ומכניסים את הגבול לתוך הפונקציה המעריכית בזכות רציפותה.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — הגבול של המעריך</b><br>נחשב תחילה את הגבול של המנה שבמעריך. שני הפולינומים הם מאותה דרגה, ולכן הגבול הוא מנת המקדמים המובילים:<p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle \\lim_{x\\to{{CT:2}}}\\frac{{{CT:0}}}{{{CT:1}}}={{CT:3}}\\)</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — רציפות הפונקציה המעריכית</b><br>הפונקציה המעריכית רציפה בכל הישר, ולכן<p dir=\"ltr\" style=\"text-align:center\">\\(\\displaystyle \\lim_{x\\to{{CT:2}}}f\\left(x\\right)=\\exp\\left({{CT:3}}\\right)={{CT:4}}\\)</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctanswer", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["correctanswer", "degr1", "f", "ind1", "innerLimit", "p1", "p2", "p3", "p4", "q", "q1", "set1", "v"], "nvariants": 50}