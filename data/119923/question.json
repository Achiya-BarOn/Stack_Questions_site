{"id": "119923", "name": "אינטגרל7", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "arccos", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p>&nbsp;</p>\n<p style=\"text-align: right;\">חשבו, ואל תשכחו את הקבוע</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ \\displaystyle{\\int {{CT:0}} d{{CT:1}} \\,=\\, }\\] [[input:ans1]] [[validation:ans1]]</p>", "generalfeedback": "<p> </p>\n<p style=\"text-align: right;\">השתמשו באינטגרציה בחלקים</p>\n<p style=\"text-align: center;\" dir=\"ltr\"> [[hint:calc_int_methods_parts]]. </p>\n<p style=\"text-align: right;\">הגדירו</p>\n<p style=\"text-align: center;\">\\(u = {{CT:2}}\\) and \\(dv = {{CT:3}}d{{CT:1}}\\).</p>\n<p style=\"text-align: right;\">אז</p>\n<p style=\"text-align: center;\">\\(du = {{CT:4}}d{{CT:1}}\\) and \\(v = {{CT:5}}\\). </p>\n<p style=\"text-align: right;\">ונקבל</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\begin{array}{rcl}\\displaystyle \\int {{CT:0}}d{{CT:1}} &amp;\\displaystyle =&amp;\\displaystyle \\int udv \\\\ &amp;\\displaystyle =&amp;\\displaystyle uv - \\int vdu \\\\ &amp;\\displaystyle =&amp;\\displaystyle {{CT:2}}{{CT:5}} - \\int {{CT:5}}{{CT:4}}d{{CT:1}} \\\\ &amp;\\displaystyle =&amp;\\displaystyle {{CT:6}} - {{CT:7}} \\\\ &amp;\\displaystyle =&amp;\\displaystyle {{CT:8}} \\end{array}\\]</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה נכונה</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה נכונה חלקית </p>", "prtincorrect": "<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\">תשובה שגויה</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "varss:listofvars(ans1);\nvarss:delete(C,delete(c,varss));\nan1:ans1;\nfor i:1 while i<=length(varss) do an1:ev(an1,varss[i]=v);\n\nstu:ev(diff(an1,v));\nc1:ev(diff(an1,c));\nc2:ev(diff(an1,C));\nd:c1^2+c2^2;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "stu", "tans": "p", "testoptions": "v", "quiet": false, "on_true": {"scoremode": "=", "score": 0.5, "nextnode": 1, "answernote": "Result-1-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "Result-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "d", "tans": "0", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}, "on_false": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "Result-2-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"></p>"}}]}], "qvnames": ["p", "pp1", "pp2", "ppp", "rdm1", "rdm2", "ta", "v"], "nvariants": 28}