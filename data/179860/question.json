{"id": "179860", "name": "GE34 - 07 - אחוד", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "randToHead", "params": ["list"], "body": "block([x],x: rand(list),list: delete(x,list),cons(x,list))"}, {"name": "permuteList", "params": ["list"], "body": "block([newlist],newlist: [],for i:1 unless (list = []) do(list: randToHead(list),push(pop(list),newlist)),newlist)"}, {"name": "nChooseK", "params": ["dm", "rank"], "body": "block([cols],cols: makelist(i,i,dm),rest(permuteList(cols),-(dm-rank)))"}, {"name": "generateEchelon", "params": ["r", "c", "rnk", "n"], "body": "block([determinedCols,matrix,curCol,depColIndex],matrix: matrix([]),depColIndex: 0,determinedCols: nChooseK(c,rnk),for j:1 thru c do(curCol: [],if member(j,determinedCols) then block(depColIndex: depColIndex+1,curCol: col(ident(r),depColIndex)) else block(curCol: makelist(0,r),for i:1 thru depColIndex do(curCol[i]: rand(makelist(s,s,-n,n))),curCol: transpose(curCol)),matrix: addcol(matrix, curCol)),matrix)"}, {"name": "switchRowsMatrix", "params": ["height", "r1", "r2"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1]: ident(height)[r2],tempMat[r2]: ident(height)[r1],tempMat)"}, {"name": "rowMultMatrix", "params": ["height", "r", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r]: alpha*tempMat[r],tempMat)"}, {"name": "rowAddMatrix", "params": ["height", "r1", "r2", "alpha"], "body": "block([tempMat],tempMat:ident(height),tempMat[r1][r2]: alpha,tempMat)"}, {"name": "scrambleMatrix", "params": ["height", "numOfActions", "rowMultScalars", "rowAddScalars"], "body": "block([mat, actions],mat:ident(height),actions:[switchRowsMatrix, rowMultMatrix, rowAddMatrix],for i:1 thru numOfActions do(mat:mat.block([choice, rows], choice: rand[1,2,3],rows: nChooseK(height, 2),if (choice = 1) then switchRowsMatrix(height,rows[1],rows[2]) elseif (choice = 2) then rowMultMatrix(height,rows[1],rand(rowMultScalars)) else rowAddMatrix(height,rows[1],rows[2],rand(rowAddScalars)))),mat)"}, {"name": "hideZeroes", "params": ["mat", "withSolCol"], "body": "block([height,width,zeros,zeroRows,nonzeroRows,tempMat],height: length(mat),tempMat: if (withSolCol) then submatrix(mat,length(mat[1])) else mat,width: length(tempMat[1]),zeroRows: [],nonzeroRows: [],for i:1 thru height do( if (row(tempMat,i) = zeromatrix(1,width)) then zeroRows:cons(i,zeroRows) else nonzeroRows:cons(i,nonzeroRows)),for rowIndex in zeroRows do(mat:rowAddMatrix(height,rowIndex,rand(nonzeroRows),rand_with_prohib(-3,3,[0])).mat),mat)"}, {"name": "makeSolCol", "params": ["h", "r", "isSolvable"], "body": "block([solCol,zFrom],solCol: zeromatrix(h,1),zFrom: if isSolvable then r else h,for i:1 thru zFrom do(solCol[i,1]:rand_with_step(-2,4,1)),if (r<h and not(isSolvable) and (solCol[r+1,1]=0)) then solCol[r+1,1]: 1,solCol)"}, {"name": "rowToEq", "params": ["r", "vars"], "body": "block([rightSide,n],n: length(r),rightSide: 0,for i:1 thru (n-1) do(rightSide: rightSide + r[i]*vars[i]),rightSide = r[n])"}, {"name": "eqs", "params": ["i"], "body": "rowToEq(exMat[i],variables)", "array": true}, {"name": "findInd", "params": ["M"], "body": "block([cols,curRow],cols: makelist(i,i,length(M[1])),curRow: 1,curCol: 1,while (curCol <= length(M[1]) and curRow <= length(M)) do(if not(M[curRow, curCol]=0) then block(cols: delete(curCol, cols),curRow: curRow + 1,curCol: curCol +1) else curCol: curCol +1),cols)"}], "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>נתונה מערכת המשוואות הבאה במשתנים <span dir=\"ltr\">\\( x_1,x_2,x_3,x_4 \\)</span>:</p><p dir=\"ltr\" style=\"text-align:center\">{{CT:0}}</p><p dir=\"ltr\" style=\"text-align:center\">{{CT:1}}</p><p dir=\"ltr\" style=\"text-align:center\">{{CT:2}}</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">א׳</span></div><p>מצאו את הצורה המדורגת קנונית של מטריצת המקדמים המורחבת המייצגת מערכת זו.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p class=\"input-hint input-hint-grid\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: כל איבר בתיבה משלו: מספר, שבר (למשל <code dir=\"ltr\">1/2</code>) או ביטוי (למשל <code dir=\"ltr\">sqrt(2)</code>).</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ב׳</span></div><p>האם למערכת המשוואות יש פתרון?</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans2]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans2]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ג׳</span></div><p>אם יש למערכת פתרון, הזינו את דרגת המטריצה המייצגת את מערכת המשוואות. אם אין למערכת פתרון, הזינו את הערך <span dir=\"ltr\">\\(-1\\)</span>.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans3]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans3]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ד׳</span></div><p>הזינו את מספרי המשתנים החופשיים כרשימה המסודרת בסדר עולה (לדוגמה, אם אתם חושבים שהמשתנים החופשיים הם <span dir=\"ltr\">\\(x_1,x_3\\)</span> עליכם להזין את המחרוזת <span dir=\"ltr\">\\([1,3]\\)</span>).</p><p>אם לדעתכם אין משתנים חופשיים, הזינו את המחרוזת הריקה <span dir=\"ltr\">\\([]\\)</span>.<br>אם לדעתכם למערכת אין פתרון, הזינו את המחרוזת <span dir=\"ltr\">\\([-1]\\)</span>.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans4]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans4]]</div></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ה׳</span></div><p>במידה וקיים, מצאו פתרון למערכת והזינו אותו כוקטור עמודה (מטריצה 4x1).</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans5]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans5]]</div><p class=\"input-hint input-hint-column\" dir=\"rtl\" style=\"font-size:0.88em;color:#555;margin:6px 0 0;text-align:right\">איך מזינים: למשל, את וקטור העמודה \\((1,2,3)^t\\) מזינים <code dir=\"ltr\">matrix([1],[2],[3])</code>.</p><p style=\"font-size:0.92em;margin:8px 0 0\">במידה ולא קיים פתרון, הזינו את הערך <span dir=\"ltr\">\\(false\\)</span>.</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:8px\"><span style=\"display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;border-radius:50%;background:#4b1f6f;color:#fff;margin-left:8px\">ו׳</span></div><p>במידה וקיים, מצאו את הפתרון הכללי למערכת והזינו אותו מטה באמצעות וקטורי עמודה כבסעיף הקודם.</p><p>במידה ובשדה מסוים אין צורך הזינו בו את הערך <span dir=\"ltr\">\\(false\\)</span>. הפתרון שלכם צריך ליצור את כל הפתרונות, רק פתרונות, וכל פתרון באופן יחיד (כלומר, לא יכולות להיות בחירות שונות ל-<span dir=\"ltr\">\\(t_1,t_2,t_3,t_4\\)</span> שיניבו את אותו הפתרון).<br>אם למערכת אין פתרון כלל, הזינו בכל השדות את הערך <span dir=\"ltr\">\\(false\\)</span>.</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">[[input:ans6]] + \\(t_1\\cdot\\) [[input:ans7]] + \\(t_2\\cdot\\) [[input:ans8]] + \\(t_3\\cdot\\) [[input:ans9]] + \\(t_4\\cdot\\) [[input:ans10]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans6]] [[validation:ans7]] [[validation:ans8]] [[validation:ans9]] [[validation:ans10]]</div><p style=\"font-size:0.92em;margin:8px 0 0\">הערה: אם יש פתרון למערכת, אין למלא בשדה הראשון <span dir=\"ltr\">\\(false\\)</span>.</p></div></div>", "generalfeedback": "", "specificfeedback": "[[feedback:prt1]]<br>[[feedback:prt2]]<br>[[feedback:prt3]]<br>[[feedback:prt4]]<br>[[feedback:prt5]]<br>[[feedback:prt6]]<br>", "prtcorrect": "", "prtpartiallycorrect": "", "prtincorrect": "", "inputs": [{"name": "ans1", "type": "matrix", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans10", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "boolean", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "/,[,]", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans4", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans5", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans6", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans7", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans8", "type": "algebraic", "boxsize": 15, "insertstars": 0