{"id": "261889", "name": "מתיחה כיווץ ושיקוף של גרף פונקציה בשני משתנים", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["x", "y"], "body": "exp(x+y)*cos(x-y)"}], "questiontext": "<p style=\"text-align: right;\"></p><p style=\"text-align: right;\" dir=\"rtl\"><br></p><p style=\"text-align: right;\" dir=\"rtl\">נתונה הפונקציה:</p><p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: 0.9375rem;\">\\[ f(x,y) = {{CT:0}}\\]</span><br></p><p></p><p style=\"text-align: right;\"></p><p style=\"text-align: right;\" dir=\"rtl\">בכדי לקבל את הגרף של הפונקציה&nbsp;</p><p style=\"text-align: center;\" dir=\"ltr\">\\[ g(x,y) = {{CT:1}},\\]</p><p style=\"text-align: right;\" dir=\"rtl\">עלינו לעשות את הפעולות הבאות על גרף הפונקציה&nbsp;<span style=\"font-size: 0.9375rem;\">\\(f\\):</span></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">בכיוון ציר x:</span><br></p><p style=\"text-align: right;\" dir=\"ltr\"><span style=\"font-size: 0.9375rem; text-align: center;\">[[input:ans1]] [[validation:ans1]]</span><br></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem; text-align: center;\">בכיוון ציר y:</span></p><p style=\"text-align: right;\" dir=\"ltr\"><span style=\"font-size: 0.9375rem; text-align: center;\">[[input:ans2]] [[validation:ans2]]<br></span></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem; text-align: center;\">בכיוון ציר z:</span></p><p style=\"text-align: right;\" dir=\"ltr\"><span style=\"font-size: 0.9375rem; text-align: center;\">[[input:ans3]] [[validation:ans3]]<br></span></p><p style=\"text-align: right;\" dir=\"rtl\"><br></p><p></p>", "generalfeedback": "<p></p><p style=\"text-align: right;\"><br></p><p></p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\">תשובה נכונה, יפה מאוד</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\">תשובה נכונה חלקית.</span><br></p><p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: 0.9375rem;\"></span></p><p dir=\"rtl\" style=\"text-align: right;\"></p><p dir=\"rtl\" style=\"text-align: right;\">גרף הפונקציה&nbsp;</p><p dir=\"ltr\" style=\"text-align: right;\">\\[ g(x,y) := c\\cdot f(a\\cdot x,b\\cdot y)\\]</p><p dir=\"rtl\" style=\"text-align: right;\">(נניח \\(a,b,c \\neq 0\\))</p><p dir=\"rtl\" style=\"text-align: right;\">מתקבל מגרף הפונקציה \\(f\\), לאחר</p><p dir=\"rtl\"></p><ul dir=\"rtl\"><li style=\"text-align: right;\">כיווץ בכיוון ציר x, אם \\(|a|&gt;1\\),</li><li style=\"text-align: right;\">מתיחה בכיוון ציר x, אם \\(|a|&lt;1\\),</li><li style=\"text-align: right;\">שיקוף ביחס למישור \\(x=0\\) אם \\(a&lt;0\\),</li><li style=\"text-align: right;\">כיווץ בכיוון ציר y, אם \\(|b|&gt;1\\),</li><li style=\"text-align: right;\">מתיחה בכיוון ציר \\(|b|&lt;1\\),</li><li style=\"text-align: right;\">שיקוף ביחס למישור \\(y=0\\) אם \\(b&lt;0\\),</li><li style=\"text-align: right;\">כיווץ בכיוון ציר z, אם \\(|c|&lt;1\\), (שימו לב להבדל!)</li><li style=\"text-align: right;\">מתיחה בכיוון ציר z, אם \\(|c|&gt;1\\),</li><li style=\"text-align: right;\">שיקוף ביחס למישור \\(z=0\\), אם \\(c&lt;0\\).</li></ul><p></p><p style=\"text-align: right;\"><br></p><p></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\">תשובה שגויה.</p><p style=\"text-align: right;\" dir=\"rtl\"></p><p dir=\"rtl\" style=\"text-align: right;\">גרף הפונקציה&nbsp;</p><p dir=\"ltr\" style=\"text-align: center;\">\\[ g(x,y) := c\\cdot f(a\\cdot x,b\\cdot y)\\]</p><p dir=\"rtl\" style=\"text-align: right;\">(נניח \\(a,b,c \\neq 0\\))</p><p dir=\"rtl\" style=\"text-align: right;\">מתקבל מגרף הפונקציה \\(f\\), לאחר</p><p dir=\"rtl\" style=\"text-align: right;\"></p><ul dir=\"rtl\"><li style=\"text-align: right;\">כיווץ בכיוון ציר x, אם \\(|a|&gt;1\\),</li><li style=\"text-align: right;\">מתיחה בכיוון ציר x, אם \\(|a|&lt;1\\),</li><li style=\"text-align: right;\">שיקוף ביחס למישור \\(x=0\\) אם \\(a&lt;0\\),</li><li style=\"text-align: right;\">כיווץ בכיוון ציר y, אם \\(|b|&gt;1\\),</li><li style=\"text-align: right;\">מתיחה בכיוון ציר \\(|b|&lt;1\\),</li><li style=\"text-align: right;\">שיקוף ביחס למישור \\(y=0\\) אם \\(b&lt;0\\),</li><li style=\"text-align: right;\">כיווץ בכיוון ציר z, אם \\(|c|&lt;1\\), (שימו לב להבדל!)</li><li style=\"text-align: right;\">מתיחה בכיוון ציר z, אם \\(|c|&gt;1\\),</li><li style=\"text-align: right;\">שיקוף ביחס למישור \\(z=0\\), אם \\(c&lt;0\\).</li></ul><p></p><p dir=\"rtl\" style=\"text-align: right;\"></p><br><p></p>", "inputs": [{"name": "ans1", "type": "checkbox", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans2", "type": "checkbox", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}, {"name": "ans3", "type": "checkbox", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": false, "showvalidation": 0, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "ta_x_correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0.3, "penalty": 0, "nextnode": 1, "answernote": "Result-0-T ", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\"><br></p>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\"><br></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans2", "tans": "ta_y_correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.3, "nextnode": 2, "answernote": "Result-2-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": 2, "answernote": "Result-2-F", "feedback": ""}}, {"name": 2, "answertest": "AlgEquiv", "sans": "ans3", "tans": "ta_z_correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "+", "score": 0.4, "nextnode": -1, "answernote": "Result-3-T", "feedback": ""}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "Result-3-F", "feedback": ""}}]}], "qvnames": ["aa", "aa_i", "bb", "bb_i", "cc", "cc_i", "gg", "invert_aa", "invert_bb", "invert_cc", "reflection_x", "reflection_y", "reflection_z", "stretch_x", "stretch_y", "stretch_z", "ta_x", "ta_x_correct", "ta_y", "ta_y_correct", "ta_z", "ta_z_correct"], "nvariants": 50}