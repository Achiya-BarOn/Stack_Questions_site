{"id": "1972140", "name": "סכום הטור Σkn/(n+1)! – בעזרת e", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><p>חשבו את סכום הטור</p><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle{ \\sum_{n=1}^\\infty{\\frac{{{CT:0}}}{(n+1)!}} =}\\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div><p style=\"font-size:0.92em;margin:8px 0 0\">עבור אינסוף יש לרשום <code dir=\"ltr\">inf</code>, עבור מינוס אינסוף יש לרשום <code dir=\"ltr\">minf</code></p></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> מפרקים את האיבר להפרש של שני שברים עם עצרת, ומקבלים טור טלסקופי.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — פירוק האיבר</b><br><p dir=\"ltr\" style=\"text-align:center\">\\[ \\frac{ {{CT:0}} }{(n+1)!}={{CT:1}}\\cdot\\frac{(n+1)-1}{(n+1)!}={{CT:1}}\\left(\\frac{n+1}{(n+1)!}-\\frac{1}{(n+1)!}\\right)={{CT:1}}\\left(\\frac{1}{n!}-\\frac{1}{(n+1)!}\\right) \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — הסכום החלקי וגבולו</b><br>בסכום החלקי כל מחובר שלילי מתבטל עם המחובר החיובי באיבר הבא:<p dir=\"ltr\" style=\"text-align:center\">\\[ S_N={{CT:1}}\\left[\\left(\\frac{1}{1!}-\\frac{1}{2!}\\right)+\\left(\\frac{1}{2!}-\\frac{1}{3!}\\right)+\\dots+\\left(\\frac{1}{N!}-\\frac{1}{(N+1)!}\\right)\\right]={{CT:1}}\\left(1-\\frac{1}{(N+1)!}\\right) \\]</p>כאשר <span dir=\"ltr\">\\(N\\to\\infty\\)</span> מתקיים <span dir=\"ltr\">\\(\\frac{1}{(N+1)!}\\to0\\)</span>, ולכן<p dir=\"ltr\" style=\"text-align:center\">\\[ \\sum_{n=1}^\\infty\\frac{ {{CT:0}} }{(n+1)!}={{CT:2}} \\]</p></div></div>", "specificfeedback": "[[feedback:Result]]", "prtcorrect": "<p><span class=\"correct\">Correct answer, well done.</span></p>", "prtpartiallycorrect": "<p><span class=\"partially\">Your answer is partially correct.</span></p>", "prtincorrect": "<p><span class=\"incorrect\">Incorrect answer.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 8, "insertstars": 0, "forbidfloat": true, "forbidwords": "diff,taylor,sum,solve", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "correctanswer", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": "<div dir=\"rtl\">תשובתכם נכונה, כל הכבוד!</div>"}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": "<div dir=\"rtl\">תשובתכם שגויה.</div>"}}]}], "qvnames": ["correctanswer", "k"], "nvariants": 20}