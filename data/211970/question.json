{"id": "211970", "name": "green_max", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "a", "params": ["t"], "body": "[x0+a*cos(t),y0+b*sin(t)]"}, {"name": "v", "params": ["t"], "body": "diff(a(t),t)"}, {"name": "P", "params": ["x", "y"], "body": "k2*(y-y0)^3+k3*(x-x0)^2*y-(y+x0)"}, {"name": "Q", "params": ["x", "y"], "body": "-k0*(x-x0)^3-k1*(y-y0)^2*x"}, {"name": "U", "params": ["x", "y"], "body": "transpose([P(x,y),Q(x,y)])"}, {"name": "integ", "params": ["x", "y"], "body": "diff(Q(x,y),x)-diff(P(x,y),y)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"direction: rtl; text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium; text-align: center;\">נתבונן בשדה הווקטורי \\(U:\\mathbb{R}^2 \\rightarrow \\mathbb{R}^2\\)</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium; text-align: center;\">\\[U(x,y)= {{CT:0}} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium; text-align: center;\">אנחנו נתעניין באינטגרל מסילתי מן הסוג</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium; text-align: center;\">\\[I_\\alpha=\\int_{\\alpha} \\alpha'(t) \\cdot U(\\alpha(t)) dt \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\">כאשר</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\alpha:[a,b] \\rightarrow R^2\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">מסילה גזירה ברציפות, סגורה ופשוטה. </p>\n<p style=\"text-align: right;\" dir=\"rtl\">במילים פשוטות זה אומר שהמסילה מתארת מסלול מעגלי במישור: היא מתחילה ומסתיימת באותה נקודה \\(\\alpha(a)=\\alpha(b)\\) אבל פרט לכך שנקודת ההתחלה והסיום מזדהות היא לא חוזרת לאף נקודה אחרת פעמיים.</p>\n<p style=\"text-align: right;\" dir=\"rtl\">מבין כל המסילות \\(\\alpha\\) הנ\"ל, נרצה למצוא את הערך הכי גדול עבור \\(I_\\alpha\\) - כלומר למצוא את הערך הגדול ביותר שיכול להתקבל באינטגרל המסילתי שלנו (כתלות במסילה):</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\(\\max_{\\alpha} I_\\alpha=\\) [[input:ans1]] [[validation:ans1]]</p>\n\n\n<p style=\"text-align: right;\" dir=\"rtl\">בכדי להבהיר: מה שמותר לכם לשנות כאן זה את המסילה \\(\\alpha\\). אתם יכולים לבחור כל מסילה גזירה ברציפות, פשוטה וסגורה. והמטרה שלכם למצוא את האינטגרל הגדול ביותר שניתן להגיע אליו כך.</p>", "generalfeedback": "", "specificfeedback": "<p><span style=\"font-size: medium;\">[[feedback:prt1]]</span></p>\n<p><span style=\"font-size: medium;\"><span>&nbsp;</span></span></p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 40, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "tans1", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p dir=\"rtl\">&nbsp;</p>\n<p dir=\"rtl\"><span style=\"font-size: medium;\">יופי מצאתם את הערך הכי גדול שניתן לקבל!</span></p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": -1, "answernote": "prt1-1-F", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">&nbsp;</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><br class=\"Apple-interchange-newline\"><span style=\"font-size: medium;\">לא תשובתכם שגויה.</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><strong>רמז:&nbsp;</strong><span>השתמשו במשפט גרין! במקרה זה למשל&nbsp;</span></span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"><span>\\[\\frac{\\partial Q}{\\partial x}-\\frac{\\partial P}{\\partial y} = {{CT:1}}\\]</span></span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>כאשר מחשבים את הצד של האינטגרל הכפול במשפט גרין: מתי הביטוי הזה תורם לאינטגרל? מתי הוא גורע מן האינטגרל?&nbsp;</span></span></p>"}}]}], "qvnames": ["U1", "U2", "U3", "a", "b", "k0", "k1", "k2", "k3", "n0", "n1", "n2", "n3", "t0", "t1", "tans1", "x0", "y0"], "nvariants": 50}