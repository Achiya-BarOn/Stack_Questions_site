{"id": "1827338", "name": "גבול מהצורה 1^∞ – (ax+e^(bx))^(c/x)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px\"><div style=\"font-weight:bold;color:#4b1f6f;margin-bottom:6px\">הנתונים</div><p>חשבו את הגבול:</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:14px 0;overflow-x:auto\"><div style=\"background:#FAF9FB;border-radius:8px;padding:10px;direction:ltr;text-align:center;unicode-bidi:isolate\">\\( \\displaystyle \\lim_{x\\to0}\\left({{CT:0}}+e^{{{CT:1}}}\\right)^{{{CT:2}}/x} = \\) [[input:ans1]]</div><div dir=\"ltr\" style=\"direction:ltr;text-align:center;unicode-bidi:isolate;margin-top:6px\">[[validation:ans1]]</div></div></div>", "generalfeedback": "<div dir=\"rtl\" style=\"max-width:980px;font-family:Arial;line-height:1.7\"><div style=\"background:#F4F1F5;border:1px solid #D9D1DD;border-radius:12px;padding:12px 16px;margin-bottom:12px\"><b style=\"color:#4b1f6f\">מבנה הפתרון:</b> זה גבול מהצורה <span dir=\"ltr\">\\(1^\\infty\\)</span>: כותבים את הבסיס כ-<span dir=\"ltr\">\\(1+u\\)</span> ומחשבים את גבול המכפלה של המעריך ב-<span dir=\"ltr\">\\(u\\)</span>.</div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 1 — כתיבת הבסיס</b><br><p>נכתוב את הבסיס בצורה</p><p dir=\"ltr\" style=\"text-align:center\">\\[ {{CT:3}}=1+\\left({{CT:3}}-1\\right) \\]</p></div><div style=\"border:1px solid #D9D1DD;border-radius:12px;padding:14px 16px;margin:12px 0;overflow-x:auto\"><b style=\"color:#4b1f6f\">שלב 2 — גבול המעריך</b><br><p>נסמן <span dir=\"ltr\">\\(u\\left(x\\right)={{CT:3}}-1\\)</span>. אז <span dir=\"ltr\">\\(u\\left(x\\right)\\to0\\)</span>, ובגבול מהצורה <span dir=\"ltr\">\\(1^\\infty\\)</span> בודקים את מכפלת המעריך בתוספת לבסיס:</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to0}\\frac{{{CT:2}}}{x}u\\left(x\\right)={{CT:2}}\\left({{CT:4}}+\\lim_{x\\to0}\\frac{e^{{{CT:1}}}-1}{x}\\right)={{CT:2}}\\cdot{{CT:5}} \\]</p><p>לכן</p><p dir=\"ltr\" style=\"text-align:center\">\\[ \\lim_{x\\to0}\\left({{CT:3}}\\right)^{{{CT:2}}/x}=e^{{{CT:2}}\\cdot{{CT:5}}}={{CT:6}} \\]</p></div></div>", "specificfeedback": "<div dir=\"rtl\">[[feedback:Result]]</div>", "prtcorrect": "<p dir=\"rtl\"><span class=\"correct\">תשובה נכונה.</span></p>", "prtpartiallycorrect": "<p dir=\"rtl\"><span class=\"partially\">התשובה נכונה חלקית.</span></p>", "prtincorrect": "<p dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "limit", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "correct: if is(equal(radcan(limit),radcan(ans1))) then true else false;", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "true", "tans": "correct", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["a", "b", "c", "limit"], "nvariants": 50}