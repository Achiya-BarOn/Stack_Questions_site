{"id": "119892", "name": "תחום הגדרה של √(x² − a²) (א)", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "(", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "questiontext": "<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">מצאו את תחום ההגדרה של הפונקציה הבאה</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"> </p>\n<p style=\"text-align: left;\" dir=\"ltr\"><span style=\"font-size: medium;\"> \\[ f({{CT:0}}) = \\sqrt{{{CT:0}}^2-{{CT:1}}} .\\] </span></p>\n<p dir=\"rtl\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> את התשובה יש להזין כביטוי לוגי כדוגמת הביטוי</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"> </span><span style=\"font-size: medium;\">\\( x&gt;= -7 {\\text{ and }} x&lt;5\\) </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">תוך שימוש בסימנים</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\"> </span><span style=\"font-size: medium;\">\\( &lt;, &lt;=, &gt;, &gt;=, =, and, or \\).</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"> כך </span><span style=\"font-size: medium;\">לדוגמא הביטוי למעלה מתאר את התחום </span><span style=\"font-size: medium;\">\\( [-7,5) \\).</span></p>\n<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\">תשובתכם: </span></p>\n<p style=\"text-align: center;\"><span style=\"font-size: medium;\">[[input:ans1]] [[validation:ans1]] </span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><b>שימו לב:</b> המערכת כותבת לכם כיצד היא מפרשת את הביטוי שכתבתם. ודאו שהביטוי שהמערכת מבינה אכן משקף את הכוונה שלכם.</p>\n<p style=\"text-align: center;\"> </p>\n<p style=\"text-align: right;\"> </p>\n<p style=\"text-align: left;\"><strong><strong><span> </span></strong></strong></p>\n<p> </p>", "generalfeedback": "<p style=\"text-align: right;\">הפונקציה מוגדרת רק כאשר השורש מוגדר היטב כלומר כאשר</p>\n<p style=\"text-align: center;\"> \\[ {{CT:0}}^2-{{CT:2}}^2 &gt;= 0.\\] </p>\n<p style=\"text-align: right;\">וזה נכון כאשר</p>\n<p style=\"text-align: center;\"><span style=\"text-align: left;\">\\((-\\infty, -{{CT:2}}] \\cup [{{CT:2}}, \\infty).\\)</span></p>\n<p style=\"text-align: right;\"><span style=\"text-align: left;\">תחום זה ניתן להזין כך</span></p>\n<p style=\"text-align: center;\"> \\({{CT:0}} \\le -{{CT:2}}\\) OR \\({{CT:0}}\\ge {{CT:2}}\\).</p>", "specificfeedback": "<p>[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\">תשובה נכונה, יפה מאוד</p>", "prtpartiallycorrect": "<p style=\"text-align: right;\"><span class=\"partially\">תשובה נכונה חלקית</span></p>", "prtincorrect": "<p style=\"text-align: right;\"><span class=\"incorrect\">תשובה שגויה</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 20, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "answerset:{ans1,ans2,ans3};", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "ta1", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": 1, "answernote": "Result-0-F ", "feedback": ""}}, {"name": 1, "answertest": "AlgEquiv", "sans": "ans1", "tans": "ta2", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-2-T", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-2-F", "feedback": ""}}]}], "qvnames": ["a", "ta1", "ta2", "v"], "nvariants": 6}