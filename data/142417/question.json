{"id": "142417", "name": "נגזרת של אינטגרל עם גבול עליון g(x) – פונקציות מרשימה", "defaultgrade": 1, "penalty": 0, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "ff", "params": ["t"], "body": "funcs[ii]"}, {"name": "ffx", "params": ["x"], "body": "at(ff(t),t=x)"}, {"name": "gg", "params": ["x"], "body": "at(funcs[jj],t=x)"}, {"name": "gDeriv", "params": ["x"], "body": "diff(gg(x),x)"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;</p>\n<p style=\"text-align: right;\" dir=\"rtl\">חשבו את הנגזרת הבאה:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\displaystyle{\\frac{d}{dx} \\int_a^{{CT:0}} {{CT:1}} \\, dt} = \\] [[input:ans1]] [[validation:ans1]]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>\n<p style=\"text-align: center;\" dir=\"ltr\">&nbsp;</p>", "generalfeedback": "<p style=\"text-align: right;\" dir=\"rtl\">המשפט היסודי של החדו\"א אומר שאם </p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[f(x)\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">רציפה בקטע </p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ [a,b]\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">אז הפונקציה</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F(x) := \\int_a^x f(t)\\,dt \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">היא גזירה בקטע </p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ (a,b), \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">ונגזרתה היא:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F'(x) = f(x). \\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נסמן</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ f(t) = {{CT:1}},\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[g(x) = {{CT:0}},\\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ F(x) := \\int_a^x f(t)\\,dt.\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">הפונקציה שאנו מתבקשים לגזור היא, אם כן:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[F(g(x)).\\]</p>\n<p style=\"text-align: right;\" dir=\"rtl\">נגזור לפי כלל השרשרת, ונקבל:</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[\\frac{d}{dx} F( g(x))  = F'(g(x)) \\cdot g'(x) = f(g(x)) \\cdot g'(x)  \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\">\\[ = f({{CT:0}}) \\cdot {{CT:2}} = {{CT:3}}. \\]</p>\n<p style=\"text-align: center;\" dir=\"ltr\"> </p>", "specificfeedback": "<p style=\"text-align: right;\">[[feedback:Result]]</p>", "prtcorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"correct\">תשובה נכונה. יפה מאוד.</span></p>", "prtpartiallycorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"partially\">תשובתך נכונה חלקית.</span></p>", "prtincorrect": "<p style=\"text-align: right;\" dir=\"rtl\"><span class=\"incorrect\">התשובה אינה נכונה.</span></p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 15, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "Result", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "ans1", "tans": "result", "testoptions": null, "quiet": false, "on_true": {"scoremode": "=", "score": 1, "penalty": 0, "nextnode": -1, "answernote": "Result-0-T ", "feedback": ""}, "on_false": {"scoremode": "=", "score": 0, "penalty": 0, "nextnode": -1, "answernote": "Result-0-F ", "feedback": ""}}]}], "qvnames": ["funcs", "ii", "jj", "result"], "nvariants": 30}