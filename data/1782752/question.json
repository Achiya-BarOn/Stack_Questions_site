{"id": "1782752", "name": "type_two_3", "defaultgrade": 1, "penalty": 0.1, "options": {"multiplicationsign": "dot", "complexno": "i", "matrixparens": "[", "inversetrig": "cos-1", "logicsymbol": "lang", "sqrtsign": true}, "nhints": 0, "functions": [{"name": "crossprod", "params": ["x", "y"], "body": "matrix([x[2]*y[3]-x[3]*y[2]],[x[3]*y[1]-x[1]*y[3]],[x[1]*y[2]-x[2]*y[1]])"}, {"name": "norm", "params": ["x"], "body": "sqrt(x.x)"}, {"name": "grad", "params": ["qq"], "body": "matrix([diff(qq,x),diff(qq,y),diff(qq,z)])"}, {"name": "div", "params": ["UU"], "body": "diff(UU[1],x)+diff(UU[2],y) + diff(UU[3],z)"}, {"name": "curl", "params": ["UU"], "body": "matrix([diff(UU[3],y) - diff(UU[2],z), diff(UU[1],z) - diff(UU[3],x), diff(UU[2],x) - diff(UU[1],y)])"}], "questiontext": "<p style=\"text-align: right;\" dir=\"rtl\">&nbsp;נתון השדה הוקטורי:</p>\n<p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[U(x,y,z)= {{CT:0}} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span>&nbsp;</span></span><span style=\"font-size: medium;\">מצאו את השטף של השדה היוצא החוצה מן הספירה :&nbsp;</span></p>\n<p style=\"text-align: center;\" dir=\"ltr\"><span style=\"font-size: medium;\">\\[S=\\{(x,y,z) \\in R^3 \\ | \\ x^2+z^2+z^2={{CT:1}}^2 \\} \\]</span></p>\n<p style=\"text-align: right;\" dir=\"rtl\"></p>\n<p style=\"text-align: right;\" dir=\"rtl\"><span style=\"font-size: medium;\"><span style=\"font-size: medium;\" class=\"\">&nbsp;כלומר&nbsp;</span></span></p>\n<p dir=\"ltr\" style=\"text-align: center;\">\\(\\iint\\limits_{S} U \\cdot N d\\sigma = \\) [[input:ans1]] [[validation:ans1]]</p>\n<p dir=\"ltr\" style=\"direction: rtl;\">&nbsp;<span style=\"font-size: 0.9375rem;\">כאשר \\(\\sigma\\) אלמנט השטח לאורך המשטח ו \\(N\\) הוא הנורמל שפונה החוצה מהספירה.</span></p><p dir=\"ltr\" style=\"direction: rtl;\"><span style=\"font-size: 0.9375rem;\">הנה תיאור של המשטח עם נורמל (בצבע שחור) בנקודה אחת על המשטח שמסביר את כיוון הנורמל:</span></p><p dir=\"ltr\" style=\"direction: rtl;\"><span style=\"font-size: 0.9375rem;\"><img src=\"data/1782752/files/1.png\" alt=\"\" width=\"1071\" height=\"600\" role=\"presentation\" class=\"img-fluid atto_image_button_text-bottom\"><br></span></p><p style=\"text-align: right;\" dir=\"rtl\"></p>", "generalfeedback": "", "specificfeedback": "<p>[[feedback:prt1]]</p>", "prtcorrect": "<p>Correct answer, well done.</p>", "prtpartiallycorrect": "<p>Your answer is partially correct.</p>", "prtincorrect": "<p>Incorrect answer.</p>", "inputs": [{"name": "ans1", "type": "algebraic", "boxsize": 30, "insertstars": 0, "forbidfloat": true, "forbidwords": "", "allowwords": "", "mustverify": true, "showvalidation": 1, "syntaxhint": "", "syntaxattribute": 0, "options": ""}], "prts": [{"name": "prt1", "value": 1, "autosimplify": true, "feedbackstyle": 1, "feedbackvariables": "good: is(ans1=tans1);\nalmost: is(ans1=-tans1);", "firstnode": 0, "nodes": [{"name": 0, "answertest": "AlgEquiv", "sans": "good", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "=", "score": 1, "nextnode": -1, "answernote": "prt1-1-T", "feedback": "<p style=\"text-align: right;\" dir=\"rtl\">יופי חישבתם את האינטגל נכון.</p>"}, "on_false": {"scoremode": "=", "score": 0, "nextnode": 1, "answernote": "prt1-1-F", "feedback": "<p dir=\"rtl\"></p>"}}, {"name": 1, "answertest": "AlgEquiv", "sans": "almost", "tans": "true", "testoptions": null, "quiet": true, "on_true": {"scoremode": "+", "score": 0.5, "nextnode": -1, "answernote": "prt1-2-T", "feedback": "זה החישוב שמתאים לנורמל בכיוון השני.<p dir=\"rtl\" style=\"text-align: right;\"></p>"}, "on_false": {"scoremode": "-", "score": 0, "nextnode": -1, "answernote": "prt1-2-F", "feedback": "<p dir=\"rtl\" style=\"text-align: right;\">האינטגרל שלכם שגוי.&nbsp;<br></p>"}}]}], "qvnames": ["R", "U", "W", "a", "bestlength", "c", "integ", "n", "parm", "parmdu", "parmdv", "ta